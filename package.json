{
  "name": "customreport",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=26.0.0 <27.0.0"
  },
  "dependencies": {
    "@customreport/report-persistence": "workspace:*",
    "@customreport/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:feedback": "AUTH_DEV_MODE=true NEXT_PUBLIC_DEV_ROLE_SWITCHER=true PRODUCT_FEEDBACK_ENABLED=true NEXT_PUBLIC_PRODUCT_FEEDBACK_ENABLED=true NEXT_PUBLIC_PRODUCT_FEEDBACK_INBOX_ROLES=admin turbo run dev",
    "agentation:mcp": "node --env-file=.env node_modules/agentation-mcp/dist/cli.js server --mcp-only --http-url http://127.0.0.1:3002/api/v1/agentation",
    "dev:watch": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --watch",
    "build": "turbo run build",
    "lint": "pnpm lint:eslint && pnpm lint:stylelint && pnpm lint:runtime-node && pnpm lint:cleanliness && pnpm lint:knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:eslint": "NODE_OPTIONS=--max-old-space-size=6144 eslint . --max-warnings 0",
    "lint:stylelint": "stylelint \"**/*.css\" --allow-empty-input --max-warnings 0",
    "lint:runtime-node": "node scripts/gates/environment/check-runtime-node-sync.ts",
    "lint:knip": "knip --include exports,types,files,dependencies",
    "lint:cleanliness": "tsx scripts/gates/repository-cleanliness.ts",
    "spec:check": "openspec validate --all --strict",
    "test:e2e-setup": "node --import tsx --test e2e/setup/*.test.ts",
    "test:e2e": "node --import tsx --test --test-concurrency=1 e2e/lead-form/*.test.ts",
    "typecheck": "tsc6 --project tsconfig.prisma.json --noEmit && tsc6 --project tsconfig.scripts.json --noEmit && tsc6 --project e2e/tsconfig.json --noEmit && turbo run typecheck",
    "test": "turbo run test && vitest run --config vitest.prisma.config.ts && pnpm test:cleanliness && pnpm test:operations && pnpm test:eslint-suppressions && pnpm test:e2e-setup",
    "test:eslint-suppressions": "vitest run --testTimeout=30000 scripts/gates/eslint-suppressions.test.ts",
    "test:cleanliness": "vitest run scripts/gates/repository-cleanliness.test.ts",
    "test:operations": "vitest run --testTimeout=30000 scripts/gates/production-dist-policy.test.ts scripts/gates/operations && node --import tsx --test scripts/gates/production-deps-prune.fixture.test.ts",
    "test:coverage": "pnpm --filter @customreport/api test:coverage && pnpm --filter @customreport/web test:coverage",
    "db:bootstrap:local": "node --import tsx prisma/operations/bootstrap-local.ts",
    "db:seed:profile": "tsx prisma/seeds/profiles/seed-profile.ts",
    "db:seed:verify": "tsx prisma/seeds/profiles/seed-profile-proof.ts",
    "db:reset:hard": "pnpm --filter @customreport/api exec tsx ../../prisma/operations/reset-hard.ts",
    "db:reset:hard:docker": "docker compose -f docker-compose.yml -f docker-compose.dev.yml exec -T api pnpm --dir /app/apps/api exec tsx ../../prisma/operations/reset-hard.ts",
    "observability:compose": "docker compose -f docker-compose.yml -f docker-compose.observability.yml -f docker-compose.errors.yml -f docker-compose.observability.dev.yml",
    "observability:up": "pnpm observability:compose up -d postgres redis mailpit otel-lgtm bugsink",
    "observability:down": "pnpm observability:compose rm --stop --force otel-lgtm bugsink postgres-exporter redis-exporter",
    "observability:logs": "pnpm observability:compose logs --tail=100 otel-lgtm",
    "logs": "tail -f apps/api/.logs/app.log",
    "logs:errors": "tail -f apps/api/.logs/app.log | grep -E '\"level\":\"(error|warn)\"'"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@fission-ai/openspec": "1.13.0",
    "@next/eslint-plugin-next": "^16.3.7",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "agentation-mcp": "1.2.0",
    "eslint": "^10.9.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-functional": "10.0.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^65.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-check": "4.10.2",
    "knip": "^6.38.0",
    "prettier": "3.9.6",
    "prisma": "^7.10.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "superjson": "catalog:",
    "tsx": "catalog:",
    "turbo": "2.10.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "yaml": "2.9.0"
  }
}
