{
  "name": "customreport",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "luxon": "^3.7.2",
    "pg": "^8.20.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:fresh": "rm -rf apps/web/.next && turbo run dev --parallel",
    "dev:watch": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --watch",
    "build": "turbo run build",
    "lint": "biome check . && eslint . && pnpm lint:prisma:typecheck",
    "format": "biome format --write .",
    "lint:prisma:typecheck": "tsc --project tsconfig.prisma.json --noEmit",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @customreport/web exec playwright test --config ../../e2e/playwright.config.ts",
    "test:e2e:ui": "pnpm --filter @customreport/web exec playwright test --config ../../e2e/playwright.config.ts --ui",
    "test:e2e:integration": "pnpm --filter @customreport/web exec playwright test --config ../../e2e/playwright.integration.config.ts",
    "db:fresh:simple": "pnpm db:reset:hard && tsx prisma/seed-simple.ts",
    "db:fresh:advanced": "pnpm db:reset:hard && tsx prisma/seed.ts",
    "db:fresh:manual-uat": "tsx prisma/wipe-manual-uat.ts",
    "db:reset:hard": "pnpm --filter @customreport/api exec tsx ../../prisma/reset-hard.ts",
    "db:reset:hard:docker": "docker compose -f docker-compose.yml -f docker-compose.dev.yml exec -T api pnpm --dir /app/apps/api exec tsx ../../prisma/reset-hard.ts",
    "db:backfill:reminder-policies": "pnpm --filter @customreport/api exec tsx ../../prisma/backfill-policy-rules.ts",
    "observability:up": "docker compose -f docker-compose.yml -f docker-compose.dev.yml -f docker-compose.observability.yml -f docker-compose.errors.yml up -d",
    "observability:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml -f docker-compose.observability.yml -f docker-compose.errors.yml down",
    "observability:logs": "docker compose -f docker-compose.yml -f docker-compose.dev.yml -f docker-compose.observability.yml logs --tail=100 otel-lgtm",
    "logs": "tail -f apps/api/.logs/app.log",
    "logs:errors": "tail -f apps/api/.logs/app.log | grep -E '\"level\":\"(error|warn)\"'",
    "uat:audit": "node apps/web/uat-suite/mutation-audit.mjs",
    "uat:audit:update": "node apps/web/uat-suite/mutation-audit.mjs --update-allowlist",
    "uat:inventory": "node apps/web/uat-suite/inventory.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.2.0",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "3.4.2",
    "prisma": "^7.8.0",
    "tsx": "^4.22.3",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "@nestjs/core",
      "playwright",
      "esbuild",
      "msgpackr-extract",
      "msw",
      "sharp"
    ],
    "overrides": {
      "@xmldom/xmldom": ">=0.8.13",
      "protobufjs": ">=8.0.2",
      "vite": ">=7.3.2",
      "fast-uri": ">=3.1.2"
    },
    "patchedDependencies": {
      "samlify@2.13.1": "patches/samlify@2.13.1.patch"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "biome check --write --no-errors-on-unmatched",
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.{json,jsonc,css}": "biome check --write --no-errors-on-unmatched",
    "*.{yml,yaml,md}": "prettier --write"
  }
}
