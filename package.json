{
  "name": "customreport",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:fresh": "rm -rf apps/web/.next && turbo run dev --parallel",
    "dev:watch": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --watch",
    "build": "turbo run build",
    "lint": "node scripts/gates/orchestrator/lint-gate.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:eslint": "NODE_OPTIONS=--max-old-space-size=6144 eslint . --max-warnings 0",
    "lint:stylelint": "stylelint \"**/*.css\" --allow-empty-input --max-warnings 0",
    "lint:prettier-scope:test": "node --test scripts/gates/formatting/prettier-scope-gate.test.ts",
    "lint:stylelint-gate:test": "node --test scripts/gates/formatting/stylelint-gate.test.ts",
    "lint:prisma:typecheck": "tsc --project tsconfig.prisma.json --noEmit",
    "lint:scripts:typecheck": "tsc --project tsconfig.scripts.json --noEmit",
    "lint:ssot-gate:test": "node --test scripts/gates/status-ssot/status-ssot-gate.test.ts",
    "lint:ssot-gate": "node scripts/gates/status-ssot/status-ssot-gate.ts --all",
    "lint:runtime-node": "node scripts/gates/environment/check-runtime-node-sync.ts",
    "lint:suppressions:test": "node --test scripts/eslint/suppression/eslint-suppression-inventory.test.ts",
    "lint:suppressions": "tsx scripts/eslint/suppression/eslint-suppression-ledger.ts --check",
    "lint:suppressions:retained": "tsx scripts/eslint/suppression/eslint-retained-suppression-probes.ts",
    "lint:eslint-scopes": "tsx scripts/eslint/policy/eslint-policy-scope-probes.ts && tsx scripts/quality/exemplary/exemplary-structure-probe-cli.ts",
    "lint:typecov:test": "node --test scripts/gates/type-system/type-coverage-gate.test.ts",
    "lint:eslint-config:test": "node --test scripts/eslint/policy/eslint-config-ownership.test.ts scripts/quality/exemplary/exemplary-structure-probe.test.ts",
    "lint:web-coverage-scope:test": "node --test scripts/gates/web-coverage/web-coverage-scope.test.ts",
    "lint:react-doctor:test": "node --test scripts/quality/react-doctor/react-doctor-baseline.test.ts",
    "lint:react-doctor": "tsx scripts/quality/react-doctor/react-doctor-gate.ts",
    "lint:exemplary-floor:test": "node --test scripts/quality/exemplary/exemplary-floor-ratchet.test.ts scripts/quality/exemplary/exemplary-file-kind.test.ts scripts/quality/exemplary/exemplary-catalogue-output.test.ts scripts/quality/exemplary/exemplary-structure.test.ts scripts/eslint/policy/eslint-config-scope-counter.test.ts",
    "lint:exemplary-floor": "tsx scripts/quality/exemplary/exemplary-catalogue.ts --check",
    "lint:type-cycles:test": "node --test scripts/quality/type-cycles/type-cycle-ratchet.test.ts",
    "lint:type-cycles": "tsx scripts/quality/type-cycles/type-cycle-ratchet.ts",
    "lint:provenance:test": "node --test scripts/gates/planning-provenance/openspec-provenance-resolver.test.ts",
    "lint:deferred-references:test": "node --test scripts/gates/planning-provenance/deferred-reference-gate.test.ts",
    "lint:vitest-rules:test": "node --test scripts/gates/vitest-rules/vitest-rule-ledger.node-test.ts",
    "lint:exact-optional:test": "node --test scripts/gates/type-system/exact-optional-property-types.test.ts",
    "lint:directory-architecture": "node --test scripts/gates/directory-architecture/directory-architecture.test.ts",
    "lint:repository-tests": "node scripts/gates/repository-tests/runner.ts",
    "knip": "knip --treat-config-hints-as-errors",
    "typecov": "type-coverage -p packages/shared --at-least 100 && type-coverage -p packages/ui --at-least 100 && type-coverage -p apps/api --at-least 99.98 && type-coverage -p apps/web --at-least 99.8 --ignore-files 'apps/web/.next/**'",
    "depcruise": "depcruise apps/api/src apps/web/src packages/shared/src packages/ui/src --config .dependency-cruiser.cjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && vitest run --config vitest.prisma.config.ts",
    "test:coverage": "pnpm --filter @customreport/api test:coverage && pnpm --filter @customreport/web test:coverage",
    "db:seed:profile": "tsx prisma/seeds/profiles/seed-profile.ts",
    "db:seed:verify": "tsx prisma/seeds/profiles/seed-profile-proof.ts",
    "db:reset:hard": "pnpm --filter @customreport/api exec tsx ../../prisma/operations/reset-hard.ts",
    "db:reset:hard:docker": "docker compose -f docker-compose.yml -f docker-compose.dev.yml exec -T api pnpm --dir /app/apps/api exec tsx ../../prisma/operations/reset-hard.ts",
    "db:backfill:reminder-policies": "pnpm --filter @customreport/api exec tsx ../../prisma/operations/backfill-policy-rules.ts",
    "observability:compose": "docker compose --project-name customreport-observability -f docker-compose.yml -f docker-compose.observability.yml -f docker-compose.errors.yml -f docker-compose.observability.dev.yml",
    "observability:up": "pnpm observability:compose up -d postgres redis mailpit otel-lgtm bugsink",
    "observability:down": "pnpm observability:compose down",
    "observability:logs": "pnpm observability:compose logs --tail=100 otel-lgtm",
    "logs": "tail -f apps/api/.logs/app.log",
    "logs:errors": "tail -f apps/api/.logs/app.log | grep -E '\"level\":\"(error|warn)\"'",
    "prepare": "husky",
    "catalogue": "tsx scripts/quality/exemplary/exemplary-catalogue.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@next/eslint-plugin-next": "^16.2.12",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/react": "catalog:",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.24",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^10.8.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-functional": "10.0.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^63.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^72.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "knip": "^6.29.0",
    "lint-staged": "^17.2.0",
    "prettier": "3.9.6",
    "prisma": "^7.10.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "catalog:",
    "turbo": "^2.10.7",
    "type-coverage": "^2.30.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "typescript-language-service": "npm:typescript@6.0.3",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write",
      "node scripts/gates/status-ssot/status-ssot-gate.ts"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc}": "prettier --write",
    "*.{yml,yaml,md}": "prettier --write"
  }
}
