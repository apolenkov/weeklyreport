{
  "name": "customreport",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "dotenv": "^17.4.2",
    "luxon": "catalog:",
    "pg": "^8.22.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:fresh": "rm -rf apps/web/.next && turbo run dev --parallel",
    "dev:watch": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --watch",
    "build": "turbo run build",
    "lint": "eslint . && stylelint \"**/*.css\" --allow-empty-input && pnpm lint:prisma:typecheck && pnpm lint:status-literal-unions && pnpm lint:runtime-node && pnpm depcruise && pnpm knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:prisma:typecheck": "tsc --project tsconfig.prisma.json --noEmit",
    "lint:status-literal-unions": "node --test scripts/find-status-literal-unions.test.mjs && node scripts/find-status-literal-unions.mjs --all",
    "lint:runtime-node": "node scripts/check-runtime-node-sync.mjs",
    "knip": "knip",
    "typecov": "type-coverage -p packages/shared --at-least 100 && type-coverage -p packages/ui --at-least 99.9 && type-coverage -p apps/api --at-least 99.95 && type-coverage -p apps/web --at-least 99.6",
    "depcruise": "depcruise apps/api/src apps/web/src packages/shared/src packages/ui/src --config .dependency-cruiser.cjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && vitest run --config vitest.prisma.config.ts",
    "test:e2e:integration": "pnpm --filter @customreport/web exec playwright test --config ../../e2e/playwright.integration.config.ts",
    "build:e2e:prodbuild": "API_URL=http://127.0.0.1:3102 NEXT_PUBLIC_API_URL=http://127.0.0.1:3102 NEXT_PUBLIC_AUTH_STUB=false NEXT_PUBLIC_DISABLE_DEVTOOLS=true turbo build && rm -rf apps/web/.next/standalone/apps/web/.next/static && cp -R apps/web/.next/static apps/web/.next/standalone/apps/web/.next/static",
    "test:e2e:prodbuild": "pnpm build:e2e:prodbuild && pnpm --filter @customreport/web exec playwright test --config ../../e2e/playwright.prodbuild.config.ts",
    "test:e2e:csp": "pnpm build:e2e:prodbuild && pnpm --filter @customreport/web exec playwright test --config ../../e2e/playwright.csp.config.ts",
    "test:uat": "pnpm --filter @customreport/web exec playwright test --config ../../e2e/sweep/playwright.config.ts",
    "catalog:check": "node e2e/sweep/catalog-check.mjs",
    "db:fresh:simple": "pnpm db:reset:hard && tsx prisma/seed-simple.ts",
    "db:fresh:advanced": "pnpm db:reset:hard && tsx prisma/seed.ts",
    "db:seed:small": "tsx prisma/seed-demo.ts small",
    "db:seed:middle": "tsx prisma/seed-simple.ts",
    "db:seed:huge": "tsx prisma/seed-demo.ts huge",
    "db:fresh:manual-uat": "tsx prisma/wipe-manual-uat.ts",
    "db:reset:hard": "pnpm --filter @customreport/api exec tsx ../../prisma/reset-hard.ts",
    "db:reset:hard:docker": "docker compose -f docker-compose.yml -f docker-compose.dev.yml exec -T api pnpm --dir /app/apps/api exec tsx ../../prisma/reset-hard.ts",
    "db:backfill:reminder-policies": "pnpm --filter @customreport/api exec tsx ../../prisma/backfill-policy-rules.ts",
    "observability:compose": "docker compose -f docker-compose.yml -f docker-compose.dev.yml -f docker-compose.observability.yml -f docker-compose.errors.yml -f docker-compose.observability.dev.yml",
    "observability:up": "pnpm observability:compose up -d",
    "observability:down": "pnpm observability:compose down",
    "observability:logs": "pnpm observability:compose logs --tail=100 otel-lgtm",
    "logs": "tail -f apps/api/.logs/app.log",
    "logs:errors": "tail -f apps/api/.logs/app.log | grep -E '\"level\":\"(error|warn)\"'",
    "uat:audit": "node apps/web/uat-suite/mutation-audit.mjs",
    "uat:audit:update": "node apps/web/uat-suite/mutation-audit.mjs --update-allowlist",
    "uat:inventory": "node apps/web/uat-suite/inventory.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@next/eslint-plugin-next": "^16.2.11",
    "@types/luxon": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "@types/react": "catalog:",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^10.7.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-functional": "10.0.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^63.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^72.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "knip": "^6.29.0",
    "lint-staged": "^17.2.0",
    "prettier": "3.9.6",
    "prisma": "^7.9.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "catalog:",
    "turbo": "2.10.6",
    "type-coverage": "^2.29.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write",
      "node scripts/find-archaeology.mjs",
      "node scripts/find-status-literal-unions.mjs"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc}": "prettier --write",
    "*.{yml,yaml,md}": "prettier --write"
  }
}
