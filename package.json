{
  "name": "customreport",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.0.0",
    "dotenv": "^17.2.3",
    "pg": "^8.20.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @customreport/web exec playwright test",
    "test:e2e:ui": "pnpm --filter @customreport/web exec playwright test --ui",
    "docker:local:verify": "bash scripts/docker-local-verify.sh",
    "db:seed:simple": "tsx prisma/seed-simple.ts",
    "db:seed:advanced": "tsx prisma/seed.ts",
    "gsd:checklist:sync": "tsx tools/handoff-sync.ts",
    "logs": "tail -f apps/api/.logs/app.log",
    "logs:errors": "tail -f apps/api/.logs/app.log | grep -E '\"level\":\"(error|warn)\"'",
    "uat:audit": "node apps/web/uat-suite/mutation-audit.mjs",
    "uat:audit:update": "node apps/web/uat-suite/mutation-audit.mjs --update-allowlist",
    "uat:inventory": "node apps/web/uat-suite/inventory.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@types/node": "^24.9.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "eslint": "^10.2.0",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prisma": "^7.0.0",
    "turbo": "^2.5.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "@nestjs/core",
      "playwright",
      "esbuild",
      "msgpackr-extract",
      "msw",
      "sharp"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js,jsx}": "eslint --fix --max-warnings=0 --no-warn-ignored",
    "*.{json,md,yml,yaml}": "prettier --write"
  }
}
