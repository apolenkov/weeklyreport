{
  "name": "customreport",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "pg": "^8.20.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:fresh": "rm -rf apps/web/.next && turbo run dev --parallel",
    "dev:watch": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --watch",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @customreport/web exec playwright test",
    "test:e2e:ui": "pnpm --filter @customreport/web exec playwright test --ui",
    "doctor": "GSD_RUNTIME=codex bash scripts/doctor.sh",
    "openspec:doctor": "bash scripts/openspec-doctor.sh",
    "docker:local:verify": "bash scripts/docker-local-verify.sh",
    "db:seed:simple": "tsx prisma/seed-simple.ts",
    "db:seed:advanced": "tsx prisma/seed.ts",
    "db:wipe:manual-uat": "tsx prisma/wipe-manual-uat.ts",
    "db:reset:hard": "pnpm --filter @customreport/api exec tsx ../../prisma/reset-hard.ts",
    "db:reset:hard:docker": "docker compose -f docker-compose.yml -f docker-compose.dev.yml exec -T api pnpm --dir /app/apps/api exec tsx ../../prisma/reset-hard.ts",
    "db:backfill:reminder-policies": "pnpm --filter @customreport/api exec tsx ../../prisma/backfill-policy-rules.ts",
    "observability:up": "docker compose -f docker-compose.yml -f docker-compose.dev.yml -f docker-compose.observability.yml -f docker-compose.errors.yml up -d",
    "observability:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml -f docker-compose.observability.yml -f docker-compose.errors.yml down",
    "observability:logs": "docker compose -f docker-compose.yml -f docker-compose.dev.yml -f docker-compose.observability.yml logs --tail=100 otel-lgtm",
    "gsd:checklist:sync": "tsx tools/handoff-sync.ts",
    "logs": "tail -f apps/api/.logs/app.log",
    "logs:errors": "tail -f apps/api/.logs/app.log | grep -E '\"level\":\"(error|warn)\"'",
    "uat:audit": "node apps/web/uat-suite/mutation-audit.mjs",
    "uat:audit:update": "node apps/web/uat-suite/mutation-audit.mjs --update-allowlist",
    "uat:inventory": "node apps/web/uat-suite/inventory.mjs",
    "uat:parse-dom": "pnpm --filter @customreport/api exec tsx ../../tools/uat-extractor/parse-dom.ts",
    "uat:generate": "pnpm --filter @customreport/api exec tsx ../../tools/uat-extractor/generate-playwright.ts",
    "uat:coverage": "pnpm --filter @customreport/api exec tsx ../../tools/uat-extractor/coverage.ts",
    "lint:md": "markdownlint-cli2 \".planning/**/*.md\" \"!.planning/local-archive/**\" \"README.md\"",
    "lint:md:fix": "markdownlint-cli2 --fix \".planning/**/*.md\" \"!.planning/local-archive/**\" \"README.md\"",
    "prepare": "husky",
    "audit-work": "node --experimental-strip-types .planning/scripts/accumulated-work-audit.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@types/node": "^24.9.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.2.0",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "markdownlint-cli2": "^0.22.1",
    "prisma": "^7.8.0",
    "turbo": "^2.9.14",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "@nestjs/core",
      "playwright",
      "esbuild",
      "msgpackr-extract",
      "msw",
      "sharp"
    ],
    "overrides": {
      "@xmldom/xmldom": ">=0.8.13",
      "protobufjs": ">=8.0.2",
      "vite": ">=7.3.2",
      "fast-uri": ">=3.1.2"
    },
    "patchedDependencies": {
      "samlify@2.13.1": "patches/samlify@2.13.1.patch"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js,jsx}": "eslint --fix --max-warnings=0 --no-warn-ignored",
    "*.{json,yml,yaml}": "prettier --write",
    "*.md": [
      "prettier --write",
      "markdownlint-cli2 --fix"
    ]
  }
}
