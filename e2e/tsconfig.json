{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // The plain-node entrypoints in e2e/sweep are executed by Node's type
    // stripping, so their sibling imports name the `.ts` file Node opens; there
    // is no build step to rewrite a `.js` specifier. Legal under noEmit.
    "allowImportingTsExtensions": true,
    // Playwright and axe are installed only in apps/web (the package that runs
    // the suite); nothing hoists them to a node_modules directory reachable
    // from `e2e/`. Point the typecheck at that install — Playwright's own
    // loader resolves them at runtime. The four workspace mappings restate the
    // base ones, because `paths` replaces rather than merges.
    "paths": {
      "@customreport/shared": ["../packages/shared/src/index.ts"],
      "@customreport/shared/*": ["../packages/shared/src/*"],
      "@customreport/ui": ["../packages/ui/src/index.ts"],
      "@customreport/ui/*": ["../packages/ui/src/*"],
      // Two candidates on purpose: tsc takes the first (the package dir, which
      // has index.d.ts), Playwright's loader reuses this mapping and takes the
      // last — and under the root "type": "module" it must get the ESM entry.
      "@playwright/test": [
        "../apps/web/node_modules/@playwright/test",
        "../apps/web/node_modules/@playwright/test/index.mjs"
      ],
      "@axe-core/playwright": ["../apps/web/node_modules/@axe-core/playwright"]
    }
  },
  "include": ["./**/*.ts"]
}
