{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": false,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@weeklyreport/api/*": ["./apps/api/src/*"],
      "@weeklyreport/report-persistence": [
        "./packages/report-persistence/src/index.ts"
      ],
      "@weeklyreport/report-persistence/*": [
        "./packages/report-persistence/src/*"
      ],
      "@weeklyreport/shared": ["./packages/shared/src/index.ts"],
      "@weeklyreport/shared/*": ["./packages/shared/src/*"],
      "@weeklyreport/ui/*": ["./packages/ui/src/*"]
    }
  }
}
