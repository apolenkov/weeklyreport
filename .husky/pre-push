#!/usr/bin/env sh

# 34-01: pre-push hook — runs the full unit-test suite before letting a
# push leave the machine. Skipped automatically in CI (the workflow
# already runs the same suite without this guard). Skip locally with
# `SKIP_PREPUSH=1 git push` if you have to.

if [ "$CI" = "true" ] || [ "$SKIP_PREPUSH" = "1" ]; then
  echo "[pre-push] skipped (CI=$CI, SKIP_PREPUSH=$SKIP_PREPUSH)"
  exit 0
fi

echo "[pre-push] catalog drift gate…"
pnpm catalog:check

echo "[pre-push] running unit tests…"
pnpm test
