#!/usr/bin/env sh

# pre-push hook — mirrors the cheap, deterministic, no-services CI jobs
# before a push leaves the machine: typecheck + lint (including the bounded
# acceptance source budget and planted probes) + format:check + catalog drift +
# mutation-consumer audit + unit tests. Service-dependent acceptance, E2E,
# migrate-reset, and Docker build stay for the server-side gate. Skip locally
# with `SKIP_PREPUSH=1 git push`.
#
# The skip condition is hook-specific on purpose: this hook only fires on
# `git push`, which ci.yml never performs, so keying off the ambient CI=true
# was redundant — and a silent-bypass footgun: any unrelated tool that sets
# CI=true would disable the only active merge gate.
#
# set -e aborts on the first failing gate: the commands are unchained, so
# without it only the last command's exit status reaches git and a failing
# early gate would be masked by a later passing one.

if [ "$SKIP_PREPUSH" = "1" ]; then
  echo "[pre-push] skipped (SKIP_PREPUSH=$SKIP_PREPUSH)"
  exit 0
fi

set -e

echo "[pre-push] typecheck…"
pnpm turbo typecheck

echo "[pre-push] lint…"
pnpm lint

echo "[pre-push] format:check…"
pnpm format:check

echo "[pre-push] catalog drift gate…"
pnpm catalog:check

echo "[pre-push] mutation-consumer audit…"
pnpm uat:audit --check

echo "[pre-push] running unit tests…"
# CI=true only for this step: vitest downgrades an obsolete snapshot to a
# warning when it thinks a human can rerun with --update, so without it the
# local suite exits 0 on a failure the server-side gate rejects.
CI=true pnpm test
