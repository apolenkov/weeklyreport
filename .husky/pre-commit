#!/usr/bin/env sh

# Runs ESLint (comment archaeology included, via the local plugin) + stylelint
# + Prettier on staged files via lint-staged. Bypass with
# `git commit --no-verify` only in a real emergency — otherwise fix the issue.

# Session artifacts (review dumps, handoffs, pipeline scripts) belong in
# ~/work/customreport-archive/, not docs/ — see docs/README.md.
staged_junk=$(git diff --cached --name-only --diff-filter=A | grep -E '^docs/.*(\.data\.json|\.js\.txt)$|^docs/(.*/)?HANDOFF-' || true)
if [ -n "$staged_junk" ]; then
  echo "pre-commit: session artifacts must go to ~/work/customreport-archive/, not docs/:" >&2
  echo "$staged_junk" >&2
  exit 1
fi

pnpm exec lint-staged
