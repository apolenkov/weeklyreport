      "id": "scripts-shared-implementation",
      "scope": "scripts",
      "pattern": "^scripts/shared/((?!.*\\.test\\.ts$).+\\.ts)$",
      "concern": "shared-tooling",
      "role": "implementation",
      "target": "scripts/shared/$1"
    },
    {
      "id": "scripts-shared-tests",
      "scope": "scripts",
      "pattern": "^scripts/shared/(.+\\.test\\.ts)$",
      "concern": "shared-tooling",
      "role": "test",
      "target": "scripts/shared/$1"
