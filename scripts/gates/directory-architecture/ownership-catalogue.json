      "prefix": "apps/api/src/modules/",
      "allowedTargetPrefixes": [
        "apps/api/src/modules/",
        "apps/api/src/test-seams/"
      ],
      "includePattern": "^(?:apps/api/src/modules/(?:[^/]+/)*[^/]+\\.(?:test|spec)\\.[cm]?[jt]sx?|apps/api/src/modules/(?:[^/]+/)*(?:__(?:tests|fixtures|snapshots)__|test-seams)/.+)$"
