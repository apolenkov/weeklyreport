# Editor defaults matching .prettierrc; Prettier stays the formatter of record.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown uses trailing double spaces as hard line breaks.
[*.md]
trim_trailing_whitespace = false
