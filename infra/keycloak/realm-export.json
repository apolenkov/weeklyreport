{
  "_comment": "Source of truth for SAML attribute mapping. Loaded by docker-compose.test.yml mock IdP in Phase 29-04. Production Keycloak must mirror saml-role-mapper exactly — the SAML attribute name 'role' MUST match the Zod field in packages/shared/src/auth/saml-profile.ts. Test users below are fixtures only; production is provisioned via the corporate Keycloak admin console.",
  "realm": "customreport",
  "enabled": true,
  "displayName": "CustomReport",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 30,
  "roles": {
    "realm": [
      { "name": "lead", "description": "Team lead — fills weekly section" },
      { "name": "head", "description": "Department head — reviews + publishes" },
      { "name": "admin", "description": "Administrator — manages users + reports" },
      { "name": "viewer", "description": "Read-only viewer — directors, peers" }
    ]
  },
  "groups": [
    { "name": "leads", "realmRoles": ["lead"] },
    { "name": "heads", "realmRoles": ["head"] },
    { "name": "admins", "realmRoles": ["admin"] },
    { "name": "viewers", "realmRoles": ["viewer"] }
  ],
  "clients": [
    {
      "clientId": "customreport-saml",
      "name": "CustomReport SAML Client",
      "protocol": "saml",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "redirectUris": [
        "http://localhost:3001/auth/saml/callback",
        "http://api:3001/auth/saml/callback"
      ],
      "webOrigins": ["http://localhost:3000"],
      "frontchannelLogout": true,
      "attributes": {
        "saml.assertion.signature": "true",
        "saml.authnstatement": "true",
        "saml.client.signature": "false",
        "saml.encrypt": "false",
        "saml.force.post.binding": "true",
        "saml.multivalued.roles": "false",
        "saml.server.signature": "true",
        "saml.signature.algorithm": "RSA_SHA256",
        "saml_assertion_consumer_url_post": "http://localhost:3001/auth/saml/callback",
        "saml_force_name_id_format": "true",
        "saml_name_id_format": "email",
        "saml_signature_canonicalization_method": "http://www.w3.org/2001/10/xml-exc-c14n#"
      },
      "protocolMappers": [
        {
          "_comment": "AUTH-02: this mapper emits the SAML attribute literally named 'role' so Zod SamlProfileSchema.parse({role}) finds the value at the expected key. Single-valued; one role per user via realm role inherited through group membership.",
          "name": "saml-role-mapper",
          "protocol": "saml",
          "protocolMapper": "saml-role-list-mapper",
          "consentRequired": false,
          "config": {
            "single": "true",
            "attribute.nameformat": "Basic",
            "attribute.name": "role",
            "friendly.name": "role"
          }
        },
        {
          "name": "saml-email-mapper",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "attribute.nameformat": "Basic",
            "attribute.name": "email",
            "friendly.name": "email"
          }
        },
        {
          "name": "saml-displayname-mapper",
          "protocol": "saml",
          "protocolMapper": "saml-user-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "fullName",
            "attribute.nameformat": "Basic",
            "attribute.name": "displayName",
            "friendly.name": "displayName"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "head@customreport.local",
      "email": "head@customreport.local",
      "firstName": "Department",
      "lastName": "Head",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "TestPassword123!", "temporary": false }],
      "groups": ["heads"],
      "attributes": { "fullName": ["Department Head"] }
    },
    {
      "username": "lead@customreport.local",
      "email": "lead@customreport.local",
      "firstName": "Team",
      "lastName": "Lead",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "TestPassword123!", "temporary": false }],
      "groups": ["leads"],
      "attributes": { "fullName": ["Team Lead"] }
    },
    {
      "username": "admin@customreport.local",
      "email": "admin@customreport.local",
      "firstName": "System",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "TestPassword123!", "temporary": false }],
      "groups": ["admins"],
      "attributes": { "fullName": ["System Admin"] }
    },
    {
      "username": "viewer@customreport.local",
      "email": "viewer@customreport.local",
      "firstName": "Report",
      "lastName": "Viewer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "TestPassword123!", "temporary": false }],
      "groups": ["viewers"],
      "attributes": { "fullName": ["Report Viewer"] }
    }
  ]
}
