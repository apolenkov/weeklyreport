generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String                    @id @default(uuid())
  // Live email identity is case-insensitive: besides this exact-case unique,
  // migrations own UNIQUE INDEX "User_email_lower_key" on lower(email),
  // matching the snapshot comparator. `samlId` stays a verbatim external key.
  email                    String                    @unique
  name                     String
  // Structured ФИО parts (surname-first). `name` stays the stored,
  // denormalized display value recomputed from these on admin write.
  // lastName/firstName are NOT NULL; SAML stubs synthesize them
  // (lastName = whole displayName, firstName = " " placeholder, middleName =
  // null) since the IdP name order isn't known — an admin completes them later.
  lastName                 String
  firstName                String
  middleName               String?
  // Admin-maintained HR job title (должность), distinct from the access
  // `role`. Free-text, nullable, never sourced from the IdP.
  position                 String?
  role                     Role
  samlId                   String                    @unique
  reportingGroupId         String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  notificationOptOut       Boolean                   @default(false)
  // Soft-deactivation flag. false = deactivated.
  // Sessions are immediately revoked in Redis; Prisma is the authoritative
  // source for the isActive state.
  isActive                 Boolean                   @default(true)
  reportingGroup           ReportingGroup?           @relation(fields: [reportingGroupId], references: [id])
  ledProjects              Project[]
  reopenRequestsRequested  ReopenRequest[]           @relation("ReopenRequester")
  reopenRequestsReviewed   ReopenRequest[]           @relation("ReopenReviewer")
  publishedReports         Report[]                  @relation("PublishedBy")
  authoredReportSections   ReportSection[]           @relation("ReportSectionAuthor")
  stageAssignments         StageAssignment[]
  // Back-relations for group headship and viewer-group access.
  ledGroups                ReportingGroup[]          @relation("GroupHead")
  viewerGroupAccess        ViewerGroupAccess[]       @relation("ViewerGroupAccessViewer")
  // review-acknowledgement back-relations. A user authors acknowledgement
  // receipts, section verdicts, and record comments as a reviewer.
  reviewAcknowledgements   ReviewAcknowledgement[]   @relation("ReviewAckUser")
  sectionReviews           SectionReview[]           @relation("SectionReviewReviewer")
  recordComments           RecordComment[]           @relation("RecordCommentReviewer")
  // Project Activities this lead is attached to (M:M via the join below).
  projectActivityLeads     ProjectActivityLead[]     @relation("ProjectActivityLeadUser")
  productFeedback          ProductFeedback[]         @relation("ProductFeedbackAuthor")
  agentationSessions       AgentationSession[]
  agentationAnnotations    AgentationAnnotation[]    @relation("AgentationAnnotationAuthor")
  agentationEvents         AgentationEvent[]
  agentationThreadMessages AgentationThreadMessage[]

  @@index([reportingGroupId])
}

// Authenticated product feedback remains in the original tables so replacing
// the widget transport does not rewrite or discard existing records.
model ProductFeedback {
  id                     String                      @id @default(cuid())
  projectName            String
  type                   String
  message                String                      @db.Text
  status                 String                      @default("open")
  url                    String
  urlPattern             String?
  screenshotUrl          String?                     @db.Text
  screenshotRegion       Json?
  diagnostics            Json?
  viewport               String
  userAgent              String
  authorUserId           String
  authorName             String
  authorEmail            String
  authorReportingGroupId String?
  clientId               String                      @unique
  resolvedAt             DateTime?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  author                 User                        @relation("ProductFeedbackAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  annotations            ProductFeedbackAnnotation[]

  @@index([projectName, status, createdAt(sort: Desc)])
  @@index([projectName, authorUserId, createdAt(sort: Desc)])
  @@index([projectName, authorReportingGroupId, status, createdAt(sort: Desc)])
  @@index([projectName, url])
  @@index([authorUserId])
  @@map("SitepingFeedback")
}

model ProductFeedbackAnnotation {
  id               String          @id @default(cuid())
  feedbackId       String
  cssSelector      String          @db.Text
  xpath            String          @db.Text
  textSnippet      String          @db.Text
  elementTag       String
  elementId        String?
  textPrefix       String          @db.Text
  textSuffix       String          @db.Text
  fingerprint      String
  neighborText     String          @db.Text
  anchorKey        String?
  xPct             Float
  yPct             Float
  wPct             Float
  hPct             Float
  scrollX          Float
  scrollY          Float
  viewportW        Int
  viewportH        Int
  devicePixelRatio Float           @default(1)
  createdAt        DateTime        @default(now())
  feedback         ProductFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([feedbackId])
  @@map("SitepingAnnotation")
}

// Agentation's browser/MCP wire data. Kept separate from the legacy feedback
// tables so existing ProductFeedback rows and their status semantics remain
// untouched while the PostgreSQL database becomes the production source of truth.
model AgentationSession {
  id                     String                 @id
  url                    String
  status                 String                 @default("active")
  projectId              String                 @default("weekly-report")
  metadata               Json?
  authorUserId           String
  authorReportingGroupId String?
  authorRole             String
  authorName             String
  authorEmail            String
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  author                 User                   @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  annotations            AgentationAnnotation[]
  events                 AgentationEvent[]

  @@unique([authorUserId, url])
  @@index([authorUserId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

model AgentationAnnotation {
  id                     String                    @id
  clientId               String
  sessionId              String
  x                      Float
  y                      Float
  comment                String                    @db.Text
  element                String                    @db.Text
  elementPath            String                    @db.Text
  timestamp              BigInt
  selectedText           String?                   @db.Text
  boundingBox            Json?
  nearbyText             String?                   @db.Text
  cssClasses             String?                   @db.Text
  nearbyElements         String?                   @db.Text
  computedStyles         String?                   @db.Text
  fullPath               String?                   @db.Text
  accessibility          String?                   @db.Text
  isMultiSelect          Boolean                   @default(false)
  isFixed                Boolean                   @default(false)
  reactComponents        String?                   @db.Text
  sourceFile             String?                   @db.Text
  drawingIndex           Int?
  elementBoundingBoxes   Json?
  placement              Json?
  rearrange              Json?
  url                    String?
  kind                   String                    @default("feedback")
  intent                 String?
  severity               String?
  status                 String                    @default("pending")
  resolvedAt             DateTime?
  resolvedBy             String?
  authorUserId           String
  authorReportingGroupId String?
  authorRole             String
  authorName             String
  authorEmail            String
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  session                AgentationSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  author                 User                      @relation("AgentationAnnotationAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  threadMessages         AgentationThreadMessage[]

  @@unique([sessionId, authorUserId, clientId])
  @@index([sessionId, timestamp])
  @@index([status, createdAt])
  @@index([authorUserId, status, createdAt])
}

model AgentationEvent {
  id           String             @id @default(uuid())
  sequence     BigInt             @unique @default(autoincrement())
  type         String
  sessionId    String?
  annotationId String?
  payload      Json
  createdAt    DateTime           @default(now())
  authorUserId String?
  author       User?              @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  session      AgentationSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, sequence])
  @@index([sequence])
  @@index([authorUserId])
}

model AgentationThreadMessage {
  id           String               @id
  annotationId String
  role         String
  content      String               @db.Text
  timestamp    BigInt
  authorUserId String?
  createdAt    DateTime             @default(now())
  annotation   AgentationAnnotation @relation(fields: [annotationId], references: [id], onDelete: Cascade)
  author       User?                @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([annotationId, timestamp])
  @@index([authorUserId])
}

model ReportingGroup {
  id                     String                  @id @default(uuid())
  name                   String
  description            String?
  archived               Boolean                 @default(false)
  // Optional FK to the User (role=head or role=admin) who runs
  // this reporting group. Nullable because freshly-created groups may not
  // have a leader assigned yet; a UI guard nudges admins to set one.
  // Application-level invariant (not DB CHECK): the referenced User's role
  // must be 'head' or 'admin'.
  headUserId             String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  users                  User[]
  head                   User?                   @relation("GroupHead", fields: [headUserId], references: [id], onDelete: SetNull)
  viewerAccess           ViewerGroupAccess[]
  // review-acknowledgement: group-level seen receipts for this group's report.
  reviewAcknowledgements ReviewAcknowledgement[]
  // Explicit M:M edge to Project (products owned by
  // this group). Inverse of GroupProduct.group. See `GroupProduct` model.
  groupProducts          GroupProduct[]
  // Project Activities owned by this group (authoritative `groupId`).
  projectActivities      ProjectActivity[]

  @@index([archived])
  @@index([headUserId])
}

// Viewer↔group M:M access table. A viewer (e.g. Дарья) can be
// granted visibility into N reporting groups; admins manage rows here from
// the Users tab. head/admin/lead do NOT use this table — their visibility
// is derived from User.reportingGroupId (head) or full access (admin) or
// own section only (lead).
model ViewerGroupAccess {
  id           String         @id @default(uuid())
  viewerUserId String
  groupId      String
  // review-acknowledgement: per-row reviewer designation. When true, this
  // viewer may post per-section verdicts and per-record comments on THIS
  // group's sections (head/admin are reviewers implicitly). Designation never
  // crosses groups — it lives on the (viewer, group) row, so a viewer granted
  // canReview for group A cannot review group B.
  canReview    Boolean        @default(false)
  createdAt    DateTime       @default(now())
  viewer       User           @relation("ViewerGroupAccessViewer", fields: [viewerUserId], references: [id], onDelete: Cascade)
  group        ReportingGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([viewerUserId, groupId])
  @@index([viewerUserId])
  @@index([groupId])
}

model UserActionLog {
  id            String           @id @default(uuid())
  userId        String
  role          Role?
  procedure     String
  targetId      String?
  status        UserActionStatus
  reason        String?
  ip            String?
  correlationId String
  durationMs    Int
  createdAt     DateTime         @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([procedure, createdAt(sort: Desc)])
  @@index([correlationId])
  @@index([createdAt(sort: Desc)])
}

model Project {
  id               String                   @id @default(uuid())
  name             String
  archived         Boolean                  @default(false)
  leadId           String
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  // Prisma maps PostgreSQL stored generated columns to dbgenerated defaults;
  // the migration keeps the physical GENERATED ALWAYS AS definition.
  searchTsv        Unsupported("tsvector")? @default(dbgenerated("to_tsvector('russian'::regconfig, COALESCE(name, ''::text))"))
  items            Item[]
  lead             User                     @relation(fields: [leadId], references: [id])
  projectStatuses  ProjectStatus[]
  risks            Risk[]
  stageStatuses    StageStatus[]
  stageAssignments StageAssignment[]
  // Explicit product ownership edge to ReportingGroup. Person scope remains
  // on `lead.reportingGroupId`; product scope reads this relation.
  groupProducts    GroupProduct[]
  // Product-parented decisions. The parent FK is nullable because a decision
  // may be activity-parented instead (XOR); Restrict keeps authored rows.
  decisions        Decision[]
  // Activities linked to this product via the M:N ProjectActivityProduct join.
  // The link is label-only display metadata; it never feeds product health.
  activityProducts ProjectActivityProduct[]

  @@index([leadId])
  @@index([archived])
  @@index([searchTsv], type: Gin)
}

// Explicit Group → Product ownership edge:
//   - a product belongs to exactly one reporting group, enforced by
//     `@@unique([productId])`; a group can contain many products;
//   - lead rotation does not change product ownership at the group level;
//   - head dashboards can read «my group's products» without joining through User.
model GroupProduct {
  id        String         @id @default(uuid())
  groupId   String
  productId String
  createdAt DateTime       @default(now())
  group     ReportingGroup @relation(fields: [groupId], references: [id])
  product   Project        @relation(fields: [productId], references: [id])

  // One-group-per-product invariant. A product belongs to exactly one
  // reporting group; a group can contain many products.
  @@unique([productId])
  @@index([groupId])
}

model Report {
  id                     String                    @id @default(uuid())
  periodStart            DateTime
  periodEnd              DateTime
  // Nullable by ruling F16 (allow-deadline-explicit-clear): an admin may
  // clear a period's deadline; deadline-driven automation (gate, reminders,
  // auto-publish) must then skip that period EXPLICITLY, never via fallback.
  deadline               DateTime?
  status                 ReportStatus              @default(draft)
  publishedAt            DateTime?
  publishedById          String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  periodStatus           PeriodStatus              @default(open)
  reopenedAt             DateTime?
  weekLabel              String?
  // Lifecycle flag set by the auto-archiver scheduler
  // when `AppSettings.autoArchiveWeeksAfterPublish > 0` AND
  // `publishedAt + weeks * 7d < now`. Indexed alongside periodStart so the
  // archive dashboard's "last N un-archived" query stays cheap.
  archived               Boolean                   @default(false)
  // Lifecycle audit flags surfaced by the period state-machine.
  // `autoPublished` is set true when the auto-publish scheduler flips
  // status=draft→published at deadline+grace (vs an explicit head
  // action). `autoArchived` mirrors that for the auto-archive scheduler.
  autoPublished          Boolean                   @default(false)
  autoArchived           Boolean                   @default(false)
  // Explicit archive lifecycle state. Writers update it atomically with
  // `status`, `archived`, and `periodStatus`; each field serves a current
  // product query or state transition. SCHEDULED is reserved for future
  // periods minted by the PeriodCreator scheduler.
  // Note: `PeriodState` and `PeriodStatus` are intentionally separate
  // state machines — `periodStatus` carries the reopen flavour
  // (open/published/reopened, no archived); `periodState` carries the
  // archive lifecycle (scheduled/open/published/archived, no reopened).
  // On reopen we revert `periodState` to `open` while flipping
  // `periodStatus` to `reopened` so editability and publication lineage remain explicit.
  periodState            PeriodState               @default(open)
  // Immutable publish-time read model for archive and
  // director-facing published views. Reopen/draft edits after publication
  // must not mutate the published output until the next publish writes a
  // replacement snapshot. The canonical init also enforces that a report
  // with status=published always has this persisted snapshot.
  publishedSnapshot      Json?
  publishedSectionScopes PublishedSectionScope[]
  publishedSearchDocs    PublishedSearchDocument[]
  carryOverSources       CarryOverExecution[]      @relation("CarryOverSource")
  carryOverTargets       CarryOverExecution[]      @relation("CarryOverTarget")
  pdfExportJobs          PdfExportJob[]
  reminderRules          ReminderRule[]
  publishedBy            User?                     @relation("PublishedBy", fields: [publishedById], references: [id], onDelete: Restrict)
  sections               ReportSection[]
  // review-acknowledgement: group-level seen receipts pinned to this period.
  reviewAcknowledgements ReviewAcknowledgement[]
  // Partial EXCLUDE constraint "Report_no_live_period_overlap" on the closed
  // [periodStart, periodEnd] tsrange is hand-written in the canonical init
  // because Prisma cannot express PostgreSQL exclusion constraints.
  // It keeps editable live ranges non-overlapping while allowing durable
  // published/archived republish history to share an envelope.

  @@index([periodStart(sort: Desc)])
  @@index([publishedById])
  @@index([status, periodStart(sort: Desc)])
  @@index([archived, periodStart(sort: Desc)])
  @@index([periodState, periodStart(sort: Desc)])
}

// Immutable publish-time authorization projection. Identifiers deliberately
// do not reference mutable section/user/group rows: recovery may restore the
// frozen report without that live graph, and later ownership changes must not
// rewrite historical visibility.
model PublishedSectionScope {
  reportId        String
  reportSectionId String
  authorId        String
  groupId         String
  report          Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@id([reportId, reportSectionId])
  @@index([groupId, reportId])
  @@index([authorId, reportId])
}

// Immutable, bounded full-text projection derived from publishedSnapshot.
// It carries no FK to mutable records or groups; Report is its sole lifecycle
// owner and deletes cascade only when the frozen report itself is deleted.
model PublishedSearchDocument {
  reportId        String
  reportSectionId String
  recordType      PublishedSearchRecordType
  recordId        String
  stableId        String
  groupId         String
  projectId       String?
  title           String
  searchText      String
  createdAt       DateTime
  searchTsv       Unsupported("tsvector")?  @default(dbgenerated("to_tsvector('russian'::regconfig, COALESCE(\"searchText\", ''::text))"))
  report          Report                    @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@id([reportId, recordType, recordId])
  @@index([recordType, stableId])
  @@index([groupId, createdAt(sort: Desc)])
  @@index([searchTsv], type: Gin)
}

model ReportSection {
  id               String              @id @default(uuid())
  reportId         String
  authorId         String
  status           ReportSectionStatus @default(draft)
  submittedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  // Optimistic-concurrency row revision: every section write does a
  // compare-and-set on this column and increments it, so a stale writer's
  // delete-then-recreate cannot silently clobber a newer save (a conflict
  // surfaces as 409). Distinct from the published-snapshot version.
  version          Int                 @default(1)
  revokedAt        DateTime?
  revokedBy        String?
  // Stamped true by submitSection when
  // `now > Report.deadline` (regardless of grace-period). Used by head
  // dashboard + lead form to render a "late" badge.
  late             Boolean             @default(false)
  decisions        Decision[]
  items            Item[]
  itemOutcomeEvents ItemOutcomeEvent[]
  projectStatuses  ProjectStatus[]
  reopenRequests   ReopenRequest[]
  author           User                @relation("ReportSectionAuthor", fields: [authorId], references: [id])
  report           Report              @relation(fields: [reportId], references: [id], onDelete: Cascade)
  risks            Risk[]
  stageStatuses    StageStatus[]
  // review-acknowledgement: per-section verdicts (one per reviewer).
  sectionReviews   SectionReview[]
  // Per-period weekly statuses for the author's attached Project Activities
  // (stage-less units beside products). Seeded at section provisioning and
  // delete-recreated by saveSection like ProjectStatus.
  activityStatuses ActivityStatus[]

  @@unique([reportId, authorId])
  @@index([authorId])
  @@index([status])
}

model ProjectStatus {
  id              String              @id @default(uuid())
  reportSectionId String
  projectId       String
  status          TrafficLightStatus?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  project         Project             @relation(fields: [projectId], references: [id])
  reportSection   ReportSection       @relation(fields: [reportSectionId], references: [id], onDelete: Cascade)

  @@unique([reportSectionId, projectId])
  @@index([projectId])
}

// A first-class, stage-less reporting unit beside Products. Admin-provisioned;
// belongs to exactly one reporting group via the required authoritative
// `groupId` (never re-derived from a lead's group, so lead rotation does not
// move it). Links to product(s) M:N via ProjectActivityProduct — a LABEL-ONLY
// link that never entangles product health. Owns its own items/risks/decisions
// (XOR parent); its status is derived from those, never from an SDLC stage.
// `jiraAccounts` is plain text; Jira is not integrated.
model ProjectActivity {
  id               String                   @id @default(uuid())
  name             String
  groupId          String
  jiraAccounts     String[]
  archived         Boolean                  @default(false)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  group            ReportingGroup           @relation(fields: [groupId], references: [id])
  leads            ProjectActivityLead[]
  activityStatuses ActivityStatus[]
  // M:N label-only links to products; reconciled by the admin activity CRUD.
  activityProducts ProjectActivityProduct[]
  // Activity-parented records (XOR with a product parent). Restrict on delete —
  // retire an activity via `archived`, never hard-delete its owned records.
  items            Item[]
  risks            Risk[]
  decisions        Decision[]

  @@index([groupId])
  @@index([archived])
}

// M:M attachment: many leads report one activity; each attached lead reports
// their own weekly status through their own section.
model ProjectActivityLead {
  id         String          @id @default(uuid())
  activityId String
  leadId     String
  createdAt  DateTime        @default(now())
  activity   ProjectActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  lead       User            @relation("ProjectActivityLeadUser", fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([activityId, leadId])
  @@index([leadId])
}

// M:N label-only link between an activity and the product(s) it reports against.
// Cascade on the activity side (mirrors ProjectActivityLead); label-only on the
// product side (a product is retired via `archived`, never hard-deleted), so no
// Cascade there. Reconciled by the admin activity CRUD to `linkedProductIds`.
model ProjectActivityProduct {
  id         String          @id @default(uuid())
  activityId String
  productId  String
  createdAt  DateTime        @default(now())
  activity   ProjectActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  product    Project         @relation(fields: [productId], references: [id])

  @@unique([activityId, productId])
  @@index([productId])
}

// Per-period weekly status of one activity on one lead's section. Mirrors
// ProjectStatus: a ReportSection child row, seeded default-green at section
// provisioning and delete-recreated by saveSection under the section's
// optimistic lock. Restrict on activity delete (retire via `archived`).
model ActivityStatus {
  id              String              @id @default(uuid())
  reportSectionId String
  activityId      String
  status          TrafficLightStatus?
  // Weekly override of the catalogue activity name; null means "use catalogue".
  titleOverride   String?
  // Weekly description; the catalogue has no description field to override.
  note            String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  reportSection   ReportSection       @relation(fields: [reportSectionId], references: [id], onDelete: Cascade)
  activity        ProjectActivity     @relation(fields: [activityId], references: [id])

  @@unique([reportSectionId, activityId])
  @@index([activityId])
}

model StageStatus {
  id              String              @id @default(uuid())
  reportSectionId String
  projectId       String
  stageId         String
  status          TrafficLightStatus?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  // Restrict on project delete (matching Item/Risk/ProjectStatus): hard product
  // deletion is unsupported; retire a product via the `archived` flag instead.
  project         Project             @relation(fields: [projectId], references: [id])
  reportSection   ReportSection       @relation(fields: [reportSectionId], references: [id], onDelete: Cascade)
  stage           Stage               @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([reportSectionId, projectId, stageId])
  @@index([projectId])
  @@index([stageId])
}

model Item {
  id              String                   @id @default(uuid())
  // Durable lineage key, distinct from the volatile PK `id`. saveSection
  // delete-recreates child rows on every write (the DB re-mints `id`), so
  // record-level features (comment anchors, move-in-place, the published
  // lifecycle lock) key on `stableId` — minted once, preserved through the
  // recreate, and copied onto a carried clone so a позиция keeps one identity
  // across periods.
  stableId        String                   @default(uuid())
  reportSectionId String
  // XOR parent: exactly one of projectId / activityId is non-null (hand-written
  // CHECK in the init migration). An activity-parented item carries no stage.
  projectId       String?
  activityId      String?
  type            ItemType
  text            String
  tag             String
  workflowStatus  ItemWorkflowStatus
  carriedOver     Boolean                  @default(false)
  priorityRank    Int?
  // require-paused-item-reason: paused items must carry visible reason text;
  // every other workflow status must leave this field null. The shared write
  // schema and the canonical init CHECK enforce the same invariant.
  pausedReason    String?
  // Next-period intent is independent of this period's reported result.
  nextStepText    String?
  // Server-owned cancellation state; ordinary draft saves preserve it by lineage.
  resolution      Json?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  searchTsv       Unsupported("tsvector")? @default(dbgenerated("to_tsvector('russian'::regconfig, COALESCE(text, ''::text))"))
  stageNames      String[]                 @default([])
  project         Project?                 @relation(fields: [projectId], references: [id], onDelete: Restrict)
  activity        ProjectActivity?         @relation(fields: [activityId], references: [id], onDelete: Restrict)
  reportSection   ReportSection            @relation(fields: [reportSectionId], references: [id], onDelete: Cascade)
  // review-acknowledgement: reviewer comments anchored to this item (cascade
  // on delete; saveSection preserves them across its recreate — see the
  // comment-transfer step in report-sections.prisma-repository).
  recordComments  RecordComment[]

  @@unique([reportSectionId, stableId])
  @@index([reportSectionId])
  @@index([projectId])
  @@index([activityId])
  @@index([reportSectionId, priorityRank])
  @@index([stableId])
  @@index([searchTsv], type: Gin)
}

// Append-preserving command receipt and domain audit. No Item FK: section saves
// recreate Item ids, while the stableId and these events must survive.
model ItemOutcomeEvent {
  id              String        @id
  reportSectionId String
  stableId        String
  requestHash     String
  outcome         String
  reason          String?
  actorId         String
  actorName       String
  occurredAt      DateTime      @default(now())
  sourceReportId  String?
  beforeState     Json
  afterState      Json
  reversesEventId String?
  reportSection   ReportSection @relation(fields: [reportSectionId], references: [id], onDelete: Cascade)

  @@index([reportSectionId, stableId, occurredAt])
  @@index([stableId, occurredAt])
}

model Risk {
  id              String                   @id @default(uuid())
  // Durable lineage key, distinct from the volatile PK `id` (see Item.stableId).
  // Risks get mint + preserve-through-save only — carry-over does not clone
  // risks today, so there is no cross-period copy path to extend yet.
  stableId        String                   @default(uuid())
  reportSectionId String
  // XOR parent: exactly one of projectId / activityId is non-null (hand-written
  // CHECK in the init migration).
  projectId       String?
  activityId      String?
  risk            String
  impact          String
  mitigation      String
  // Mandatory, no default — every write must carry an explicit
  // at-risk/blocked value (Risk_severity_check CHECK enforces the vocabulary).
  severity        String
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  searchTsv       Unsupported("tsvector")? @default(dbgenerated("to_tsvector('russian'::regconfig, ((((COALESCE(risk, ''::text) || ' '::text) || COALESCE(impact, ''::text)) || ' '::text) || COALESCE(mitigation, ''::text)))"))
  stageNames      String[]                 @default([])
  project         Project?                 @relation(fields: [projectId], references: [id], onDelete: Restrict)
  activity        ProjectActivity?         @relation(fields: [activityId], references: [id], onDelete: Restrict)
  reportSection   ReportSection            @relation(fields: [reportSectionId], references: [id], onDelete: Cascade)
  // review-acknowledgement: reviewer comments anchored to this risk (cascade).
  recordComments  RecordComment[]

  @@unique([reportSectionId, stableId])
  @@index([reportSectionId])
  @@index([projectId])
  @@index([activityId])
  @@index([stableId])
  @@index([searchTsv], type: Gin)
}

model Decision {
  id              String                   @id @default(uuid())
  // Durable lineage key, distinct from the volatile PK `id` (see Item.stableId).
  // Copied onto a carried clone by carry-over so an unresolved decision keeps
  // one identity across periods.
  stableId        String                   @default(uuid())
  reportSectionId String
  // XOR parent: exactly one of productId / activityId is non-null (hand-written
  // CHECK in the init migration). Full parity — an activity owns decisions too.
  productId       String?
  activityId      String?
  text            String
  owner           String
  deadline        DateTime?
  impact          String
  resolvedAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  searchTsv       Unsupported("tsvector")? @default(dbgenerated("to_tsvector('russian'::regconfig, COALESCE(text, ''::text))"))
  stageNames      String[]                 @default([])
  reportSection   ReportSection            @relation(fields: [reportSectionId], references: [id], onDelete: Cascade)
  // Restrict on parent delete (matching Item/Risk/ProjectStatus): hard product
  // or activity deletion is unsupported; retire via the `archived` flag instead.
  project         Project?                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  activity        ProjectActivity?         @relation(fields: [activityId], references: [id], onDelete: Restrict)
  // review-acknowledgement: reviewer comments anchored to this decision (cascade).
  recordComments  RecordComment[]

  @@unique([reportSectionId, stableId])
  @@index([reportSectionId])
  @@index([productId])
  @@index([activityId])
  @@index([stableId])
  @@index([searchTsv], type: Gin)
}

model PdfExportJob {
  id                  String          @id @default(uuid())
  reportId            String
  // Immutable publication identity captured in the same write as the job.
  // The worker must never resolve a mutable Report row for rendering.
  publicationAt       DateTime
  publicationSnapshot Json
  publicationGroupIds String[]
  status              PdfExportStatus @default(pending)
  // Monotonic dispatch generation; every retry increments it by exactly one.
  generation          Int             @default(1)
  templateVersion     String
  filePath            String?
  checksum            String?
  error               String?
  requestedBy         String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  report              Report          @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([requestedBy])
  @@index([createdAt(sort: Desc)])
  @@index([publicationGroupIds], type: Gin)
  @@index([status, createdAt(sort: Desc)])
}

model ReminderRule {
  id         String              @id @default(uuid())
  reportId   String
  policyId   String
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  kind       ReminderRuleKind
  fireAt     DateTime
  // Immutable schedule basis for this rule version. Historical executions
  // validate against it after the owning Report deadline changes.
  deadline   DateTime
  timezone   String              @default("Europe/Moscow")
  status     ReminderRuleStatus  @default(active)
  version    Int                 @default(1)
  executions ReminderExecution[]
  report     Report              @relation(fields: [reportId], references: [id], onDelete: Cascade)
  policy     ReminderPolicy      @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([reportId, policyId, version], map: "uq_rule_report_policy_version")
  @@index([reportId, policyId, version(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([status, fireAt])
  @@index([policyId])
}

// ReminderPolicy is a parameterized template that ReminderRule rows
// reference. One policy declares (kind, offsetMinutes, timezone, audience)
// and acts as the source-of-truth for every concrete rule scheduled against
// a report.
model ReminderPolicy {
  id            String           @id @default(uuid())
  kind          ReminderRuleKind
  offsetMinutes Int
  timezone      String           @default("Europe/Moscow")
  audience      ReminderAudience
  active        Boolean          @default(true)
  validFrom     DateTime         @default(now())
  validUntil    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  rules         ReminderRule[]

  // Canonical SQL CHECK ReminderPolicy_kind_audience_check admits only
  // deadline→lead-with-draft and escalation→head-of-late.

  @@index([kind, active])
  @@index([active])
  @@index([validFrom, validUntil])
}

model ReminderExecution {
  id             String                  @id @default(uuid())
  ruleId         String
  // Persisted recipient identity; the dedupeKey embeds the email for
  // uniqueness but is never parsed back to reconstruct it.
  recipientEmail String
  dedupeKey      String                  @unique
  status         ReminderExecutionStatus @default(pending)
  sentAt         DateTime?
  error          String?
  // Canonical SQL CHECK ReminderExecution_lifecycle_check binds status to
  // sentAt/error; Prisma schema syntax cannot express cross-column checks.
  // Immutable renderer payload; excluded from routine admin listings but
  // included in the explicit admin-recovery snapshot contract.
  queuePayload   Json
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  rule           ReminderRule            @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@index([ruleId])
  @@index([status])
}

model CarryOverExecution {
  id             String            @id @default(uuid())
  sourceReportId String
  targetReportId String
  dedupeKey      String            @unique
  status         CarryOverStatus   @default(completed)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  sourceReport   Report            @relation("CarryOverSource", fields: [sourceReportId], references: [id])
  targetReport   Report            @relation("CarryOverTarget", fields: [targetReportId], references: [id])
  records        CarryOverRecord[]

  @@index([sourceReportId])
  @@index([targetReportId])
}

model CarryOverRecord {
  id               String             @id @default(uuid())
  executionId      String
  sourceItemId     String?
  sourceDecisionId String?
  targetItemId     String?
  targetDecisionId String?
  recordType       String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  execution        CarryOverExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
}

model Stage {
  id               String            @id @default(uuid())
  name             String            @unique
  sortOrder        Int               @default(0)
  createdAt        DateTime          @default(now())
  stageStatuses    StageStatus[]
  stageAssignments StageAssignment[]
}

model StageAssignment {
  id        String   @id @default(uuid())
  userId    String
  stageId   String
  projectId String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage     Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([stageId, projectId])
  @@index([userId])
  @@index([projectId])
}

model ReopenRequest {
  id              String              @id @default(uuid())
  reportSectionId String
  requestedById   String
  reason          String?
  status          ReopenRequestStatus @default(pending)
  reviewedById    String?
  reviewedAt      DateTime?
  reviewNote      String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  reportSection   ReportSection       @relation(fields: [reportSectionId], references: [id], onDelete: Cascade)
  requestedBy     User                @relation("ReopenRequester", fields: [requestedById], references: [id])
  reviewedBy      User?               @relation("ReopenReviewer", fields: [reviewedById], references: [id])
  // reopen-request-lifecycle: at most one pending request per section.
  // Enforced by a PARTIAL unique index `ReopenRequest_one_pending_per_section`
  // ON ("reportSectionId") WHERE "status" = 'pending'. Prisma cannot express a
  // partial-index predicate, so the index is hand-written in the init migration
  // (prisma/migrations/20260530162224_init/migration.sql). Approved/rejected
  // rows are unconstrained, so a section can be reopened, re-submitted, and
  // requested again.

  @@index([status, createdAt])
  @@index([reportSectionId])
  @@index([requestedById])
  @@index([reviewedById])
}

// Org-wide knobs the admin can change without a redeploy. The canonical init
// creates `id='singleton'`; `notificationFromEmail` is the only nullable
// setting without a SQL default. Semantics:
//   - workingDays            : calendar used to calculate period deadlines.
//   - gracePeriodHours +
//     allowLateSubmissions   : when allowLateSubmissions=true, leads can
//                              submit within (deadline + grace); outside the
//                              window submission is blocked. When false, the
//                              deadline is hard.
//   - autoPublishAfterDeadline: scheduler will fire at (deadline + grace);
//                              missing sections render «Не сдал» placeholder.
//                              The toggle is persisted and consumed by the scheduler.
// Brand identity (short + full name) lives on the `Organization` singleton;
// readers consume it via `OrganizationService.getPublic()` or the per-request
// `auth.me.organization` hydration on the wire.
model AppSettings {
  id                           String           @id @default("singleton")
  autoCreatePeriods            Boolean          @default(false)
  defaultDeadlineDays          Int              @default(5)
  periodLengthDays             Int              @default(7)
  workingDays                  WorkingDays      @default(MON_FRI)
  gracePeriodHours             Int              @default(24)
  defaultTimezone              String           @default("Europe/Moscow")
  defaultReminderAudience      ReminderAudience @default(LEAD_WITH_DRAFT)
  notificationFromEmail        String?
  allowLateSubmissions         Boolean          @default(true)
  autoPublishAfterDeadline     Boolean          @default(false)
  autoArchiveWeeksAfterPublish Int              @default(0)
  // Manual period deadlines use deadlineTime in defaultTimezone; publish and
  // reopen gates use allowReopenAfterPublish and reopenWindowHours.
  deadlineTime                 String           @default("18:00")
  allowReopenAfterPublish      Boolean          @default(true)
  reopenWindowHours            Int              @default(72)
  // Org-wide opt-in for the lead form's unified by-state view (a presentation
  // projection over Item.type/workflowStatus/carriedOver — ADR 0011). Off =
  // classic Current-week / Next-week two-section format. No record-shape
  // change rides this flag; physical Item.type storage is untouched.
  unifiedActivityView          Boolean          @default(false)
  updatedAt                    DateTime         @updatedAt
}

// Organization identity singleton. shortName is the compact brand string
// rendered in the nav-bar / page chrome (≤16 chars); fullName is the
// long-form description used on the landing hero and in PDF report headers.
// Singleton invariant enforced at the application layer via `id='singleton'`
// and a baseline row in the canonical init migration. `prisma/seed.ts` may
// update the row with the same product defaults; admins can override via
// Settings → Identity tab.
model Organization {
  id        String   @id @default("singleton")
  shortName String
  fullName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// review-acknowledgement: a group-level "seen" receipt. One row per
// (acknowledger, group, period): reportId pins the period, groupId makes it
// per-group so a viewer with access to two groups in one period can
// acknowledge one without the other. Re-acknowledging is an idempotent upsert
// that refreshes seenAt. Requires only group access — never the reviewer flag.
model ReviewAcknowledgement {
  id       String         @id @default(uuid())
  userId   String
  reportId String
  groupId  String
  // Refreshed on every idempotent re-acknowledge (@default on create,
  // @updatedAt on upsert-update).
  seenAt   DateTime       @default(now()) @updatedAt
  user     User           @relation("ReviewAckUser", fields: [userId], references: [id], onDelete: Cascade)
  report   Report         @relation(fields: [reportId], references: [id], onDelete: Cascade)
  group    ReportingGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, reportId, groupId])
  @@index([reportId, groupId])
  @@index([groupId])
}

// review-acknowledgement: a per-section verdict by a designated reviewer.
// One row per (section, reviewer); posting again upserts. `judgedVersion`
// records the ReportSection.version at verdict time — a verdict is CURRENT
// only while judgedVersion equals the section's version, so a re-submission
// (which bumps version) makes a prior verdict stale with no clearing step.
model SectionReview {
  id              String        @id @default(uuid())
  reportSectionId String
  reviewerId      String
  verdict         ReviewVerdict
  judgedVersion   Int
  // Reviewer reason for changes_requested; NULL for approvals and legacy rows.
  comment         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  reportSection   ReportSection @relation(fields: [reportSectionId], references: [id], onDelete: Cascade)
  reviewer        User          @relation("SectionReviewReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([reportSectionId, reviewerId])
  @@index([reportSectionId])
  @@index([reviewerId])
}

// review-acknowledgement: a reviewer comment anchored to exactly one concrete
// record — an Item, Risk, or Decision (the discriminated FK trio; exactly one
// non-null, enforced by a hand-written CHECK in the init migration and the Zod
// input). Each anchor cascades so a comment dies with its record. Comments are
// flat (no reply threads), and `reviewerId` identifies the human author.
model RecordComment {
  id         String    @id @default(uuid())
  reviewerId String
  text       String
  itemId     String?
  riskId     String?
  decisionId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  reviewer   User      @relation("RecordCommentReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  item       Item?     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  risk       Risk?     @relation(fields: [riskId], references: [id], onDelete: Cascade)
  decision   Decision? @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([riskId])
  @@index([decisionId])
  @@index([reviewerId])
}

// Content-addressed semantic cache. This table intentionally has no report,
// record, ACL, or text columns; canonical occurrences remain the only source
// of report data. Prisma cannot read/write the unsupported vector field, so
// the semantic repository uses parameterized SQL for that field.
model SemanticEmbedding {
  contentHash  String
  provider     String
  model        String
  inputVersion String
  dimensions   Int
  vector       Unsupported("vector")
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  // `provider` stores the stable, non-secret endpoint identity derived from
  // profile + normalized base URL. Dimensions are part of the identity so a
  // staged embedding scope can coexist with the active scope.
  @@id([contentHash, provider, model, inputVersion, dimensions])
  @@index([provider, model, inputVersion, dimensions])
}

// Immutable, organization-wide provider revisions. Credentials are encrypted
// application data; only the masked suffix is safe to return from reads.
model AiProviderConfiguration {
  id                               String                    @id
  generationProfile                AiProviderProfile
  generationBaseUrl                String
  generationEndpointIdentity       String
  plannerModel                     String
  answerModel                      String
  reasoningMode                    AiProviderReasoningMode
  reasoningCustomValue             String?
  generationCredentialCiphertext   String
  generationCredentialNonce        String
  generationCredentialTag          String
  generationCredentialKeyVersion   Int
  generationCredentialMaskedSuffix String
  embeddingMode                    AiProviderEmbeddingMode
  embeddingProfile                 AiProviderProfile?
  embeddingBaseUrl                 String?
  embeddingEndpointIdentity        String?
  embeddingModel                   String
  embeddingDimensions              Int?
  embeddingCredentialCiphertext    String?
  embeddingCredentialNonce         String?
  embeddingCredentialTag           String?
  embeddingCredentialKeyVersion    Int?
  embeddingCredentialMaskedSuffix  String?
  semanticInputVersion             String
  generationCompatibilityIdentity  String
  embeddingScopeIdentity           String
  compositeTestIdentity            String
  lifecycle                        AiProviderLifecycle       @default(draft)
  testResult                       Json?
  testedAt                         DateTime?
  preparationCompleted             Int                       @default(0)
  preparationTotal                 Int                       @default(0)
  preparationFailed                Int                       @default(0)
  preparationStartedAt             DateTime?
  preparationFinishedAt            DateTime?
  preparationElapsedMs             Int                       @default(0)
  preparationSourceFingerprint     String?
  preparationSourceGeneration      BigInt?
  activatedAt                      DateTime?
  supersededAt                     DateTime?
  createdAt                        DateTime                  @default(now())
  updatedAt                        DateTime                  @updatedAt
  activeControl                    AiProviderControl?        @relation("AiProviderControlActive")
  testExecutions                   AiProviderTestExecution[] @relation("AiProviderTestExecutionProvider")

  @@index([lifecycle, updatedAt(sort: Desc)])
  @@index([generationCompatibilityIdentity])
  @@index([embeddingScopeIdentity])
  @@index([compositeTestIdentity])
  @@index([embeddingEndpointIdentity, embeddingModel, semanticInputVersion, embeddingDimensions])
}

// Singleton generation bumped by database triggers on every mutable row that
// can contribute to semantic report input. Activation compares it in the same
// transaction that changes the active pointer.
model SemanticSourceState {
  id         String   @id @default("singleton")
  generation BigInt   @default(0)
  updatedAt  DateTime @updatedAt
}

// Feature-scoped immutable prompt bundles. The JSON columns are server-owned
// snapshots; shared contracts validate the shape before any runtime use.
model AiPromptBundleRevision {
  id                     String                   @id
  featureKey             String
  revision               Int
  baseRevisionId         String?
  coreContractVersion    String
  composerVersion        String
  servingContractVersion String?
  lockedCoreSnapshot     Json
  promptContents         Json
  effectiveContentHash   String
  lifecycle              AiPromptBundleLifecycle  @default(draft)
  createdBy              String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  activatedAt            DateTime?
  supersededAt           DateTime?
  baseRevision           AiPromptBundleRevision?  @relation("AiPromptRevisionBase", fields: [baseRevisionId], references: [id], onDelete: Restrict)
  derivedRevisions       AiPromptBundleRevision[] @relation("AiPromptRevisionBase")
  activeControl          AiFeaturePromptControl?  @relation("AiPromptControlActive")

  @@unique([featureKey, revision])
  @@index([featureKey, lifecycle, updatedAt(sort: Desc)])
  @@index([effectiveContentHash])
  @@index([baseRevisionId])
}

// One control row per code-registered feature. The nullable pointer is the
// only runtime source for an active prompt bundle.
model AiFeaturePromptControl {
  id               String                  @id @default(uuid())
  featureKey       String                  @unique
  activeRevisionId String?                 @unique
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  activeRevision   AiPromptBundleRevision? @relation("AiPromptControlActive", fields: [activeRevisionId], references: [id], onDelete: SetNull)

  @@index([activeRevisionId])
}

// A durable provider-only capability test. It stores only identity, bounded
// classifications, and timestamps; secrets, prompts, and raw responses never
// leave process memory.
model AiProviderTestExecution {
  id                 String                       @id @default(uuid())
  identity           String                       @unique
  providerRevisionId String
  testSuiteVersion   String
  state              AiProviderTestExecutionState @default(queued)
  outcome            AiProviderTestOutcome?
  failureCode        String?
  checks             Json?
  requestedAt        DateTime                     @default(now())
  startedAt          DateTime?
  executionAttempt   Int?
  completedAt        DateTime?
  providerRevision   AiProviderConfiguration      @relation("AiProviderTestExecutionProvider", fields: [providerRevisionId], references: [id], onDelete: Cascade)

  @@index([providerRevisionId, requestedAt(sort: Desc)])
  @@index([state, requestedAt])
}

// Singleton control row. The active pointer is the only source of runtime
// availability; retained revisions remain addressable for explicit restore.
model AiProviderControl {
  id                    String                   @id @default("singleton")
  activeConfigurationId String?                  @unique
  enabled               Boolean                  @default(false)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  activeConfiguration   AiProviderConfiguration? @relation("AiProviderControlActive", fields: [activeConfigurationId], references: [id], onDelete: SetNull)

  @@index([activeConfigurationId])
}

