generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  lead
  head
  viewer
}

enum ReportStatus {
  draft
  published
}

enum ReportSectionStatus {
  draft
  submitted
}

enum TrafficLightStatus {
  green
  yellow
  red
}

enum ItemType {
  current
  next
}

enum ItemWorkflowStatus {
  done
  in_progress
  blocked
}

enum PdfExportStatus {
  pending
  processing
  completed
  failed
}

enum ReminderExecutionStatus {
  pending
  sent
  failed
}

enum CarryOverStatus {
  pending
  completed
  failed
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  name           String
  role           Role
  samlId         String          @unique
  authoredReportSections ReportSection[] @relation("ReportSectionAuthor")
  ledProjects    Project[]
  publishedReports Report[]      @relation("PublishedBy")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Project {
  id             String          @id @default(uuid())
  name           String
  archived       Boolean         @default(false)
  leadId         String
  lead           User            @relation(fields: [leadId], references: [id], onDelete: Restrict)
  projectStatuses ProjectStatus[]
  items          Item[]
  risks          Risk[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Report {
  id             String          @id @default(uuid())
  periodStart    DateTime
  periodEnd      DateTime
  deadline       DateTime
  status         ReportStatus    @default(draft)
  publishedAt    DateTime?
  publishedById  String?
  publishedBy    User?           @relation("PublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  sections       ReportSection[]
  pdfExportJobs  PdfExportJob[]
  reminderRules  ReminderRule[]
  carryOverSources CarryOverExecution[] @relation("CarryOverSource")
  carryOverTargets CarryOverExecution[] @relation("CarryOverTarget")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model ReportSection {
  id             String               @id @default(uuid())
  reportId       String
  authorId       String
  status         ReportSectionStatus  @default(draft)
  submittedAt    DateTime?
  report         Report               @relation(fields: [reportId], references: [id], onDelete: Cascade)
  author         User                 @relation("ReportSectionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  projectStatuses ProjectStatus[]
  items          Item[]
  risks          Risk[]
  decisions      Decision[]
  priorities     Priority[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([reportId, authorId])
}

model ProjectStatus {
  id             String             @id @default(uuid())
  reportSectionId String
  projectId       String
  status          TrafficLightStatus
  reportSection   ReportSection     @relation(fields: [reportSectionId], references: [id], onDelete: Cascade)
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([reportSectionId, projectId])
}

model Item {
  id             String             @id @default(uuid())
  reportSectionId String
  projectId       String
  type            ItemType
  text            String
  tag             String
  workflowStatus  ItemWorkflowStatus
  carriedOver     Boolean           @default(false)
  completed       Boolean?
  reportSection   ReportSection     @relation(fields: [reportSectionId], references: [id], onDelete: Cascade)
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Risk {
  id             String          @id @default(uuid())
  reportSectionId String
  projectId       String
  risk            String
  impact          String
  mitigation      String
  reportSection   ReportSection  @relation(fields: [reportSectionId], references: [id], onDelete: Cascade)
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Decision {
  id             String          @id @default(uuid())
  reportSectionId String
  text           String
  owner          String
  deadline       DateTime?
  impact         String
  resolvedAt     DateTime?
  reportSection  ReportSection   @relation(fields: [reportSectionId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Priority {
  id             String          @id @default(uuid())
  reportSectionId String
  rank           Int
  text           String
  reportSection  ReportSection   @relation(fields: [reportSectionId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([reportSectionId, rank])
}

model PdfExportJob {
  id          String          @id @default(uuid())
  reportId    String
  status      PdfExportStatus @default(pending)
  filePath    String?
  error       String?
  requestedBy String
  report      Report          @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model ReminderRule {
  id              String               @id @default(uuid())
  name            String
  cronExpression  String
  enabled         Boolean              @default(true)
  reportId        String?
  report          Report?              @relation(fields: [reportId], references: [id], onDelete: SetNull)
  executions      ReminderExecution[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model ReminderExecution {
  id          String                   @id @default(uuid())
  ruleId      String
  dedupeKey   String                   @unique
  status      ReminderExecutionStatus  @default(pending)
  sentAt      DateTime?
  error       String?
  rule        ReminderRule             @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
}

model CarryOverExecution {
  id              String          @id @default(uuid())
  sourceReportId  String
  targetReportId  String
  dedupeKey       String          @unique
  status          CarryOverStatus @default(pending)
  records         CarryOverRecord[]
  sourceReport    Report          @relation("CarryOverSource", fields: [sourceReportId], references: [id], onDelete: Restrict)
  targetReport    Report          @relation("CarryOverTarget", fields: [targetReportId], references: [id], onDelete: Restrict)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model CarryOverRecord {
  id               String             @id @default(uuid())
  executionId      String
  sourceItemId     String?
  sourceDecisionId String?
  targetItemId     String?
  targetDecisionId String?
  recordType       String
  execution        CarryOverExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}
