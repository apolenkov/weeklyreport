  completed
}

enum PeriodStatus {
  open
  published
  reopened
}

// Canonical report lifecycle state. The companion `status`, `periodStatus`,
// `archived`, audit flags, and applicable timestamps remain separate fields
// and are written atomically with this state; `periodStatus` carries reopen
// semantics while this enum carries the archive lifecycle.
enum PeriodState {
  scheduled
  open
  published
  archived
}

enum ReopenRequestStatus {
  pending
  approved
  rejected
}

enum ReminderRuleKind {
  deadline
  escalation
}

enum ReminderAudience {
  LEAD_WITH_DRAFT
  HEAD_OF_LATE
}

// The org «working days» policy surfaced in AppSettings.
// It DOES drive deadline calculation: `computeDeadline` (apps/api/src/lib/
// business-date.ts) selects the business-day set from this policy — mon-fri = 5
// days, mon-sat = 6, mon-sun = 7 — and is called with `settings.workingDays`
// from period-creator.scheduler.ts and period-admin.service.ts. Wire format
// mirrors the screaming-snake convention of ReminderAudience;
// admin.prisma-repository.ts owns the wire ↔ Prisma mapper
// (`mon-fri | mon-sat | mon-sun`).
enum WorkingDays {
  MON_FRI
  MON_SAT
  MON_SUN
}

enum ReminderRuleStatus {
  active
  paused
}

enum PublishedSearchRecordType {
  item
  risk
  decision
}
