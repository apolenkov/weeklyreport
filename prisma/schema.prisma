generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String              @id @default(uuid())
  email                   String              @unique
  name                    String
  role                    Role
  samlId                  String              @unique
  reportingGroupId        String
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  notificationOptOut      Boolean             @default(false)
  reportingGroup          ReportingGroup      @relation(fields: [reportingGroupId], references: [id])
  ledProjects             Project[]
  reopenRequestsRequested ReopenRequest[]     @relation("ReopenRequester")
  reopenRequestsReviewed  ReopenRequest[]     @relation("ReopenReviewer")
  publishedReports        Report[]            @relation("PublishedBy")
  authoredReportSections  ReportSection[]     @relation("ReportSectionAuthor")
  stageAssignments        StageAssignment[]
  // UFB-039 back-relations
  ledGroups               ReportingGroup[]    @relation("GroupHead")
  viewerGroupAccess       ViewerGroupAccess[] @relation("ViewerGroupAccessViewer")

  @@index([reportingGroupId])
}

model ReportingGroup {
  id           String              @id @default(uuid())
  name         String
  description  String?
  archived     Boolean             @default(false)
  // UFB-039: optional FK to the User (role=head or role=admin) who runs
  // this reporting group. Nullable because freshly-created groups may not
  // have a leader assigned yet; a UI guard nudges admins to set one.
  // Application-level invariant (not DB CHECK): the referenced User's role
  // must be 'head' or 'admin'.
  headUserId   String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  users        User[]
  head         User?               @relation("GroupHead", fields: [headUserId], references: [id], onDelete: SetNull)
  viewerAccess ViewerGroupAccess[]

  @@index([archived])
  @@index([headUserId])
}

// UFB-039: viewer↔group M:M access table. A viewer (e.g. Дарья) can be
// granted visibility into N reporting groups; admins manage rows here from
// the Users tab. head/admin/lead do NOT use this table — their visibility
// is derived from User.reportingGroupId (head) or full access (admin) or
// own section only (lead).
model ViewerGroupAccess {
  id           String         @id @default(uuid())
  viewerUserId String
  groupId      String
  createdAt    DateTime       @default(now())
  viewer       User           @relation("ViewerGroupAccessViewer", fields: [viewerUserId], references: [id], onDelete: Cascade)
  group        ReportingGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([viewerUserId, groupId])
  @@index([viewerUserId])
  @@index([groupId])
}

model UserActionLog {
  id            String           @id @default(uuid())
  userId        String
  role          Role?
  procedure     String
  targetId      String?
  status        UserActionStatus
  reason        String?
  ip            String?
  correlationId String
  durationMs    Int
  createdAt     DateTime         @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([procedure, createdAt(sort: Desc)])
  @@index([correlationId])
  @@index([createdAt(sort: Desc)])
}

model Project {
  id               String                   @id @default(uuid())
  name             String
  archived         Boolean                  @default(false)
  leadId           String
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  searchTsv        Unsupported("tsvector")? @default(dbgenerated("to_tsvector('russian'::regconfig, COALESCE(name, ''::text))"))
  items            Item[]
  lead             User                     @relation(fields: [leadId], references: [id])
  projectStatuses  ProjectStatus[]
  risks            Risk[]
  stageStatuses    StageStatus[]
  stageAssignments StageAssignment[]

  @@index([leadId])
  @@index([archived])
  @@index([searchTsv], type: Gin)
}

model Report {
  id               String               @id @default(uuid())
  periodStart      DateTime
  periodEnd        DateTime
  deadline         DateTime
  status           ReportStatus         @default(draft)
  publishedAt      DateTime?
  publishedById    String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  periodStatus     PeriodStatus         @default(open)
  reopenedAt       DateTime?
  weekLabel        String?
  carryOverSources CarryOverExecution[] @relation("CarryOverSource")
  carryOverTargets CarryOverExecution[] @relation("CarryOverTarget")
  pdfExportJobs    PdfExportJob[]
  reminderRules    ReminderRule[]
  publishedBy      User?                @relation("PublishedBy", fields: [publishedById], references: [id])
  sections         ReportSection[]

  @@index([periodStart(sort: Desc)])
  @@index([status, periodStart(sort: Desc)])
}

model ReportSection {
  id               String              @id @default(uuid())
  reportId         String
  authorId         String
  status           ReportSectionStatus @default(draft)
  submittedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  revokedAt        DateTime?
  revokedBy        String?
  decisions        Decision[]
  items            Item[]
  priorities       Priority[]
  projectStatuses  ProjectStatus[]
  reopenRequests   ReopenRequest[]
  author           User                @relation("ReportSectionAuthor", fields: [authorId], references: [id])
  report           Report              @relation(fields: [reportId], references: [id], onDelete: Cascade)
  risks            Risk[]
  stageStatuses    StageStatus[]
  versionSnapshots VersionSnapshot[]

  @@unique([reportId, authorId])
  @@index([authorId])
  @@index([status])
}

model ProjectStatus {
  id              String              @id @default(uuid())
  reportSectionId String
  projectId       String
  status          TrafficLightStatus?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  project         Project             @relation(fields: [projectId], references: [id])
  reportSection   ReportSection       @relation(fields: [reportSectionId], references: [id], onDelete: Cascade)

  @@unique([reportSectionId, projectId])
}

model StageStatus {
  id              String              @id @default(uuid())
  reportSectionId String
  projectId       String
  stageId         String
  status          TrafficLightStatus?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reportSection   ReportSection       @relation(fields: [reportSectionId], references: [id], onDelete: Cascade)
  stage           Stage               @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([reportSectionId, projectId, stageId])
  @@index([projectId])
  @@index([stageId])
}

model Item {
  id              String                   @id @default(uuid())
  reportSectionId String
  projectId       String
  type            ItemType
  text            String
  tag             String
  workflowStatus  ItemWorkflowStatus
  carriedOver     Boolean                  @default(false)
  completed       Boolean?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  searchTsv       Unsupported("tsvector")? @default(dbgenerated("to_tsvector('russian'::regconfig, COALESCE(text, ''::text))"))
  stageName       String?
  project         Project                  @relation(fields: [projectId], references: [id])
  reportSection   ReportSection            @relation(fields: [reportSectionId], references: [id], onDelete: Cascade)

  @@index([reportSectionId])
  @@index([projectId])
  @@index([stageName])
  @@index([searchTsv], type: Gin)
}

model Risk {
  id              String                   @id @default(uuid())
  reportSectionId String
  projectId       String
  risk            String
  impact          String
  mitigation      String
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  searchTsv       Unsupported("tsvector")? @default(dbgenerated("to_tsvector('russian'::regconfig, ((((COALESCE(risk, ''::text) || ' '::text) || COALESCE(impact, ''::text)) || ' '::text) || COALESCE(mitigation, ''::text)))"))
  stageName       String?
  project         Project                  @relation(fields: [projectId], references: [id])
  reportSection   ReportSection            @relation(fields: [reportSectionId], references: [id], onDelete: Cascade)

  @@index([reportSectionId])
  @@index([projectId])
  @@index([stageName])
  @@index([searchTsv], type: Gin)
}

model Decision {
  id              String                   @id @default(uuid())
  reportSectionId String
  text            String
  owner           String
  deadline        DateTime?
  impact          String
  resolvedAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  searchTsv       Unsupported("tsvector")? @default(dbgenerated("to_tsvector('russian'::regconfig, COALESCE(text, ''::text))"))
  stageName       String?
  reportSection   ReportSection            @relation(fields: [reportSectionId], references: [id], onDelete: Cascade)

  @@index([reportSectionId])
  @@index([stageName])
  @@index([searchTsv], type: Gin)
}

model Priority {
  id              String        @id @default(uuid())
  reportSectionId String
  rank            Int
  text            String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  stageName       String?
  reportSection   ReportSection @relation(fields: [reportSectionId], references: [id], onDelete: Cascade)

  @@unique([reportSectionId, rank])
  @@index([stageName])
}

model PdfExportJob {
  id          String          @id @default(uuid())
  reportId    String
  status      PdfExportStatus @default(pending)
  filePath    String?
  error       String?
  requestedBy String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  report      Report          @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([status, createdAt(sort: Desc)])
}

model ReminderRule {
  id         String              @id @default(uuid())
  reportId   String?
  policyId   String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  kind       ReminderRuleKind
  fireAt     DateTime
  timezone   String              @default("Europe/Moscow")
  status     ReminderRuleStatus  @default(active)
  version    Int                 @default(1)
  executions ReminderExecution[]
  report     Report?             @relation(fields: [reportId], references: [id])
  policy     ReminderPolicy?     @relation(fields: [policyId], references: [id])

  @@unique([reportId, policyId], map: "uq_rule_report_policy")
  @@index([createdAt(sort: Desc)])
  @@index([status, fireAt])
  @@index([policyId])
}

// UFB-036: ReminderPolicy is a parameterized template that ReminderRule rows
// reference. One policy declares (kind, offsetMinutes, timezone, audience)
// and acts as the source-of-truth for every concrete rule scheduled against
// a report. Phase 44-01 introduces the model with nullable FK; later plans
// flip the FK to NOT NULL once Period.create wires the policy in.
model ReminderPolicy {
  id            String           @id @default(uuid())
  kind          ReminderRuleKind
  offsetMinutes Int
  timezone      String           @default("Europe/Moscow")
  audience      ReminderAudience
  active        Boolean          @default(true)
  validFrom     DateTime         @default(now())
  validUntil    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  rules         ReminderRule[]

  @@index([kind, active])
  @@index([active])
  @@index([validFrom, validUntil])
}

model ReminderExecution {
  id        String                  @id @default(uuid())
  ruleId    String
  dedupeKey String                  @unique
  status    ReminderExecutionStatus @default(pending)
  sentAt    DateTime?
  error     String?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  rule      ReminderRule            @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@index([ruleId])
  @@index([status])
}

model CarryOverExecution {
  id             String            @id @default(uuid())
  sourceReportId String
  targetReportId String
  dedupeKey      String            @unique
  status         CarryOverStatus   @default(pending)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  sourceReport   Report            @relation("CarryOverSource", fields: [sourceReportId], references: [id])
  targetReport   Report            @relation("CarryOverTarget", fields: [targetReportId], references: [id])
  records        CarryOverRecord[]
}

model CarryOverRecord {
  id               String             @id @default(uuid())
  executionId      String
  sourceItemId     String?
  sourceDecisionId String?
  targetItemId     String?
  targetDecisionId String?
  recordType       String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  execution        CarryOverExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
}

model VersionSnapshot {
  id              String        @id @default(uuid())
  reportSectionId String
  version         Int
  data            Json
  createdAt       DateTime      @default(now())
  reportSection   ReportSection @relation(fields: [reportSectionId], references: [id], onDelete: Cascade)

  @@unique([reportSectionId, version])
  @@index([reportSectionId, version(sort: Desc)])
}

model Stage {
  id               String            @id @default(uuid())
  name             String            @unique
  sortOrder        Int               @default(0)
  createdAt        DateTime          @default(now())
  stageStatuses    StageStatus[]
  stageAssignments StageAssignment[]
}

model StageAssignment {
  id        String   @id @default(uuid())
  userId    String
  stageId   String
  projectId String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage     Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([stageId, projectId])
  @@index([projectId])
}

model ReopenRequest {
  id              String              @id @default(uuid())
  reportSectionId String
  requestedById   String
  reason          String?
  status          ReopenRequestStatus @default(pending)
  reviewedById    String?
  reviewedAt      DateTime?
  reviewNote      String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  reportSection   ReportSection       @relation(fields: [reportSectionId], references: [id], onDelete: Cascade)
  requestedBy     User                @relation("ReopenRequester", fields: [requestedById], references: [id])
  reviewedBy      User?               @relation("ReopenReviewer", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
  @@index([reportSectionId])
}

// UFB-048 (Phase 48-B): AppSettings expansion. Nine new org-wide knobs that
// the admin can flip without a redeploy. All fields have SQL defaults so the
// existing singleton row is updated in-place by the migration without manual
// data migration. Semantics:
//   - workingDays            : metadata-only in v1 (UI hint); deadline math
//                              stays Mon-Fri until a future scheduler change.
//   - gracePeriodHours +
//     allowLateSubmissions   : when allowLateSubmissions=true, leads can
//                              submit within (deadline + grace); outside the
//                              window submission is blocked. When false, the
//                              deadline is hard.
//   - autoPublishAfterDeadline: scheduler will fire at (deadline + grace);
//                              missing sections render «Не сдал» placeholder.
//                              Logic deferred — 48-B persists the toggle only.
model AppSettings {
  id                           String           @id @default("singleton")
  departmentName               String           @default("Development")
  autoCreatePeriods            Boolean          @default(false)
  defaultDeadlineDays          Int              @default(5)
  periodLengthDays             Int              @default(7)
  workingDays                  WorkingDays      @default(MON_FRI)
  gracePeriodHours             Int              @default(24)
  defaultTimezone              String           @default("Europe/Moscow")
  defaultReminderAudience      ReminderAudience @default(LEAD_WITH_DRAFT)
  notificationFromEmail        String?
  allowLateSubmissions         Boolean          @default(true)
  autoPublishAfterDeadline     Boolean          @default(false)
  autoArchiveWeeksAfterPublish Int              @default(0)
  updatedAt                    DateTime         @updatedAt
}

// UFB-047 (Phase 48-A): organization identity singleton. shortName is the
// compact brand string rendered in the nav-bar / page chrome (≤16 chars);
// fullName is the long-form description used on the landing hero and in PDF
// report headers. Singleton invariant enforced at the application layer via
// `id='singleton'` upsert — not a DB CHECK constraint. Migration seeds the
// row with Demo / Example Software Department; admins can override via
// Settings → Identity tab.
model Organization {
  id        String   @id @default("singleton")
  shortName String
  fullName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AiInsight {
  id                  String        @id @default(uuid())
  kind                AiInsightKind
  contentHash         String
  result              Json
  modelId             String
  inputTokens         Int           @default(0)
  outputTokens        Int           @default(0)
  cacheCreationTokens Int           @default(0)
  cacheReadTokens     Int           @default(0)
  createdAt           DateTime      @default(now())
  reportId            String?

  @@unique([kind, contentHash])
  @@index([kind, createdAt])
  @@index([reportId, createdAt])
}

enum Role {
  lead
  head
  viewer
  admin
}

enum UserActionStatus {
  success
  fail
}

enum ReportStatus {
  draft
  published
}

enum ReportSectionStatus {
  draft
  submitted
}

enum TrafficLightStatus {
  green
  yellow
  red
}

enum ItemType {
  current
  next
}

enum ItemWorkflowStatus {
  done
  in_progress
  blocked
}

enum PdfExportStatus {
  pending
  processing
  completed
  failed
}

enum ReminderExecutionStatus {
  pending
  sent
  failed
}

enum CarryOverStatus {
  pending
  completed
  failed
}

enum PeriodStatus {
  open
  published
  reopened
}

enum ReopenRequestStatus {
  pending
  approved
  rejected
}

enum ReminderRuleKind {
  deadline
  follow_up
  escalation
}

enum ReminderAudience {
  LEAD_WITH_DRAFT
  HEAD_OF_LATE
}

// UFB-048 (Phase 48-B): metadata-only enum surfaced in AppSettings for the
// «working days» admin hint. v1 does NOT change deadline calculation —
// callers continue to use Mon-Fri. Wire format mirrors the screaming-snake
// convention of ReminderAudience; admin.prisma-repository.ts owns the
// wire ↔ Prisma mapper (`mon-fri | mon-sat | mon-sun`).
enum WorkingDays {
  MON_FRI
  MON_SAT
  MON_SUN
}

enum ReminderRuleStatus {
  active
  paused
}

enum AiInsightKind {
  summary
  sentiment
  on_track
}
