generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  lead
  head
  viewer
}

enum ReportStatus {
  draft
  published
}

enum ReportSectionStatus {
  draft
  submitted
}

enum TrafficLightStatus {
  green
  yellow
  red
}

enum ItemType {
  current
  next
}

enum ItemWorkflowStatus {
  done
  in_progress
  blocked
}

enum PdfExportStatus {
  pending
  processing
  completed
  failed
}

enum ReminderExecutionStatus {
  pending
  sent
  failed
}

enum CarryOverStatus {
  pending
  completed
  failed
}

// v4.0: Period lifecycle (D-56)
enum PeriodStatus {
  open
  published
  reopened
}

model User {
  id                     String            @id @default(uuid())
  email                  String            @unique
  name                   String
  role                   Role
  samlId                 String            @unique
  // NOTIF-05 (Phase 29-05): per-user opt-out for kind='deadline' reminders.
  // Honoured by RemindersService.requestReminderExecution before enqueueing.
  // kind='escalation' bypasses this flag — heads must always be notified.
  notificationOptOut     Boolean           @default(false)
  authoredReportSections ReportSection[]   @relation("ReportSectionAuthor")
  ledProjects            Project[]
  publishedReports       Report[]          @relation("PublishedBy")
  stageAssignments       StageAssignment[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
}

model Project {
  id               String            @id @default(uuid())
  name             String
  archived         Boolean           @default(false)
  leadId           String
  lead             User              @relation(fields: [leadId], references: [id], onDelete: Restrict)
  projectStatuses  ProjectStatus[]
  items            Item[]
  risks            Risk[]
  stageAssignments StageAssignment[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Report {
  id               String               @id @default(uuid())
  periodStart      DateTime
  periodEnd        DateTime
  deadline         DateTime
  status           ReportStatus         @default(draft)
  periodStatus     PeriodStatus         @default(open)
  weekLabel        String?
  publishedAt      DateTime?
  publishedById    String?
  reopenedAt       DateTime?
  publishedBy      User?                @relation("PublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  sections         ReportSection[]
  pdfExportJobs    PdfExportJob[]
  reminderRules    ReminderRule[]
  carryOverSources CarryOverExecution[] @relation("CarryOverSource")
  carryOverTargets CarryOverExecution[] @relation("CarryOverTarget")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model ReportSection {
  id               String              @id @default(uuid())
  reportId         String
  authorId         String
  status           ReportSectionStatus @default(draft)
  submittedAt      DateTime?
  revokedAt        DateTime?
  revokedBy        String?
  report           Report              @relation(fields: [reportId], references: [id], onDelete: Cascade)
  author           User                @relation("ReportSectionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  projectStatuses  ProjectStatus[]
  items            Item[]
  risks            Risk[]
  decisions        Decision[]
  priorities       Priority[]
  versionSnapshots VersionSnapshot[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([reportId, authorId])
}

model ProjectStatus {
  id              String             @id @default(uuid())
  reportSectionId String
  projectId       String
  status          TrafficLightStatus
  reportSection   ReportSection      @relation(fields: [reportSectionId], references: [id], onDelete: Cascade)
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([reportSectionId, projectId])
}

model Item {
  id              String             @id @default(uuid())
  reportSectionId String
  projectId       String
  type            ItemType
  text            String
  tag             String
  workflowStatus  ItemWorkflowStatus
  carriedOver     Boolean            @default(false)
  completed       Boolean?
  reportSection   ReportSection      @relation(fields: [reportSectionId], references: [id], onDelete: Cascade)
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model Risk {
  id              String        @id @default(uuid())
  reportSectionId String
  projectId       String
  risk            String
  impact          String
  mitigation      String
  reportSection   ReportSection @relation(fields: [reportSectionId], references: [id], onDelete: Cascade)
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Decision {
  id              String        @id @default(uuid())
  reportSectionId String
  text            String
  owner           String
  deadline        DateTime?
  impact          String
  resolvedAt      DateTime?
  reportSection   ReportSection @relation(fields: [reportSectionId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Priority {
  id              String        @id @default(uuid())
  reportSectionId String
  rank            Int
  text            String
  reportSection   ReportSection @relation(fields: [reportSectionId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([reportSectionId, rank])
}

model PdfExportJob {
  id          String          @id @default(uuid())
  reportId    String
  status      PdfExportStatus @default(pending)
  filePath    String?
  error       String?
  requestedBy String
  report      Report          @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

enum ReminderRuleKind {
  deadline
  follow_up
  // NOTIF-02 (Phase 29-05): T+2h escalation digest sent to heads when leads
  // miss the deadline. Bypasses User.notificationOptOut.
  escalation
}

enum ReminderRuleStatus {
  active
  paused
}

model ReminderRule {
  id         String              @id @default(uuid())
  kind       ReminderRuleKind
  fireAt     DateTime
  timezone   String              @default("Europe/Moscow")
  status     ReminderRuleStatus  @default(active)
  version    Int                 @default(1)
  reportId   String?
  report     Report?             @relation(fields: [reportId], references: [id], onDelete: SetNull)
  executions ReminderExecution[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
}

model ReminderExecution {
  id        String                  @id @default(uuid())
  ruleId    String
  dedupeKey String                  @unique
  status    ReminderExecutionStatus @default(pending)
  sentAt    DateTime?
  error     String?
  rule      ReminderRule            @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
}

model CarryOverExecution {
  id             String            @id @default(uuid())
  sourceReportId String
  targetReportId String
  dedupeKey      String            @unique
  status         CarryOverStatus   @default(pending)
  records        CarryOverRecord[]
  sourceReport   Report            @relation("CarryOverSource", fields: [sourceReportId], references: [id], onDelete: Restrict)
  targetReport   Report            @relation("CarryOverTarget", fields: [targetReportId], references: [id], onDelete: Restrict)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model CarryOverRecord {
  id               String             @id @default(uuid())
  executionId      String
  sourceItemId     String?
  sourceDecisionId String?
  targetItemId     String?
  targetDecisionId String?
  recordType       String
  execution        CarryOverExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

// v4.0: Version snapshots for autosave history (D-67)
model VersionSnapshot {
  id              String        @id @default(uuid())
  reportSectionId String
  version         Int
  data            Json
  reportSection   ReportSection @relation(fields: [reportSectionId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([reportSectionId, version])
  @@index([reportSectionId, version(sort: Desc)])
}

// v4.0: SDLC stages (D-63)
model Stage {
  id               String            @id @default(uuid())
  name             String            @unique
  sortOrder        Int               @default(0)
  stageAssignments StageAssignment[]
  createdAt        DateTime          @default(now())
}

// v4.0: Stage ownership per user per product (D-63)
model StageAssignment {
  id        String   @id @default(uuid())
  userId    String
  stageId   String
  projectId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage     Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, stageId, projectId])
  @@index([projectId])
}

// v4.0: Application settings singleton (D-68)
model AppSettings {
  id                  String   @id @default("singleton")
  departmentName      String   @default("Development")
  autoCreatePeriods   Boolean  @default(false)
  defaultDeadlineDays Int      @default(5)
  updatedAt           DateTime @updatedAt
}
