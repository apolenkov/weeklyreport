// Progress only — alarms (at-risk/blocked) are never stored on an item, they
// derive from covering risks (record-status-derivation). Per-type vocabulary:
// Week placement and progress are independent; both types accept every value.
// Enforced by shared Zod + a hand-written CHECK in the init migration.
enum ItemWorkflowStatus {
  planned
  in_progress
  paused
  postponed
  done
}

enum PdfExportStatus {
  pending
  completed
  failed
  recovery_required
}

