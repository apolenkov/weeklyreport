generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String            @id @default(uuid())
  email                   String            @unique
  name                    String
  role                    Role
  samlId                  String            @unique
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  notificationOptOut      Boolean           @default(false)
  ledProjects             Project[]
  reopenRequestsRequested ReopenRequest[]   @relation("ReopenRequester")
  reopenRequestsReviewed  ReopenRequest[]   @relation("ReopenReviewer")
  publishedReports        Report[]          @relation("PublishedBy")
  authoredReportSections  ReportSection[]   @relation("ReportSectionAuthor")
  stageAssignments        StageAssignment[]
}

model Project {
  id               String                   @id @default(uuid())
  name             String
  archived         Boolean                  @default(false)
  leadId           String
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  searchTsv        Unsupported("tsvector")? @default(dbgenerated("to_tsvector('russian'::regconfig, COALESCE(name, ''::text))"))
  items            Item[]
  lead             User                     @relation(fields: [leadId], references: [id])
  projectStatuses  ProjectStatus[]
  risks            Risk[]
  stageStatuses    StageStatus[]
  stageAssignments StageAssignment[]

  @@index([leadId])
  @@index([archived])
  @@index([searchTsv], type: Gin)
}

model Report {
  id               String               @id @default(uuid())
  periodStart      DateTime
  periodEnd        DateTime
  deadline         DateTime
  status           ReportStatus         @default(draft)
  publishedAt      DateTime?
  publishedById    String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  periodStatus     PeriodStatus         @default(open)
  reopenedAt       DateTime?
  weekLabel        String?
  carryOverSources CarryOverExecution[] @relation("CarryOverSource")
  carryOverTargets CarryOverExecution[] @relation("CarryOverTarget")
  pdfExportJobs    PdfExportJob[]
  reminderRules    ReminderRule[]
  publishedBy      User?                @relation("PublishedBy", fields: [publishedById], references: [id])
  sections         ReportSection[]

  @@index([periodStart(sort: Desc)])
  @@index([status, periodStart(sort: Desc)])
}

model ReportSection {
  id               String              @id @default(uuid())
  reportId         String
  authorId         String
  status           ReportSectionStatus @default(draft)
  submittedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  revokedAt        DateTime?
  revokedBy        String?
  decisions        Decision[]
  items            Item[]
  priorities       Priority[]
  projectStatuses  ProjectStatus[]
  reopenRequests   ReopenRequest[]
  author           User                @relation("ReportSectionAuthor", fields: [authorId], references: [id])
  report           Report              @relation(fields: [reportId], references: [id], onDelete: Cascade)
  risks            Risk[]
  stageStatuses    StageStatus[]
  versionSnapshots VersionSnapshot[]

  @@unique([reportId, authorId])
  @@index([authorId])
  @@index([status])
}

model ProjectStatus {
  id              String              @id @default(uuid())
  reportSectionId String
  projectId       String
  status          TrafficLightStatus?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  project         Project             @relation(fields: [projectId], references: [id])
  reportSection   ReportSection       @relation(fields: [reportSectionId], references: [id], onDelete: Cascade)

  @@unique([reportSectionId, projectId])
}

model StageStatus {
  id              String              @id @default(uuid())
  reportSectionId String
  projectId       String
  stageId         String
  status          TrafficLightStatus?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reportSection   ReportSection       @relation(fields: [reportSectionId], references: [id], onDelete: Cascade)
  stage           Stage               @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([reportSectionId, projectId, stageId])
  @@index([projectId])
  @@index([stageId])
}

model Item {
  id              String                   @id @default(uuid())
  reportSectionId String
  projectId       String
  type            ItemType
  text            String
  tag             String
  workflowStatus  ItemWorkflowStatus
  carriedOver     Boolean                  @default(false)
  completed       Boolean?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  searchTsv       Unsupported("tsvector")? @default(dbgenerated("to_tsvector('russian'::regconfig, COALESCE(text, ''::text))"))
  stageName       String?
  project         Project                  @relation(fields: [projectId], references: [id])
  reportSection   ReportSection            @relation(fields: [reportSectionId], references: [id], onDelete: Cascade)

  @@index([reportSectionId])
  @@index([projectId])
  @@index([stageName])
  @@index([searchTsv], type: Gin)
}

model Risk {
  id              String                   @id @default(uuid())
  reportSectionId String
  projectId       String
  risk            String
  impact          String
  mitigation      String
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  searchTsv       Unsupported("tsvector")? @default(dbgenerated("to_tsvector('russian'::regconfig, ((((COALESCE(risk, ''::text) || ' '::text) || COALESCE(impact, ''::text)) || ' '::text) || COALESCE(mitigation, ''::text)))"))
  stageName       String?
  project         Project                  @relation(fields: [projectId], references: [id])
  reportSection   ReportSection            @relation(fields: [reportSectionId], references: [id], onDelete: Cascade)

  @@index([reportSectionId])
  @@index([projectId])
  @@index([stageName])
  @@index([searchTsv], type: Gin)
}

model Decision {
  id              String                   @id @default(uuid())
  reportSectionId String
  text            String
  owner           String
  deadline        DateTime?
  impact          String
  resolvedAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  searchTsv       Unsupported("tsvector")? @default(dbgenerated("to_tsvector('russian'::regconfig, COALESCE(text, ''::text))"))
  stageName       String?
  reportSection   ReportSection            @relation(fields: [reportSectionId], references: [id], onDelete: Cascade)

  @@index([reportSectionId])
  @@index([stageName])
  @@index([searchTsv], type: Gin)
}

model Priority {
  id              String        @id @default(uuid())
  reportSectionId String
  rank            Int
  text            String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  stageName       String?
  reportSection   ReportSection @relation(fields: [reportSectionId], references: [id], onDelete: Cascade)

  @@unique([reportSectionId, rank])
  @@index([stageName])
}

model PdfExportJob {
  id          String          @id @default(uuid())
  reportId    String
  status      PdfExportStatus @default(pending)
  filePath    String?
  error       String?
  requestedBy String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  report      Report          @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([status, createdAt(sort: Desc)])
}

model ReminderRule {
  id         String              @id @default(uuid())
  reportId   String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  kind       ReminderRuleKind
  fireAt     DateTime
  timezone   String              @default("Europe/Moscow")
  status     ReminderRuleStatus  @default(active)
  version    Int                 @default(1)
  executions ReminderExecution[]
  report     Report?             @relation(fields: [reportId], references: [id])

  @@index([createdAt(sort: Desc)])
  @@index([status, fireAt])
}

model ReminderExecution {
  id        String                  @id @default(uuid())
  ruleId    String
  dedupeKey String                  @unique
  status    ReminderExecutionStatus @default(pending)
  sentAt    DateTime?
  error     String?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  rule      ReminderRule            @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@index([ruleId])
  @@index([status])
}

model CarryOverExecution {
  id             String            @id @default(uuid())
  sourceReportId String
  targetReportId String
  dedupeKey      String            @unique
  status         CarryOverStatus   @default(pending)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  sourceReport   Report            @relation("CarryOverSource", fields: [sourceReportId], references: [id])
  targetReport   Report            @relation("CarryOverTarget", fields: [targetReportId], references: [id])
  records        CarryOverRecord[]
}

model CarryOverRecord {
  id               String             @id @default(uuid())
  executionId      String
  sourceItemId     String?
  sourceDecisionId String?
  targetItemId     String?
  targetDecisionId String?
  recordType       String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  execution        CarryOverExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
}

model VersionSnapshot {
  id              String        @id @default(uuid())
  reportSectionId String
  version         Int
  data            Json
  createdAt       DateTime      @default(now())
  reportSection   ReportSection @relation(fields: [reportSectionId], references: [id], onDelete: Cascade)

  @@unique([reportSectionId, version])
  @@index([reportSectionId, version(sort: Desc)])
}

model Stage {
  id               String            @id @default(uuid())
  name             String            @unique
  sortOrder        Int               @default(0)
  createdAt        DateTime          @default(now())
  stageStatuses     StageStatus[]
  stageAssignments StageAssignment[]
}

model StageAssignment {
  id        String   @id @default(uuid())
  userId    String
  stageId   String
  projectId String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage     Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, stageId, projectId])
  @@index([projectId])
}

model ReopenRequest {
  id              String              @id @default(uuid())
  reportSectionId String
  requestedById   String
  reason          String?
  status          ReopenRequestStatus @default(pending)
  reviewedById    String?
  reviewedAt      DateTime?
  reviewNote      String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  reportSection   ReportSection       @relation(fields: [reportSectionId], references: [id], onDelete: Cascade)
  requestedBy     User                @relation("ReopenRequester", fields: [requestedById], references: [id])
  reviewedBy      User?               @relation("ReopenReviewer", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
  @@index([reportSectionId])
}

model AppSettings {
  id                  String   @id @default("singleton")
  departmentName      String   @default("CoreDev")
  autoCreatePeriods   Boolean  @default(false)
  defaultDeadlineDays Int      @default(5)
  updatedAt           DateTime @updatedAt
}

model AiInsight {
  id                  String        @id @default(uuid())
  kind                AiInsightKind
  contentHash         String
  result              Json
  modelId             String
  inputTokens         Int           @default(0)
  outputTokens        Int           @default(0)
  cacheCreationTokens Int           @default(0)
  cacheReadTokens     Int           @default(0)
  createdAt           DateTime      @default(now())
  reportId            String?

  @@unique([kind, contentHash])
  @@index([kind, createdAt])
  @@index([reportId, createdAt])
}

enum Role {
  lead
  head
  viewer
  admin
}

enum ReportStatus {
  draft
  published
}

enum ReportSectionStatus {
  draft
  submitted
}

enum TrafficLightStatus {
  green
  yellow
  red
}

enum ItemType {
  current
  next
}

enum ItemWorkflowStatus {
  done
  in_progress
  blocked
}

enum PdfExportStatus {
  pending
  processing
  completed
  failed
}

enum ReminderExecutionStatus {
  pending
  sent
  failed
}

enum CarryOverStatus {
  pending
  completed
  failed
}

enum PeriodStatus {
  open
  published
  reopened
}

enum ReopenRequestStatus {
  pending
  approved
  rejected
}

enum ReminderRuleKind {
  deadline
  follow_up
  escalation
}

enum ReminderRuleStatus {
  active
  paused
}

enum AiInsightKind {
  summary
  sentiment
  on_track
}
