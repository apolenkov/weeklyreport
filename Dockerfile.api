# Stage 1: Base with pnpm and turbo.
# glibc (Debian) rather than alpine: Chromium needs it for PDF export, and the
# native node modules must be built for the same libc the runner uses.
# node:26 no longer ships corepack, so pnpm is installed with npm — the pin is
# held against package.json's packageManager by scripts/check-runtime-node-sync.mjs.
FROM node:26-bookworm@sha256:219fc9da91e7f29a9f32290ff598cdf8886fd68f421ff515c8f93434da39a271 AS base
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN npm install -g pnpm@11.17.0 turbo@2.10.6

# Stage 2: Prune monorepo for api workspace
FROM base AS pruner
WORKDIR /app
COPY . .
RUN turbo prune @customreport/api --docker

# Stage 3: Install deps + generate Prisma (devDeps intact — used for dev hot-reload)
FROM base AS installer
WORKDIR /app
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=pruner /app/out/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=pruner /app/out/json/ .
COPY prisma ./prisma
RUN pnpm install --frozen-lockfile
COPY --from=pruner /app/out/full/ .
COPY tsconfig.base.json ./tsconfig.base.json
COPY prisma.config.ts ./prisma.config.ts
RUN DATABASE_URL=postgresql://customreport:localdev@localhost:5432/customreport pnpm exec prisma generate

# Stage 4: Migration runner with Prisma CLI available.
# Compose/Kubernetes init jobs should use this target, not the production API
# runner, because migrations require the Prisma CLI from devDependencies.
FROM installer AS migrator
CMD ["pnpm", "exec", "prisma", "migrate", "deploy"]

# Stage 5: Build and prune devDeps for production
FROM installer AS builder
RUN pnpm turbo build --filter=@customreport/api
# confirmModulesPurge=false is required, not cosmetic: prune rewrites
# node_modules, and pnpm refuses to do that without a TTY to confirm at —
# which a docker build never has, so the production image cannot build without
# it.
RUN pnpm prune --prod --config.ignore-scripts=true --config.confirmModulesPurge=false

# Stage 6: Production runner
# ~1.5GB because PDF export needs a real Chromium. The 200MB target applies to
# the web image (alpine, ~150MB); this one cannot meet it by construction.
FROM base AS runner
WORKDIR /app

# Copy pruned monorepo structure with production deps only
COPY --from=builder --chown=node:node /app/package.json ./package.json
COPY --from=builder --chown=node:node /app/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=builder --chown=node:node /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=builder --chown=node:node /app/prisma.config.ts ./prisma.config.ts
COPY --from=builder --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/apps/api/dist ./apps/api/dist
COPY --from=builder --chown=node:node /app/apps/api/package.json ./apps/api/package.json
COPY --from=builder --chown=node:node /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=builder --chown=node:node /app/packages ./packages

# Prisma client and schema needed at runtime
COPY --from=builder --chown=node:node /app/prisma ./prisma

# Chromium is installed by the very `playwright` package this image runs, so the
# browser revision cannot drift from the dependency — the failure mode a separate
# base-image pin used to have, where PDF export died at chromium.launch() while
# every suite stayed green.
RUN pnpm exec playwright install --with-deps chromium

# Create PDF storage directory
RUN mkdir -p /app/data/pdfs && chown node:node /app/data/pdfs
USER node
WORKDIR /app/apps/api
ENV NODE_ENV=production
# EXPOSE/HEALTHCHECK must match the runtime bind port (PORT=3001); a plain
# `docker run` with the baked healthcheck would otherwise report permanently
# unhealthy.
# Probe /health/ready (DB + Redis + BullMQ + memory) — the same endpoint the
# compose override targets — so a standalone `docker run` is checked as deeply
# as a compose-orchestrated container and cannot report healthy on liveness
# alone while unable to serve a query. start-period is 60s (matching compose)
# so the normal migrate + tRPC bootstrap window doesn't flap a standalone
# container through unhealthy before its dependencies are reachable.
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD wget -qO- http://localhost:3001/health/ready || exit 1
CMD ["node", "dist/apps/api/src/main.js"]
