# Stage 1: Base with pnpm, turbo, and Playwright browsers.
# Keep all API stages on the same glibc-based image so dev/prod PDF export
# can launch Chromium and native node modules are built for the runner OS.
FROM mcr.microsoft.com/playwright:v1.59.1-noble AS base
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN corepack enable && corepack prepare pnpm@10.11.0 --activate
RUN npm install -g turbo@2

# Stage 2: Prune monorepo for api workspace
FROM base AS pruner
WORKDIR /app
COPY . .
RUN turbo prune @customreport/api --docker

# Stage 3: Install deps + generate Prisma (devDeps intact — used for dev hot-reload)
FROM base AS installer
WORKDIR /app
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=pruner /app/out/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=pruner /app/out/json/ .
COPY prisma ./prisma
RUN pnpm install --frozen-lockfile
COPY --from=pruner /app/out/full/ .
COPY tsconfig.base.json ./tsconfig.base.json
COPY prisma.config.ts ./prisma.config.ts
RUN DATABASE_URL=postgresql://customreport:localdev@localhost:5432/customreport pnpm exec prisma generate

# Stage 4: Migration runner with Prisma CLI available.
# Compose/Kubernetes init jobs should use this target, not the production API
# runner, because migrations require the Prisma CLI from devDependencies.
FROM installer AS migrator
CMD ["pnpm", "exec", "prisma", "migrate", "deploy"]

# Stage 5: Build and prune devDeps for production
FROM installer AS builder
RUN pnpm turbo build --filter=@customreport/api
RUN pnpm prune --prod --config.ignore-scripts=true

# Stage 6: Production runner
# Use Playwright base image for PDF generation (Chromium pre-installed).
# NOTE: This image is ~1.4GB due to the Chromium dependency required for PDF export.
# The 200MB size target applies to the web image (alpine-based, ~150MB).
# The API image cannot meet 200MB due to Playwright/Chromium — this is an architectural constraint.
FROM base AS runner
WORKDIR /app

# Copy pruned monorepo structure with production deps only
COPY --from=builder --chown=pwuser:pwuser /app/package.json ./package.json
COPY --from=builder --chown=pwuser:pwuser /app/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=builder --chown=pwuser:pwuser /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=builder --chown=pwuser:pwuser /app/prisma.config.ts ./prisma.config.ts
COPY --from=builder --chown=pwuser:pwuser /app/node_modules ./node_modules
COPY --from=builder --chown=pwuser:pwuser /app/apps/api/dist ./apps/api/dist
COPY --from=builder --chown=pwuser:pwuser /app/apps/api/package.json ./apps/api/package.json
COPY --from=builder --chown=pwuser:pwuser /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=builder --chown=pwuser:pwuser /app/packages ./packages

# Prisma client and schema needed at runtime
COPY --from=builder --chown=pwuser:pwuser /app/prisma ./prisma

# Create PDF storage directory
RUN mkdir -p /app/data/pdfs && chown pwuser:pwuser /app/data/pdfs
USER pwuser
WORKDIR /app/apps/api
ENV NODE_ENV=production
EXPOSE 3002
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
  CMD wget -qO- http://localhost:3002/health/live || exit 1
CMD ["node", "dist/apps/api/src/main.js"]
