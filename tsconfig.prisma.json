{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2024"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    // Prisma seeds consume the server-only persistence package and the pure
    // shared contracts at runtime through the workspace install.
    "paths": {
      "@weeklyreport/report-persistence": [
        "./packages/report-persistence/src/index.ts"
      ],
      "@weeklyreport/shared": ["./packages/shared/src/index.ts"],
      "@weeklyreport/shared/*": ["./packages/shared/src/*"]
    }
  },
  "include": ["prisma/**/*.ts"]
}
