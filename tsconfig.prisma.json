{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // Prisma seeds consume the server-only persistence package and the pure
    // shared contracts at runtime through the workspace install.
    "paths": {
      "@customreport/report-persistence": [
        "./packages/report-persistence/src/index.ts"
      ],
      "@customreport/shared": ["./packages/shared/src/index.ts"],
      "@customreport/shared/*": ["./packages/shared/src/*"]
    }
  },
  "include": ["prisma/**/*.ts"]
}
