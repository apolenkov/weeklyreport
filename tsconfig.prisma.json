{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "experimentalDecorators": true,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      // luxon ships no bundled types; point the typecheck at its @types
      // declarations. Runtime resolution is tsx's job (it ignores these paths).
      "luxon": ["./apps/api/node_modules/@types/luxon"]
    }
  },
  "include": ["prisma/**/*.ts"]
}
