# Database
# DEV: both URLs point at the same Postgres instance.
# PROD (39-01): the api container's DATABASE_URL points at pgbouncer (transaction
#   mode), the migrate init-container's DATABASE_URL points at postgres directly
#   because DDL needs session-mode. See docker-compose.prod.yml for the wiring.
#   In Prisma 7 with the pg-pool adapter (apps/api/src/infrastructure/prisma/
#   prisma.service.ts), DATABASE_URL is read straight from process.env — no
#   schema-side `directUrl` needed. DIRECT_URL is reserved for any tooling
#   that wants a direct-connection escape hatch in dev.
DATABASE_URL=postgresql://user:pass@localhost:5432/customreport_dev
DIRECT_URL=postgresql://user:pass@localhost:5432/customreport_dev

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Optional CSV of additional CORS origins (Phase 36-04). Used in production
# when a single API instance serves multiple frontends (e.g. main + admin).
# Wildcards ("*") are rejected when NODE_ENV=production.
# FRONTEND_URLS=https://customreport.example.com,https://admin.customreport.example.com

# Auth — Production (Keycloak SAML)
# These four are REQUIRED when running with NODE_ENV=production.
# Phase 29-04 (AUTH-01) finalised the cut-over: production reads SAML from
# Keycloak only; dev-auth flags below are ignored entirely (and the API
# refuses to start if either is set under NODE_ENV=production — the
# `assertNoDevAuthInProduction` boot fence in apps/api/src/lib/dev-auth-fence.ts).
AUTH_JWT_SECRET=change-me-in-production-min-32-chars!!
KEYCLOAK_SAML_CALLBACK_URL=http://localhost:3001/auth/saml/callback
KEYCLOAK_SAML_ENTRY_POINT=http://localhost:8080/realms/dev/protocol/saml
KEYCLOAK_SAML_ISSUER=customreport-dev
KEYCLOAK_SAML_CERT=paste-keycloak-idp-certificate-here

# ---- Local-only test/dev switches (NEVER set in production) ----
# Honoured ONLY when NODE_ENV !== 'production'. The boot fence rejects either
# flag if NODE_ENV=production and refuses to start the API.
AUTH_DEV_MODE=true
# AUTH_DEV_MODE_ALLOW_TEST=true   # narrower staged switch (Phase 28-02 / 29-04)

# Logging
LOG_LEVEL=debug

# When set, the AppLogger writes JSON entries to ${LOG_DIR}/app.log
# alongside stdout/stderr. Path is resolved relative to apps/api (the
# API process cwd). Use `pnpm logs` / `pnpm logs:errors` from repo root
# to tail. Leave unset to disable file logging.
LOG_DIR=.logs

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# SMTP (email reminders)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# PDF generation
PDF_BASE_URL=http://localhost:3000

# PDF export — JWT signing key for short-lived (5min) cookies injected
# into the Playwright PDF worker. AUTH-05 / Phase 28-02. Phase 29 will
# share the same secret with the SAML JWT issuer.
PDF_EXPORT_JWT_SECRET=dev-only-replace-in-production-min-32-chars

# AUTH_DEV_MODE_ALLOW_TEST: Phase 28-02 staged switch.
# Phase 29-04 narrowed semantics: only honoured when NODE_ENV !== 'production'
# AND the boot fence has not refused startup. Used by the Playwright integration
# suite (apps/web/playwright.integration.config.ts) and the PDF cookie path.
AUTH_DEV_MODE_ALLOW_TEST=false

# Anthropic API
# Required for Phase 31 AI features (summary, sentiment, on-track). Use Anthropic Console key.
ANTHROPIC_API_KEY=

# OpenTelemetry (37-01). Leave OTEL_EXPORTER_OTLP_ENDPOINT unset to disable
# tracing entirely (default — no OTel SDK started, no spans emitted, zero
# overhead). Set to your collector's OTLP/HTTP endpoint — the SDK appends
# /v1/traces. Sampling ratio defaults to 0.1 (10% of requests traced) which
# matches the "low-overhead in prod" recommendation; set 1.0 in dev to see
# everything. OTEL_SDK_DISABLED=true is a hard kill switch overriding the
# endpoint.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SDK_DISABLED=false
# OTEL_TRACES_SAMPLER_ARG=0.1
# OTEL_SERVICE_NAME=customreport-api
# OTEL_SERVICE_VERSION=v8.0.0

# DEV role-switcher widget (apps/web/src/components/dev/role-switcher.tsx)
# When 'true', a floating bottom-right dropdown lets you switch between
# seed-simple identities (Head/Platanov/Maria/Igor/Admin/Viewer) without
# logging out. Only meaningful in conjunction with AUTH_DEV_MODE=true,
# because the switcher hits /auth/dev-login which itself only mounts in
# dev mode. Leave 'false' (or unset) in production.
NEXT_PUBLIC_DEV_ROLE_SWITCHER=false
