# Database
# Local product development uses the one exact disposable database accepted by
# the destructive guard. The bootstrap command creates it, applies migrations,
# and seeds an explicit profile; never repoint that command at weeklyreport_dev.
# Production has a separate fail-closed contract in
# `deploy/helm/weeklyreport/values.production.example.yaml`; do not reuse this
# local-development file there.
# In Prisma 7 with the pg-pool adapter, PrismaService receives the validated
# EnvConfig through Nest DI and uses its DATABASE_URL; do not add raw reads at
# call sites.
DATABASE_URL=postgresql://weeklyreport:localdev@localhost:5432/weeklyreport_e2e
E2E_DATABASE_URL=postgresql://weeklyreport:localdev@localhost:5432/weeklyreport_e2e

# pg connection-pool tuning (required; keeps capacity and timeout policy explicit).
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_POOL_CONNECTION_TIMEOUT_MS=0

# Server
PORT=3002
# Native API listens only on loopback.
API_HOST=127.0.0.1
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Base URL embedded in reminder email links. Required (no default); set to the
# web origin. In production this MUST be the public app URL, never localhost.
APP_BASE_URL=http://localhost:3000
# Native Web loads this root file through its package scripts. `API_URL` owns
# server-side rewrites and is never exposed as a browser configuration knob.
API_URL=http://localhost:3002
# Optional CSV of additional CORS origins, used in production when a single API
# instance serves multiple frontends (e.g. main + admin). Wildcards ("*") are
# rejected when NODE_ENV=production.
# FRONTEND_URLS=https://weeklyreport.example.com,https://admin.weeklyreport.example.com

# Auth — Production (Keycloak SAML)
# These five values are REQUIRED when running with NODE_ENV=production:
# AUTH_JWT_SECRET plus the four KEYCLOAK_SAML_* values below. Production reads
# SAML from Keycloak only. Dev-auth flags below are ignored unless enabled with
# the exact value `true`; the API refuses to start when either is `true` under
# NODE_ENV=production (`assertNoDevAuthInProduction`).
AUTH_JWT_SECRET=change-me-in-production-min-32-chars!!
KEYCLOAK_SAML_CALLBACK_URL=http://localhost:3002/auth/saml/callback
KEYCLOAK_SAML_ENTRY_POINT=http://localhost:8080/realms/dev/protocol/saml
KEYCLOAK_SAML_ISSUER=weeklyreport-dev
KEYCLOAK_SAML_CERT=paste-keycloak-idp-certificate-here

# ---- Local-only test/dev switches (NEVER set in production) ----
# Honoured ONLY when NODE_ENV !== 'production'. The boot fence rejects either
# flag when its value is `true` under NODE_ENV=production; false is inert.
AUTH_DEV_MODE=true
PRODUCT_FEEDBACK_ENABLED=false
# Optional local MCP credential; keep unset unless running `pnpm agentation:mcp`.
# AGENTATION_API_KEY=
# Optional opt-in AI provider seed (prisma/seed-ai-provider.ts, runs inside
# db:seed:profile). Set only to seed and enable a provider revision locally;
# then E2E_AI_PROVIDER_BASE_URL, E2E_AI_PROVIDER_MODEL,
# E2E_AI_PROVIDER_EMBEDDING_MODEL and E2E_AI_PROVIDER_EMBEDDING_DIMENSIONS are
# also required. Leave unset to keep the assistant disabled. Never commit a
# real key.
# E2E_AI_PROVIDER_API_KEY=
# AUTH_DEV_MODE_ALLOW_TEST=true   # narrower staged switch
# Repo-root override for dev.wipeAndReseed. Optional — the reseed path otherwise
# walks cwd/workspace guesses to find prisma/schema.prisma.
# WEEKLYREPORT_REPO_ROOT=/absolute/path/to/repo

# Logging
LOG_LEVEL=debug

# When set, the AppLogger writes JSON entries to ${LOG_DIR}/app.log
# alongside stdout/stderr. Path is resolved relative to apps/api (the
# API process cwd). Use `pnpm logs` / `pnpm logs:errors` from repo root
# to tail. Leave unset to disable file logging.
LOG_DIR=.logs

# Redis (BullMQ)
# Local scripts and the wr-dev Kubernetes dependencies (`pnpm deps:up`) use the
# same explicit host and port contract.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Redis memory cap in bytes (200mb). REQUIRED — no schema default. Must match the
# --maxmemory of the local Redis service; the DLQ monitor derives its
# 80%-of-cap memory alert from this value. Production Helm derives it from
# redis.maxmemoryMb.
REDIS_MAXMEMORY_BYTES=209715200
# DLQ alert threshold (DLQMonitorService). Optional — absent uses the service's
# named default (5). A set value must be a positive integer or boot fails loud.
# DLQ_ALERT_THRESHOLD=5

# AI provider control plane. The key must encode exactly 32 bytes (base64 or
# 64 hexadecimal characters). Provider credentials and models are configured
# by an administrator and stored as immutable database revisions.
AI_PROVIDER_CONFIG_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
AI_PROVIDER_CONFIG_KEY_VERSION=1
AI_PROVIDER_ALLOWED_ORIGINS=https://api.mistral.ai,https://openrouter.ai,https://api.groq.com,https://api.jina.ai,https://api.openai.com
REPORT_ASSISTANT_OUTBOUND_DATA_APPROVED=false

# Report-assistant deployment limits. These values bound retrieval and remote
# calls; they are not silent application defaults.
REPORT_ASSISTANT_INPUT_VERSION=1
REPORT_ASSISTANT_SIMILARITY_THRESHOLD=0.55
REPORT_ASSISTANT_CANDIDATE_LIMIT=500
REPORT_ASSISTANT_READ_THROUGH_LIMIT=16
REPORT_ASSISTANT_EXHAUSTIVE_LIMIT=200
REPORT_ASSISTANT_CONTEXT_TOKEN_BUDGET=8000
REPORT_ASSISTANT_PROVIDER_TIMEOUT_MS=30000
REPORT_ASSISTANT_PLANNER_MAX_TOKENS=1500
REPORT_ASSISTANT_ANSWER_MAX_TOKENS=2000
REPORT_ASSISTANT_EMBEDDING_BATCH_SIZE=32
REPORT_ASSISTANT_EMBEDDING_TOKEN_BUDGET=8000

# SMTP (email reminders)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# PDF generation. The renderer runs in the wr-dev cluster (`pnpm deps:up`) and
# opens the host-run web through the OrbStack alias `host.internal`; its
# allow-list in deploy/local-dev/deps.yaml accepts only that alias.
PDF_BASE_URL=http://host.internal:3000
# Internal Gotenberg render service. Required fail-closed (syntactic check
# only); renderer health stays a lazy signal, never a boot dependency.
GOTENBERG_URL=http://localhost:3010
# Directory the PDF worker writes to / the /pdfs mount serves. Required (no default).
PDF_OUTPUT_DIR=./storage/pdfs

# PDF export — JWT signing key for the short-lived (5min) render credential the
# worker hands to the internal Gotenberg renderer, scoped to the print origin.
PDF_EXPORT_JWT_SECRET=dev-only-replace-in-production-min-32-chars

# OpenTelemetry. Local runs have no collector: tracing stays off unless you
# point the endpoint at one.
# Set OTEL_EXPORTER_OTLP_ENDPOINT to activate tracing. Unset → SDK is a no-op
# (zero overhead). Set 1.0 in dev to capture every span; use 0.1 in prod.
# OTEL_SDK_DISABLED=true is a hard kill switch that overrides the endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SDK_DISABLED and OTEL_TRACES_SAMPLER_ARG are required (no defaults) so the
# telemetry posture is always explicit. The endpoint above stays optional — the
# SDK only starts when it is set AND OTEL_SDK_DISABLED is not 'true'.
OTEL_SDK_DISABLED=true
OTEL_TRACES_SAMPLER_ARG=1.0

# /health/ready heap threshold in bytes. Required (no default) — must be a
# positive integer. Calibrate to ~75% of the API memory budget (1536 MiB shown
# here for a 2 GiB cap; production uses chart api.resources.limits.memory).
HEAP_HEALTH_THRESHOLD_BYTES=1610612736
# OTEL_SERVICE_NAME=weeklyreport-api
# OTEL_SERVICE_VERSION=0.1.0

# External Sentry-compatible error tracking; schema owner:
# apps/api/src/infrastructure/config/env.schema.ts. Leave unset to disable.
# SENTRY_DSN=https://public-key@errors.example.com/project-id
# NEXT_PUBLIC_SENTRY_DSN=https://public-key@errors.example.com/project-id

# Web Vitals forwarding (explicit client build toggle)
NEXT_PUBLIC_WEB_VITALS=false
NEXT_PUBLIC_PRODUCT_FEEDBACK_ENABLED=false
NEXT_PUBLIC_PRODUCT_FEEDBACK_INBOX_ROLES=admin

# Forward browser console.error/warn to API log; owner:
# apps/web/src/shared/lib/telemetry/client-logger.ts
NEXT_PUBLIC_CLIENT_LOG_FORWARDING=true
# Server-side accept toggle for the /api/client-logs forwarder (main.ts);
# schema owner: apps/api/src/infrastructure/config/env.schema.ts.
# Explicit server-side accept toggle for the /api/client-logs forwarder.
CLIENT_LOG_FORWARDING=false

# DEV role-switcher widget (apps/web/src/shared/ui/auth-runtime/role-switcher.tsx)
# When 'true', a floating bottom-right dropdown lets you switch between
# seed-simple identities (Head/Lead 1/Maria/Igor/Admin/Viewer) without
# logging out. Only meaningful in conjunction with AUTH_DEV_MODE=true,
# because the switcher hits /auth/dev-login which itself only mounts in
# dev mode. Leave 'false' (or unset) in production.
NEXT_PUBLIC_DEV_ROLE_SWITCHER=false

# Production web build args are supplied by the CI build-images job.
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time and
# cannot be changed at runtime:
#   - NEXT_PUBLIC_AUTH_STUB=false         disables the dev-login picker (SSO only)
#   - NEXT_PUBLIC_DEV_ROLE_SWITCHER=false hides the dev role-switcher widget
#   - NEXT_PUBLIC_CLIENT_LOG_FORWARDING  explicit browser log-forwarding toggle
#   - NEXT_PUBLIC_WEB_VITALS              explicit browser Web Vitals toggle
# API_URL is server-only (server-side requireApiUrl): required for native
# development. CI and the Helm chart own the same fixed internal
# `http://api:3001` value for the production Next build and runtime.

# Build version string injected by CI (e.g. git describe --tags --abbrev=0).
# Displayed in login page footer. Leave empty for local dev.
NEXT_PUBLIC_APP_VERSION=

# The local wr-dev PostgreSQL (deploy/local-dev/deps.yaml) uses this exact
# disposable database target.
POSTGRES_DB=weeklyreport_e2e
