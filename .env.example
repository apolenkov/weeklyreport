# Database
# DEV: both URLs point at the same Postgres instance.
# Non-prod database names in DATABASE_URL / DIRECT_URL must end with _uat,
# _dev, or _test when the host is not truly local; prisma/_destructive-guard.ts
# parses DATABASE_URL before wipe/reset scripts run.
# PROD (39-01): the api container's DATABASE_URL points at pgbouncer (transaction
#   mode), the migrate init-container's DATABASE_URL points at postgres directly
#   because DDL needs session-mode. See docker-compose.prod.yml for the wiring.
#   In Prisma 7 with the pg-pool adapter (apps/api/src/infrastructure/prisma/
#   prisma.service.ts), DATABASE_URL is read straight from process.env — no
#   schema-side `directUrl` needed. DIRECT_URL is reserved for any tooling
#   that wants a direct-connection escape hatch in dev.
DATABASE_URL=postgresql://user:pass@localhost:5432/customreport_dev
DIRECT_URL=postgresql://user:pass@localhost:5432/customreport_dev

# pg connection-pool tuning (optional — PrismaService applies these defaults
# when unset). A value that IS set must be a whole number in range, or boot
# fails loud. Keep DB_POOL_MAX below the DB server's max_connections minus the
# connections used by other services (migrate job, pgbouncer, tooling).
# DB_POOL_MAX=10                      # max pooled connections (>= 1)
# DB_POOL_IDLE_TIMEOUT_MS=10000       # idle client eviction, ms (>= 0)
# DB_POOL_CONNECTION_TIMEOUT_MS=0     # acquire-from-pool timeout, ms; 0 = disabled

# Server
PORT=3002
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Base URL embedded in reminder email links. Required (no default); set to the
# web origin. In production this MUST be the public app URL, never localhost.
APP_BASE_URL=http://localhost:3000
# Optional CSV of additional CORS origins (Phase 36-04). Used in production
# when a single API instance serves multiple frontends (e.g. main + admin).
# Wildcards ("*") are rejected when NODE_ENV=production.
# FRONTEND_URLS=https://customreport.example.com,https://admin.customreport.example.com

# Auth — Production (Keycloak SAML)
# These four are REQUIRED when running with NODE_ENV=production.
# Phase 29-04 (AUTH-01) finalised the cut-over: production reads SAML from
# Keycloak only; dev-auth flags below are ignored entirely (and the API
# refuses to start if either is set under NODE_ENV=production — the
# `assertNoDevAuthInProduction` boot fence in apps/api/src/lib/dev-auth-fence.ts).
AUTH_JWT_SECRET=change-me-in-production-min-32-chars!!
# Session-cookie name. Optional — resolveSessionCookieName applies its named
# default (customreport_session) when unset. Override only to avoid a cookie
# clash when several apps share one host.
# AUTH_JWT_COOKIE_NAME=customreport_session
KEYCLOAK_SAML_CALLBACK_URL=http://localhost:3002/auth/saml/callback
KEYCLOAK_SAML_ENTRY_POINT=http://localhost:8080/realms/dev/protocol/saml
KEYCLOAK_SAML_ISSUER=customreport-dev
KEYCLOAK_SAML_CERT=paste-keycloak-idp-certificate-here

# ---- Local-only test/dev switches (NEVER set in production) ----
# Honoured ONLY when NODE_ENV !== 'production'. The boot fence rejects either
# flag if NODE_ENV=production and refuses to start the API.
AUTH_DEV_MODE=true
# AUTH_DEV_MODE_ALLOW_TEST=true   # narrower staged switch (Phase 28-02 / 29-04)
# Repo-root override for dev.wipeAndReseed. Optional — the reseed path otherwise
# walks cwd/workspace guesses to find prisma/schema.prisma.
# CUSTOMREPORT_REPO_ROOT=/absolute/path/to/repo

# Logging
LOG_LEVEL=debug

# When set, the AppLogger writes JSON entries to ${LOG_DIR}/app.log
# alongside stdout/stderr. Path is resolved relative to apps/api (the
# API process cwd). Use `pnpm logs` / `pnpm logs:errors` from repo root
# to tail. Leave unset to disable file logging.
LOG_DIR=.logs

# Redis (BullMQ)
# Local scripts and Compose both use REDIS_HOST / REDIS_PORT. REDIS_URL is
# accepted by reset scripts as a compatibility override, but is not required.
REDIS_HOST=localhost
REDIS_PORT=6379
# DLQ alert threshold (DLQMonitorService). Optional — absent uses the service's
# named default (5). A set value must be a positive integer or boot fails loud.
# DLQ_ALERT_THRESHOLD=5

# SMTP (email reminders)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# PDF generation
PDF_BASE_URL=http://localhost:3000
# Directory the PDF worker writes to / the /pdfs mount serves. Required (no default).
PDF_OUTPUT_DIR=./storage/pdfs

# PDF export — JWT signing key for short-lived (5min) cookies injected
# into the Playwright PDF worker. AUTH-05 / Phase 28-02. Phase 29 will
# share the same secret with the SAML JWT issuer.
PDF_EXPORT_JWT_SECRET=dev-only-replace-in-production-min-32-chars

# AUTH_DEV_MODE_ALLOW_TEST: Phase 28-02 staged switch.
# Phase 29-04 narrowed semantics: only honoured when NODE_ENV !== 'production'
# AND the boot fence has not refused startup. Used by the Playwright integration
# suite (apps/web/playwright.integration.config.ts) and the PDF cookie path.
AUTH_DEV_MODE_ALLOW_TEST=false

# Telegram bot token for Phase 55 (notification delivery).
# Empty / unset → MockTelegramAdapter (stores payload in-process for admin smoke tests).
# Non-empty → throws at boot (real adapter not yet implemented; see
# TODO(Phase-55-activation) in apps/api/src/modules/telegram/telegram.module.ts).
# Set to the BotFather-issued token when activating the real bot.
TG_BOT_TOKEN=

# OpenTelemetry (37-01 / Phase 68). Set OTEL_EXPORTER_OTLP_ENDPOINT to activate
# tracing. Unset → SDK is a no-op (zero overhead). The otel-lgtm service in
# docker-compose.observability.yml receives on :4318 (OTLP/HTTP). Set 1.0 in
# dev to capture every span; use 0.1 in prod. OTEL_SDK_DISABLED=true is a
# hard kill switch that overrides the endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4318
# OTEL_SDK_DISABLED and OTEL_TRACES_SAMPLER_ARG are required (no defaults) so the
# telemetry posture is always explicit. The endpoint above stays optional — the
# SDK only starts when it is set AND OTEL_SDK_DISABLED is not 'true'.
OTEL_SDK_DISABLED=false
OTEL_TRACES_SAMPLER_ARG=1.0

# /health/ready heap threshold in bytes. Required (no default) — must be a
# positive integer. Calibrate to ~75% of the container memory limit set in
# docker-compose.prod.yml (1536 MiB shown here for the 2 GiB api cap).
HEAP_HEALTH_THRESHOLD_BYTES=1610612736
# Native (non-Docker) sweep API: the hostname above only resolves inside
# Compose. For the AI-UI-Driver sweep run (e2e/sweep/driver/README.md),
# set OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318 in your shell
# before starting the sweep API, or the collector marks Loki "blind".
# OTEL_TRACES_SAMPLER_ARG=1.0
# OTEL_SERVICE_NAME=customreport-api
# OTEL_SERVICE_VERSION=v8.0.0

# Phase 68 — Error tracking via Bugsink (Sentry-compatible)
# Start Bugsink: pnpm observability:up (or docker compose -f docker-compose.errors.yml up -d)
# Then: http://localhost:8000 → create project → copy DSN here
# SENTRY_DSN=http://key@localhost:8000/1
# NEXT_PUBLIC_SENTRY_DSN=http://key@localhost:8000/1
# Docker containers cannot reach localhost — use host.docker.internal:
# SENTRY_DSN_DOCKER=http://key@host.docker.internal:8000/1
# NEXT_PUBLIC_SENTRY_DSN_DOCKER=http://key@host.docker.internal:8000/1
# BUGSINK_SECRET_KEY=localdev-insecure-key-change-in-prod
# BUGSINK_PORT=8000

# Phase 68 — Web Vitals forwarding (opt-in via NEXT_PUBLIC_WEB_VITALS=true in dev)
# NEXT_PUBLIC_WEB_VITALS=true

# Phase 68 — Forward browser console.error/warn to API log (apps/web/src/lib/client-logger.ts)
NEXT_PUBLIC_CLIENT_LOG_FORWARDING=true
# Server-side accept toggle for the /api/client-logs forwarder (main.ts).
# Optional — dev accepts via NODE_ENV=development; set "true" to opt in on prod.
# CLIENT_LOG_FORWARDING=true

# DEV role-switcher widget (apps/web/src/components/dev/role-switcher.tsx)
# When 'true', a floating bottom-right dropdown lets you switch between
# seed-simple identities (Head/Lead 1/Maria/Igor/Admin/Viewer) without
# logging out. Only meaningful in conjunction with AUTH_DEV_MODE=true,
# because the switcher hits /auth/dev-login which itself only mounts in
# dev mode. Leave 'false' (or unset) in production.
NEXT_PUBLIC_DEV_ROLE_SWITCHER=false

# Production web build args (docker-compose.prod.yml `web.build.args`).
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time and
# cannot be changed at runtime:
#   - NEXT_PUBLIC_AUTH_STUB=false         disables the dev-login picker (SSO only)
#   - NEXT_PUBLIC_DEV_ROLE_SWITCHER=false hides the dev role-switcher widget
#   - NEXT_PUBLIC_API_URL                 required public API origin, no default
#                                         (the prod build fails fast if unset)
# API_URL is a runtime-only knob (server-side requireApiUrl): REQUIRED, no
# default — the server fails loud when neither API_URL nor NEXT_PUBLIC_API_URL
# is set. It is NOT a build input — the rewrite origin is baked as the fixed
# literal http://api:3001 in the prod build args above.

# UFB-061: Build version string injected by CI (e.g. git describe --tags --abbrev=0).
# Displayed in login page footer. Leave empty for local dev.
NEXT_PUBLIC_APP_VERSION=
