{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "1 day",
  "rangeStrategy": "update-lockfile",
  "pinDigests": true,
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "One weekly MR for all minor and patch updates",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "groupName": "minor and patch updates"
    },
    {
      "description": "Major updates stay separate and are reviewed one by one",
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "major"]
    },
    {
      "description": "CI service images stay on the runner-cached digests (new digests time out on pull); bump only with a runner cache refresh",
      "matchFileNames": [".gitlab-ci.yml"],
      "matchPackageNames": ["redis", "axllent/mailpit"],
      "enabled": false
    }
  ]
}
