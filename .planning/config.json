{
  "runtime": "codex",
  "model_profile": "balanced",
  "model_profile_overrides": {
    "codex": {
      "opus": "gpt-5.5",
      "sonnet": "gpt-5.3-codex",
      "haiku": "gpt-5.4-mini"
    }
  },
  "dynamic_routing": {
    "tier_models": {
      "heavy": "opus",
      "standard": "sonnet",
      "light": "haiku"
    }
  },
  "commit_docs": false,
  "search_gitignored": false,
  "branching_strategy": "none",
  "phase_branch_template": "feat/phase-{phase}",
  "milestone_branch_template": "feat/{milestone}",
  "quick_branch_template": "fix/{slug}",
  "workflow": {
    "research": true,
    "plan_check": true,
    "code_review": true,
    "ui_review": true,
    "verifier": true,
    "nyquist_validation": true
  },
  "graphify": {
    "enabled": true
  },
  "parallelization": 1,
  "brave_search": false
}
