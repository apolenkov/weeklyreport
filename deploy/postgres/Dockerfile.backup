FROM postgres:15.19-alpine@sha256:fe0737ba566a2c5b2a28f34433c0a423261900ec17b9bf7ad115e1aae7e57f1b
ARG BUILD_VERSION
LABEL org.opencontainers.image.revision=${BUILD_VERSION}

# Keep the recovery entrypoints inside the image so a running backup job cannot
# drift from the reviewed repository state through a host bind mount.
COPY backup-loop.sh backup-health.sh restore.sh /usr/local/bin/
RUN chmod 0555 /usr/local/bin/backup-loop.sh \
    /usr/local/bin/backup-health.sh \
    /usr/local/bin/restore.sh
