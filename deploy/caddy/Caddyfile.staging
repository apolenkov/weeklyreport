################################################################################
# CustomReport — staging / local-CA reverse-proxy
#
# Use this Caddyfile when:
#   - the deploy domain isn't publicly resolvable (Let's Encrypt would fail)
#   - you've hit Let's Encrypt rate limits in staging
#   - you need to test inside an air-gapped network
#
# Mount this file in place of deploy/caddy/Caddyfile:
#   docker compose -f docker-compose.prod.yml run --rm \
#     -v $(pwd)/deploy/caddy/Caddyfile.staging:/etc/caddy/Caddyfile:ro \
#     caddy ...
#
# Or override CADDY_FILE in your .env to point at this path.
################################################################################
{
	# Caddy's internal CA: self-signed root cert installed automatically in
	# caddy_data volume. Trust it on the client by importing the root from
	#   docker compose -f docker-compose.prod.yml exec caddy \
	#     cat /data/caddy/pki/authorities/local/root.crt
}

{$CADDY_SITE_ADDRESS} {
	tls internal

	encode zstd gzip

	# /metrics is intentionally absent: it must not be reachable from the public
	# edge. Prometheus scrapes it over the internal compose network (api:3001).
	@api {
		# Only the API-OWNED /api prefixes route here: a blanket /api/* would
	# steal Next.js-only route handlers (e.g. /api/revalidate-org runs
	# revalidatePath inside the web container and has no backend twin).
	path /api/web-vitals /api/web-vitals/* /api/client-logs /api/client-logs/* /trpc /trpc/* /auth /auth/* /health /health/* /admin/queues /admin/queues/* /pdfs /pdfs/*
	}
	handle @api {
		reverse_proxy api:3001 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			transport http {
				read_timeout 5m
				write_timeout 5m
			}
		}
	}

	handle {
		reverse_proxy web:3000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# Lock down where browsers may load resources from (relax if /reports
		# embeds external imagery — currently same-origin only). Enforcing, and
		# byte-identical to production apart from the report target: staging
		# exists to catch what production would block, which a Report-Only
		# header cannot do. The required in-browser validation now runs as a
		# gate — `pnpm test:e2e:csp` walks every catalog route per role against
		# production bundles under this exact policy.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'"
		-Server
	}

	log {
		output stdout
		format json
	}
}
