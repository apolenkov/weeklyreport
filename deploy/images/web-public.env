# Production Next.js build-time public arguments for web image.
# Owner decision 2026-10-28 (TASK-709 via coordinator):
# Fixed repository defaults for local image building:
# - Client log forwarding disabled in production default.
# - Web vitals disabled in production default.
# - Product feedback disabled in production (docs/operations.md: keep false in production).
# - Feedback inbox roles set to ADMIN.
WR_NEXT_PUBLIC_CLIENT_LOG_FORWARDING=false
WR_NEXT_PUBLIC_WEB_VITALS=false
WR_NEXT_PUBLIC_PRODUCT_FEEDBACK_ENABLED=false
WR_NEXT_PUBLIC_PRODUCT_FEEDBACK_INBOX_ROLES=admin
