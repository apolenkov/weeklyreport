# WeeklyReport production Compose contract.
# Copy to .env.production outside Git and fill every required empty value.
# An unedited copy is deliberately rejected by Compose or the API at boot.
# This file intentionally contains no usable credentials or certificates.

# Database and pooler
# DB_PASSWORD must use only URL-safe unreserved characters (A-Z a-z 0-9 . - _ ~).
DB_PASSWORD=
# Letters, digits, and underscores only; example shape: customreport_production
POSTGRES_DB=
# API pg.Pool policy; all values are required to keep capacity explicit.
DB_POOL_MAX=
DB_POOL_IDLE_TIMEOUT_MS=
DB_POOL_CONNECTION_TIMEOUT_MS=
# Examples: 100, 20, 5
PGBOUNCER_MAX_CLIENT_CONN=
PGBOUNCER_POOL_SIZE=
PGBOUNCER_RESERVE_POOL_SIZE=
# Public and internal origins
FRONTEND_URL=
APP_BASE_URL=
PDF_BASE_URL=
NEXT_PUBLIC_CLIENT_LOG_FORWARDING=false
NEXT_PUBLIC_WEB_VITALS=false
NEXT_PUBLIC_PRODUCT_FEEDBACK_ENABLED=false
NEXT_PUBLIC_PRODUCT_FEEDBACK_INBOX_ROLES=admin
PRODUCT_FEEDBACK_ENABLED=false

# Authentication (use two distinct generated values, at least 32 characters)
# Generate two distinct values, each at least 32 characters.
AUTH_JWT_SECRET=
PDF_EXPORT_JWT_SECRET=
KEYCLOAK_SAML_CALLBACK_URL=
KEYCLOAK_SAML_ENTRY_POINT=
KEYCLOAK_SAML_ISSUER=
KEYCLOAK_SAML_CERT=

# Runtime policy
REDIS_DB=0
LOG_LEVEL=info
OTEL_SDK_DISABLED=true
OTEL_TRACES_SAMPLER_ARG=0.1
# Exact deployed release (for example a Git SHA).
OTEL_SERVICE_VERSION=
# Example for a 2 GiB API limit: 1610612736
HEAP_HEALTH_THRESHOLD_BYTES=

# AI provider control plane. Generate a 32-byte key and encode it as base64 or
# 64 hexadecimal characters. The current MVP supports one active key only:
# do not change this key or raise its version while encrypted credentials are
# retained. Existing credentials then cannot be decrypted; recovery requires
# restoring this exact key/version pair or re-entering every provider credential.
AI_PROVIDER_CONFIG_ENCRYPTION_KEY=
AI_PROVIDER_CONFIG_KEY_VERSION=1
AI_PROVIDER_ALLOWED_ORIGINS=https://api.mistral.ai,https://openrouter.ai,https://api.groq.com,https://api.jina.ai,https://api.openai.com
# Production Compose requires this explicit owner decision. Keep false until
# report-derived content is approved for every configured provider endpoint.
REPORT_ASSISTANT_OUTBOUND_DATA_APPROVED=false

# Bounded report-assistant runtime policy.
REPORT_ASSISTANT_INPUT_VERSION=1
REPORT_ASSISTANT_SIMILARITY_THRESHOLD=0.55
REPORT_ASSISTANT_CANDIDATE_LIMIT=500
REPORT_ASSISTANT_READ_THROUGH_LIMIT=16
REPORT_ASSISTANT_EXHAUSTIVE_LIMIT=200
REPORT_ASSISTANT_CONTEXT_TOKEN_BUDGET=8000
REPORT_ASSISTANT_PROVIDER_TIMEOUT_MS=30000
REPORT_ASSISTANT_PLANNER_MAX_TOKENS=1500
REPORT_ASSISTANT_ANSWER_MAX_TOKENS=2000
REPORT_ASSISTANT_EMBEDDING_BATCH_SIZE=32
REPORT_ASSISTANT_EMBEDDING_TOKEN_BUDGET=8000

# Reminder delivery
SMTP_HOST=
# Example: 587
SMTP_PORT=
SMTP_FROM=
# SMTP_USER=
# SMTP_PASS=

# Recovery policy (these values define the RPO and retention window)
# Examples: 3600 and 14
BACKUP_INTERVAL_SECONDS=
BACKUP_RETENTION_DAYS=

# Required operator secret when docker-compose.observability.yml is composed.
GRAFANA_ADMIN_PASSWORD=

# Caddy edge
# Examples: reports.example.com, ops@example.com, and an external CSP collector.
CADDY_SITE_ADDRESS=
CADDY_ACME_EMAIL=
CADDY_CSP_REPORT_URI=
HTTP_PORT=80
HTTPS_PORT=443
HTTPS_PORT_QUIC=443

# Optional production integrations
# FRONTEND_URLS=https://REPLACE_WITH_SECONDARY_ALLOWED_ORIGIN
# OTEL_EXPORTER_OTLP_ENDPOINT=https://REPLACE_WITH_OTLP_COLLECTOR
# SENTRY_DSN=https://REPLACE_WITH_SENTRY_DSN
# Browser DSN is compiled into the Web image; set it before `up --build`.
# NEXT_PUBLIC_SENTRY_DSN=https://REPLACE_WITH_BROWSER_SENTRY_DSN
CLIENT_LOG_FORWARDING=false
