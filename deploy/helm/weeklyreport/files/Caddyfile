################################################################################
# CustomReport — production reverse-proxy
#
# Auto-HTTPS via Let's Encrypt when CADDY_SITE_ADDRESS resolves publicly.
# The Helm chart serves plain HTTP (http://:8080) behind the cluster Ingress.
#
# Routes:
#   /api/web-vitals*, /api/client-logs*, /trpc/*, /auth/*, /health/*,
#   /admin/queues*, /pdfs/*                                        -> api:3001
#   (other /api/* stay on web:3000 — Next.js route handlers own them)
#   (/metrics is deliberately NOT routed at the public edge — see @api below)
#   /                                                              -> web:3000
#
################################################################################
{
	# Account email from edge values; cluster Ingress owns production TLS.
	email {$CADDY_ACME_EMAIL}

	# Client address behind a proxy: CADDY_TRUSTED_PROXIES is a space-separated
	# CIDR list (the Helm chart sets it to the cluster Ingress). An empty list
	# trusts nobody, so {client_ip} is the peer address. Strict mode walks
	# X-Forwarded-For right to left and stops at the first untrusted address;
	# without it Caddy takes the left-most one, which a client can forge even
	# through a trusted peer.
	servers {
		trusted_proxies static {$CADDY_TRUSTED_PROXIES}
		trusted_proxies_strict
	}
}

{$CADDY_SITE_ADDRESS} {
	encode zstd gzip

	# API surface — order matters: caddy matches the first @block that wins.
	# /metrics is intentionally absent: it must not be reachable from the public
	# edge. Prometheus scrapes it over the internal cluster network (api:3001).
	@api {
		# Only the API-OWNED /api prefixes route here: a blanket /api/* would
	# steal Next.js-only route handlers (e.g. /api/revalidate-org runs
	# revalidatePath inside the web container and has no backend twin).
	path /api/web-vitals /api/web-vitals/* /api/client-logs /api/client-logs/* /trpc /trpc/* /auth /auth/* /health /health/* /admin/queues /admin/queues/* /pdfs /pdfs/*
	}
	handle @api {
		reverse_proxy api:3001 {
			header_up Host {host}
			header_up X-Real-IP {client_ip}
			header_up X-Forwarded-For {client_ip}
			header_up X-Forwarded-Proto {scheme}
			transport http {
				read_timeout 5m
				write_timeout 5m
			}
		}
	}

	# Keep the API's Prometheus endpoint off the public edge. This explicit
	# handler must precede the catch-all web handler below.
	@metrics path /metrics /metrics/*
	handle @metrics {
		respond "Not Found" 404
	}

	# Default: Next.js frontend.
	handle {
		reverse_proxy web:3000 {
			header_up Host {host}
			header_up X-Real-IP {client_ip}
			header_up X-Forwarded-For {client_ip}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Security headers. Helmet on the api duplicates some of these on the
	# /api responses; adding them at the edge covers the web side too.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# Lock down where browsers may load resources from (relax if /reports
		# embeds external imagery — currently same-origin only). Enforcing, not
		# report-only: the directive set is same-origin and matches what the app
		# already serves, so blocking cannot regress a legitimate surface. Every
		# violation is still POSTed to the operator-supplied collector
		# (CADDY_CSP_REPORT_URI) so a genuine break stays observable after the flip.
		# script-src carries 'unsafe-inline' deliberately: Next.js App Router
		# emits inline Flight/bootstrap scripts and Caddy cannot thread a
		# per-render nonce, so without it every page fails to hydrate the
		# moment the policy enforces. Foreign SCRIPT ORIGINS stay blocked —
		# that is the floor this header buys. Fonts are emitted as same-origin
		# build assets by next/font.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; report-uri {$CADDY_CSP_REPORT_URI}"
		-Server
	}

	log {
		output stdout
		format json
	}
}
