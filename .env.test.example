# Integration test database — MUST be different from DATABASE_URL.
# Tests will TRUNCATE this database before each run.
E2E_DATABASE_URL=postgresql://user:pass@localhost:5432/customreport_e2e

# Redis — REQUIRED. The api reads these via requireEnv with no in-code
# fallback; the api integration suite (vitest.integration.config.ts loads
# this file's real counterpart .env.test) hits the docker instance.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_MAXMEMORY_BYTES=209715200

# Native Lead report assistant — deterministic test configuration. The key is
# deliberately non-secret because automated tests never contact Mistral.
AI_PROVIDER_CONFIG_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
AI_PROVIDER_CONFIG_KEY_VERSION=1
AI_PROVIDER_ALLOWED_ORIGINS=https://api.mistral.ai,https://openrouter.ai,https://api.groq.com,https://api.jina.ai,https://ai.example.com
MISTRAL_API_KEY=test-only-placeholder
MISTRAL_PLANNER_MODEL=mistral-medium-3-5
MISTRAL_ANSWER_MODEL=mistral-medium-3-5
MISTRAL_EMBEDDING_MODEL=mistral-embed
MISTRAL_EMBEDDING_DIMENSIONS=1024
MISTRAL_API_SERVER=eu
REPORT_ASSISTANT_INPUT_VERSION=1
REPORT_ASSISTANT_SIMILARITY_THRESHOLD=0.55
REPORT_ASSISTANT_CANDIDATE_LIMIT=500
REPORT_ASSISTANT_READ_THROUGH_LIMIT=16
REPORT_ASSISTANT_EXHAUSTIVE_LIMIT=200
REPORT_ASSISTANT_CONTEXT_TOKEN_BUDGET=8000
REPORT_ASSISTANT_PROVIDER_TIMEOUT_MS=30000
REPORT_ASSISTANT_PLANNER_MAX_TOKENS=1500
REPORT_ASSISTANT_ANSWER_MAX_TOKENS=2000
REPORT_ASSISTANT_EMBEDDING_BATCH_SIZE=32
REPORT_ASSISTANT_EMBEDDING_TOKEN_BUDGET=8000

# Web API origin — REQUIRED by the web server helpers (requireApiUrl, no
# in-code fallback). The web unit suite stubs it per-test; integration runs
# read it from here.
NEXT_PUBLIC_API_URL=http://localhost:3002

# pg connection-pool tuning (optional — PrismaService applies these defaults
# when unset). A value that IS set must be a whole number in range, or boot
# fails loud.
# DB_POOL_MAX=10                      # max pooled connections (>= 1)
# DB_POOL_IDLE_TIMEOUT_MS=10000       # idle client eviction, ms (>= 0)
# DB_POOL_CONNECTION_TIMEOUT_MS=0     # acquire-from-pool timeout, ms; 0 = disabled

# Optional port overrides (defaults: 3002 / 3005)
# E2E_API_PORT=3102
# E2E_WEB_PORT=3105

# Optional BullMQ namespace for integration API queues. By default the
# Playwright config generates a unique prefix per run so local docker workers
# cannot consume test jobs.
# E2E_BULLMQ_PREFIX=customreport-e2e-local

# Optional — gates the pdf-export integration spec (requires Redis + worker)
# E2E_PDF_ENABLED=true
