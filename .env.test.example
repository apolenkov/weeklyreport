# Guarded disposable E2E target for integration tests. Tests TRUNCATE this database
# before each case. Supply the actual local DATABASE_URL in the process environment;
# it must identify the same loopback database and port as E2E_DATABASE_URL.
# This example carries only E2E_DATABASE_URL; it does not replace the actual
# local target or grant the per-operation consent required by the cleanup guard.
# MVP single-database policy (owner decision 2026-09-18, see AGENTS.md): local dev,
# tests, and E2E runs all share the one customreport_e2e database on loopback.
# Lane targets stay guard-permitted but are not provisioned and must not be
# created without a new owner order. Every phase reset wipes this database;
# run a guarded reset plus the explicit required seed under per-run consent
# before each test/E2E phase so phases never inherit each other's state.
E2E_DATABASE_URL=postgresql://user:pass@localhost:5432/customreport_e2e
API_HOST=127.0.0.1

# Redis — REQUIRED. The api reads these via requireEnv with no in-code
# fallback; the api integration suite (vitest.integration.config.ts loads
# this file's real counterpart .env.test) hits the docker instance.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=15
REDIS_MAXMEMORY_BYTES=209715200

# Deterministic report-assistant test policy. Automated tests do not contact a
# provider unless a targeted integration test supplies an explicit adapter.
AI_PROVIDER_CONFIG_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
AI_PROVIDER_CONFIG_KEY_VERSION=1
AI_PROVIDER_ALLOWED_ORIGINS=https://api.mistral.ai,https://openrouter.ai,https://api.groq.com,https://api.jina.ai,https://api.openai.com
REPORT_ASSISTANT_OUTBOUND_DATA_APPROVED=false
REPORT_ASSISTANT_INPUT_VERSION=1
REPORT_ASSISTANT_SIMILARITY_THRESHOLD=0.55
REPORT_ASSISTANT_CANDIDATE_LIMIT=500
REPORT_ASSISTANT_READ_THROUGH_LIMIT=16
REPORT_ASSISTANT_EXHAUSTIVE_LIMIT=200
REPORT_ASSISTANT_CONTEXT_TOKEN_BUDGET=8000
REPORT_ASSISTANT_PROVIDER_TIMEOUT_MS=30000
REPORT_ASSISTANT_PLANNER_MAX_TOKENS=1500
REPORT_ASSISTANT_ANSWER_MAX_TOKENS=2000
REPORT_ASSISTANT_EMBEDDING_BATCH_SIZE=32
REPORT_ASSISTANT_EMBEDDING_TOKEN_BUDGET=8000

# Opt-in dev/e2e AI provider seed (prisma/seed-ai-provider.ts, runs inside
# db:seed:profile). When this untracked key is set, the seed creates and
# enables one provider revision; unset keeps the assistant disabled. Setting
# it also requires E2E_AI_PROVIDER_BASE_URL (origin must be allowlisted via
# AI_PROVIDER_ALLOWED_ORIGINS), E2E_AI_PROVIDER_MODEL,
# E2E_AI_PROVIDER_EMBEDDING_MODEL and E2E_AI_PROVIDER_EMBEDDING_DIMENSIONS.
# Never commit a real key.
E2E_AI_PROVIDER_API_KEY=

# pg connection-pool tuning (required; keeps capacity and timeout policy explicit).
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_POOL_CONNECTION_TIMEOUT_MS=0
PRODUCT_FEEDBACK_ENABLED=false
NEXT_PUBLIC_PRODUCT_FEEDBACK_ENABLED=false
NEXT_PUBLIC_PRODUCT_FEEDBACK_INBOX_ROLES=admin

# Internal Gotenberg render service — required fail-closed API config. The
# cluster-internal hostname is unavailable to host-source dev and to the
# integration lane (this file feeds vitest.integration.config.ts, which does
# not load test-env.setup.ts); syntactic validation only, no reachability.
GOTENBERG_URL=http://gotenberg:3000
