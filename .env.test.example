# Integration test database — MUST be different from DATABASE_URL.
# Tests will TRUNCATE this database before each run.
E2E_DATABASE_URL=postgresql://user:pass@localhost:5432/customreport_e2e

# Optional port overrides (defaults: 3002 / 3005)
# E2E_API_PORT=3002
# E2E_WEB_PORT=3005

# Optional — gates the pdf-export integration spec (requires Redis + worker)
# E2E_PDF_ENABLED=true
