{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "../.."
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.integration.test.ts",
    "**/*.spec.ts",
    "**/__tests__/**",
    "**/test-utils/**",
    "**/*.fixture.ts",
    "**/*.fixtures.ts",
    "**/*-fixtures.ts",
    "**/*stub*.ts",
    "**/*harness*.ts",
    "**/test-seams/**"
  ]
}
