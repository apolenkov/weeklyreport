{
  "name": "@weeklyreport/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --clear-screen=false --exclude '../../node_modules/**' --exclude 'node_modules/**' --exclude '.logs/**' --exclude 'storage/**' --include '../../packages/report-persistence/src/**' --include '../../packages/shared/src/**' src/main.ts",
    "build": "rm -rf dist && tsc6 -p tsconfig.production.json && tsx scripts/fix-esm-extensions.ts && tsx ../../scripts/gates/production-dist.ts --api",
    "typecheck": "tsc6 --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "NODE_OPTIONS=--throw-deprecation vitest run --config vitest.coverage.config.ts --coverage --fileParallelism=false",
    "test:integration": "NODE_OPTIONS=--throw-deprecation vitest run --config vitest.integration.config.ts --fileParallelism=false",
    "db:generate": "prisma generate --schema=../../prisma/schema.prisma",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@bull-board/api": "^9.10.4",
    "@bull-board/express": "^9.10.4",
    "@weeklyreport/report-persistence": "workspace:*",
    "@weeklyreport/shared": "workspace:*",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@node-saml/passport-saml": "^5.1.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation-express": "^0.71.1",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/instrumentation": "^7.10.1",
    "@prometheus-io/client": "0.16.1",
    "@sentry/nestjs": "11.6.0",
    "@sentry/opentelemetry": "11.6.0",
    "@trpc/server": "catalog:",
    "bullmq": "6.3.16",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "catalog:",
    "nestjs-cls": "^7.0.1",
    "nodemailer": "^10.2.1",
    "passport": "^0.7.0",
    "pg": "^8.23.1",
    "rate-limit-redis": "^6.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "superjson": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@weeklyreport/migrator-runtime": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nestjs/testing": "^12.1.3",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "@types/passport": "^1.0.17",
    "@types/pg": "^8.23.1",
    "fast-check": "4.10.2",
    "samlify": "^2.13.1",
    "tsx": "catalog:"
  }
}
