{
  "name": "@customreport/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/main.ts",
    "build": "rm -rf dist && tsc6 -p tsconfig.production.json && tsx scripts/fix-esm-extensions.ts && tsx ../../scripts/gates/production-dist.ts --api",
    "typecheck": "tsc6 --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "NODE_OPTIONS=--throw-deprecation vitest run --config vitest.coverage.config.ts --coverage --fileParallelism=false",
    "test:integration": "NODE_OPTIONS=--throw-deprecation vitest run --config vitest.integration.config.ts --reporter=verbose --fileParallelism=false",
    "db:generate": "prisma generate --schema=../../prisma/schema.prisma"
  },
  "dependencies": {
    "@bull-board/api": "^8.3.0",
    "@bull-board/express": "^8.3.0",
    "@customreport/report-persistence": "workspace:*",
    "@customreport/shared": "workspace:*",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/terminus": "^11.1.1",
    "@node-saml/passport-saml": "^5.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-express": "^0.69.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/instrumentation": "^7.10.0",
    "@prometheus-io/client": "0.16.1",
    "@sentry/nestjs": "^10.68.0",
    "@sentry/opentelemetry": "^10.68.0",
    "@trpc/server": "catalog:",
    "bullmq": "^5.81.2",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "luxon": "catalog:",
    "nestjs-cls": "^6.2.1",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "pg": "^8.23.0",
    "playwright": "^1.62.1",
    "rate-limit-redis": "^6.0.0",
    "react": "catalog:",
    "react-email": "^6.9.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "superjson": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@customreport/migrator-runtime": "workspace:*",
    "@nestjs/testing": "^11.2.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "catalog:",
    "@types/nodemailer": "^8.0.1",
    "@types/passport": "^1.0.17",
    "@types/pg": "^8.23.1",
    "@types/react": "catalog:",
    "samlify": "^2.13.1",
    "tsx": "catalog:"
  }
}
