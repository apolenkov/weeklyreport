{
  "name": "@customreport/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "kill-port 3002 || true && node scripts/dev-watch.mjs",
    "build": "tsc -p tsconfig.json && node scripts/fix-esm-extensions.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --exclude '**/*.integration.test.ts' --exclude '**/*.eval.test.ts' --exclude '**/dist/**'",
    "test:integration": "vitest run --config vitest.integration.config.ts --reporter=verbose --fileParallelism=false",
    "db:generate": "prisma generate --schema=../../prisma/schema.prisma",
    "db:bootstrap-ai-provider": "tsx scripts/bootstrap-ai-provider.ts",
    "db:handoff-ai-prompts": "DOTENV_CONFIG_PATH=../../.env node --import @swc-node/register/esm-register scripts/handoff-ai-prompts.ts",
    "postinstall": "prisma generate --schema=../../prisma/schema.prisma"
  },
  "dependencies": {
    "@bull-board/api": "^8.0.1",
    "@bull-board/express": "^8.0.1",
    "@customreport/shared": "workspace:*",
    "@mistralai/mistralai": "^2.5.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/terminus": "^11.1.1",
    "@node-saml/passport-saml": "^5.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.220.0",
    "@opentelemetry/core": "^2.8.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/instrumentation-express": "^0.66.0",
    "@opentelemetry/instrumentation-http": "^0.220.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-logs": "^0.220.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/instrumentation": "^7.8.0",
    "@sentry/nestjs": "^10.59.0",
    "@sentry/opentelemetry": "^10.59.0",
    "@trpc/server": "^11.18.0",
    "bullmq": "^5.79.0",
    "cookie": "^1.1.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "nestjs-cls": "^6.2.1",
    "nodemailer": "^9.0.1",
    "passport": "^0.7.0",
    "playwright": "^1.61.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^5.0.0",
    "react": "^19.2.7",
    "react-email": "^6.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "superjson": "^2.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.41",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.2",
    "@types/nodemailer": "^8.0.1",
    "@types/passport": "^1.0.17",
    "kill-port": "^2.0.1",
    "samlify": "^2.13.1",
    "tsx": "^4.22.4"
  }
}
