{
  "name": "@customreport/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --import @swc-node/register/esm-register --watch src/main.ts",
    "build": "tsc -p tsconfig.json && node scripts/fix-esm-extensions.mjs",
    "lint": "tsc --noEmit -p tsconfig.json && eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --exclude '**/*.integration.test.ts' --exclude '**/*.eval.test.ts' --exclude '**/dist/**'",
    "test:ai-eval": "vitest run --reporter=verbose src/modules/ai/__tests__/golden-set.eval.test.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts --reporter=verbose --fileParallelism=false",
    "db:generate": "prisma generate --schema=../../prisma/schema.prisma",
    "postinstall": "prisma generate --schema=../../prisma/schema.prisma"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@bull-board/api": "^6.21.0",
    "@bull-board/express": "^6.21.0",
    "@customreport/shared": "workspace:*",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.23",
    "@nestjs/core": "^11.1.23",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.23",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/terminus": "^11.1.1",
    "@node-saml/passport-saml": "^5.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/instrumentation-express": "^0.66.0",
    "@opentelemetry/instrumentation-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@prisma/instrumentation": "^7.8.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "@sentry/nestjs": "^10.53.1",
    "@sentry/node": "^10.53.1",
    "@trpc/server": "^11.17.0",
    "bullmq": "^5.77.0",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "nestjs-cls": "^6.2.0",
    "nodemailer": "^8.0.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "playwright": "^1.60.0",
    "prom-client": "^15.1.3",
    "react": "^19.2.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "superjson": "^2.2.6",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.24",
    "@types/cookie": "^1.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.1",
    "@types/nodemailer": "^8.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "samlify": "^2.13.1",
    "tsx": "^4.22.3"
  }
}
