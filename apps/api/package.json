{
  "name": "@customreport/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run src/modules/auth/auth.e2e.spec.ts src/modules/report-sections/report-sections.service.test.ts src/modules/review/review.service.test.ts src/modules/publication/publication.service.test.ts src/modules/pdf-export/pdf-export.service.test.ts src/modules/admin/admin.service.test.ts src/modules/reminders/reminders.service.test.ts src/modules/carry-over/carry-over.service.test.ts src/modules/archive/archive.service.test.ts",
    "test:integration": "vitest run --reporter=verbose --fileParallelism=false src/modules/report-sections/report-sections.integration.test.ts src/modules/review/review.integration.test.ts src/modules/publication/publication.integration.test.ts src/modules/admin/admin.integration.test.ts src/modules/archive/archive.integration.test.ts src/modules/carry-over/carry-over.integration.test.ts src/modules/pdf-export/pdf-export.integration.test.ts src/modules/reminders/reminders.integration.test.ts"
  },
  "dependencies": {
    "@customreport/shared": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.0",
    "@node-saml/passport-saml": "^5.1.0",
    "@trpc/server": "^11.16.0",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1"
  }
}
