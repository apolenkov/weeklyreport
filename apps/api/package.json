{
  "name": "@customreport/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mkdir -p .logs && node --env-file=../../.env --import @swc-node/register/esm-register --watch src/main.ts 2>&1 | tee -a .logs/api.log",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json && eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --exclude '**/*.integration.test.ts' --exclude '**/*.eval.test.ts' --exclude '**/dist/**'",
    "test:ai-eval": "vitest run --reporter=verbose src/modules/ai/__tests__/golden-set.eval.test.ts",
    "test:integration": "vitest run --reporter=verbose --fileParallelism=false src/modules/report-sections/report-sections.integration.test.ts src/modules/review/review.integration.test.ts src/modules/publication/publication.integration.test.ts src/modules/admin/admin.integration.test.ts src/modules/archive/archive.integration.test.ts src/modules/carry-over/carry-over.integration.test.ts src/modules/pdf-export/pdf-export.integration.test.ts src/modules/reminders/reminders.integration.test.ts",
    "db:generate": "prisma generate --schema=../../prisma/schema.prisma",
    "postinstall": "prisma generate --schema=../../prisma/schema.prisma"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@bull-board/api": "^6.21.0",
    "@bull-board/express": "^6.21.0",
    "@customreport/shared": "workspace:*",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/terminus": "^11.1.1",
    "@node-saml/passport-saml": "^5.1.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "@trpc/server": "^11.16.0",
    "bullmq": "^5.73.4",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "nestjs-cls": "^6.2.0",
    "nodemailer": "^8.0.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "playwright": "^1.59.1",
    "prom-client": "^15.1.3",
    "react": "^19.2.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "superjson": "^2.2.6",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.24",
    "@types/cookie": "^0.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "samlify": "^2.12.0",
    "tsx": "^4.21.0"
  }
}
