{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": { "configFile": "vitest.mutation.config.ts" },
  "mutate": ["src/modules/period/domain/period-transition.ts"],
  "inPlace": true,
  "coverageAnalysis": "perTest",
  "concurrency": 1,
  "thresholds": { "high": 90, "low": 80, "break": 70 },
  "reporters": ["clear-text", "json"],
  "jsonReporter": {
    "fileName": "../../ci-reports/stryker-period-transition.json"
  },
  "tempDirName": ".turbo/stryker-tmp",
  "cleanTempDir": true
}
