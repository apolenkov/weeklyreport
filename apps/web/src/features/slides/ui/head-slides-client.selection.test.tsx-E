// @vitest-environment jsdom

import "@testing-library/jest-dom/vitest";

import { QueryClientProvider } from "@tanstack/react-query";
import { act, fireEvent, render, screen } from "@testing-library/react";
import { describe, expect, it } from "vitest";

import { makeQueryClient } from "../../../shared/lib/query/query-client";
import { TRPCProxyContext } from "../../../shared/lib/trpc/trpc-context";
import { createMockTRPC } from "../../../test-utils/mock-trpc";
import { makeWeeklyReportFixture } from "../../../test-utils/report-section-fixtures";
import { HeadSlidesClient } from "./head-slides-client";

const REPORT_ID = "10000000-0000-4000-8000-000000000001";

const SECTIONS = {
  first: { reportSectionId: "section-1", authorName: "Bravo Lead" },
  second: { reportSectionId: "section-2", authorName: "Charlie Lead" },
  third: { reportSectionId: "section-3", authorName: "Delta Lead" },
  earlier: { reportSectionId: "section-0", authorName: "Alpha Lead" },
};

function report(sections: readonly (typeof SECTIONS)[keyof typeof SECTIONS][]) {
  return {
    status: "active" as const,
    ...makeWeeklyReportFixture({
      reportId: REPORT_ID,
      leadSections: [...sections],
    }),
  };
}

function setup(initial: ReturnType<typeof report>) {
  let current = initial;
  const { proxy } = createMockTRPC([
    { path: ["weeklyReport", "get"], queryByInput: () => current },
    {
      path: ["activity", "live"],
      query: () => ({ reportId: REPORT_ID, rows: [] }),
    },
  ]);
  const client = makeQueryClient();
  render(
    <QueryClientProvider client={client}>
      <TRPCProxyContext.Provider value={proxy}>
        <HeadSlidesClient reportId={REPORT_ID} />
      </TRPCProxyContext.Provider>
    </QueryClientProvider>,
  );
  return async (next: ReturnType<typeof report>) => {
    current = next;
    await act(async () => {
      await client.refetchQueries(proxy.weeklyReport.get.pathFilter());
    });
  };
}

function selectedOwner(): string | null {
  const selected = screen
    .getAllByTestId(/head-slide-card-/)
    .find((card) => card.getAttribute("aria-current") === "true");
  return selected?.querySelector("span")?.textContent ?? null;
}

describe("HeadSlidesClient selected slide identity", () => {
  it("keeps the selected slide when a refetch inserts one before it (C5152)", async () => {
    const refetch = setup(
      report([SECTIONS.first, SECTIONS.second, SECTIONS.third]),
    );
    await screen.findByTestId("head-slide-card-2");
    fireEvent.click(screen.getByRole("button", { name: "Next slide" }));
    expect(selectedOwner()).toBe("Charlie Lead");

    await refetch(
      report([
        SECTIONS.earlier,
        SECTIONS.first,
        SECTIONS.second,
        SECTIONS.third,
      ]),
    );

    expect(screen.getAllByTestId(/head-slide-card-/)).toHaveLength(4);
    expect(selectedOwner()).toBe("Charlie Lead");
  });

  it("falls back to the first slide when the selected slide is removed", async () => {
    const refetch = setup(
      report([SECTIONS.first, SECTIONS.second, SECTIONS.third]),
    );
    await screen.findByTestId("head-slide-card-2");
    fireEvent.click(screen.getByRole("button", { name: "Next slide" }));

    await refetch(report([SECTIONS.first, SECTIONS.third]));

    expect(screen.getAllByTestId(/head-slide-card-/)).toHaveLength(2);
    expect(selectedOwner()).toBe("Bravo Lead");
    expect(screen.queryByText("No slides available")).not.toBeInTheDocument();
  });
});
