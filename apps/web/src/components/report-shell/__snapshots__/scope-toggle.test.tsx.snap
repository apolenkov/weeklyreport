exports[`ScopeToggle > active scope button has accent background class; inactive buttons have accent foreground class 1`] = `
<div>
  <div
    aria-label="Slide scope"
    class="inline-flex items-center gap-0.5 rounded-[var(--radius-pill)] border border-[var(--color-border)] bg-[var(--color-surface-empty)] p-0.5 h-[var(--toolbar-control-h)]"
    role="radiogroup"
  >
    <button
      aria-checked="false"
