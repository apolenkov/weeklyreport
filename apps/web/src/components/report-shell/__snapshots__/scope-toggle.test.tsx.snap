exports[`ScopeToggle > active scope button has accent background class; inactive buttons have accent foreground class 1`] = `
<div>
  <div
    aria-label="Slide scope"
    class="inline-flex items-center gap-0.5 rounded-[var(--radius-pill)] border border-[var(--color-border)] bg-[var(--color-surface-empty)] p-0.5"
    role="radiogroup"
  >
    <button
      aria-checked="false"
      class="min-w-[92px] inline-flex min-h-[var(--touch-target-min)] items-center justify-center gap-1 rounded-[var(--radius-pill)] px-3 text-sm font-semibold transition-colors text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)]"
      role="radio"
      type="button"
    >
      Own
    </button>
    <button
      aria-checked="true"
      class="min-w-[92px] inline-flex min-h-[var(--touch-target-min)] items-center justify-center gap-1 rounded-[var(--radius-pill)] px-3 text-sm font-semibold transition-colors bg-[var(--color-foreground)] text-white"
      role="radio"
      type="button"
    >
      Product
    </button>
    <button
      aria-checked="false"
      class="min-w-[92px] inline-flex min-h-[var(--touch-target-min)] items-center justify-center gap-1 rounded-[var(--radius-pill)] px-3 text-sm font-semibold transition-colors text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)]"
      role="radio"
      type="button"
    >
      Leads
    </button>
  </div>
</div>
`;

