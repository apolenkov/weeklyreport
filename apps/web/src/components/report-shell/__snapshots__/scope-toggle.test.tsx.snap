      role="radio"
      type="button"
    >
      Summary
    </button>
    <button
      aria-checked="true"
      class="inline-flex h-full items-center justify-center gap-1 rounded-[var(--radius-pill)] text-xs font-semibold transition-colors min-w-[64px] px-3 bg-[var(--color-toggle-active)] text-white"
      role="radio"
      type="button"
    >
      Product
