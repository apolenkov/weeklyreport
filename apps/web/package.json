{
  "name": "@customreport/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-next.ts dev --webpack --hostname 127.0.0.1",
    "build": "node scripts/run-next.ts build --webpack",
    "doctor": "react-doctor . --no-telemetry --blocking error --no-parallel --max-duration 300",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && tsx ../../scripts/gates/coverage/coverage-evidence.ts coverage/coverage-summary.json web"
  },
  "dependencies": {
    "@customreport/shared": "workspace:*",
    "@customreport/ui": "workspace:*",
    "@sentry/nextjs": "^10.68.0",
    "@tanstack/react-query": "^5.101.4",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "catalog:",
    "@trpc/tanstack-react-query": "^11.18.0",
    "lucide-react": "catalog:",
    "next": "^16.2.12",
    "react": "catalog:",
    "react-dom": "catalog:",
    "recharts": "catalog:",
    "server-only": "^0.0.1",
    "sonner": "catalog:",
    "superjson": "catalog:",
    "web-vitals": "^6.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@customreport/api": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "agentation": "^3.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.23",
    "react-doctor": "catalog:",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.5"
  },
  "browserslist": [
    "chrome >= 117",
    "edge >= 117",
    "firefox >= 119",
    "safari >= 17.4"
  ]
}
