{
  "name": "@customreport/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "lint": "tsc --noEmit -p tsconfig.json && eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:integration": "playwright test --config=playwright.integration.config.ts",
    "test:e2e:integration:ui": "playwright test --config=playwright.integration.config.ts --ui",
    "visual:setup": "bash scripts/visual-setup.sh",
    "visual:test": "playwright test --project=visual",
    "visual:update": "playwright test --project=visual --update-snapshots"
  },
  "dependencies": {
    "@customreport/shared": "workspace:*",
    "@customreport/ui": "workspace:*",
    "@tanstack/react-query": "^5.100.11",
    "@trpc/client": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "@trpc/tanstack-react-query": "^11.17.0",
    "client-only": "^0.0.1",
    "cookie": "^1.0.2",
    "geist": "^1.7.1",
    "lucide-react": "^0.500.0",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "superjson": "^2.2.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@customreport/api": "workspace:*",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/cookie": "^1.0.0",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.2.0",
    "agentation": "^3.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^26.1.0",
    "msw": "^2.14.6",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "vite": ">=7.3.2"
  }
}
