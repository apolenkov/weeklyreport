{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // TODO(noUncheckedIndexedAccess-web): temporary opt-out from the base
    // flag — 231 pre-existing index-access sites need guards; burn down in a
    // dedicated wave, then delete this override.
    "noUncheckedIndexedAccess": false,
    "experimentalDecorators": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "noEmit": true,
    "paths": {
      "@customreport/shared": ["../../packages/shared/src/index.ts"],
      "@customreport/shared/*": ["../../packages/shared/src/*"],
      "@customreport/ui": ["../../packages/ui/src/index.ts"],
      "@customreport/ui/*": ["../../packages/ui/src/*"],
      "@customreport/api/*": ["../../apps/api/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
