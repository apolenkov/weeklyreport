# Local Next.js development configuration.
# Copy this file to apps/web/.env.local after creating the root .env.
# The browser-visible values are intentionally local development settings.
API_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_AUTH_STUB=true
NEXT_PUBLIC_DEV_ROLE_SWITCHER=true
