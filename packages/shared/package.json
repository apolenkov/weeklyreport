{
  "name": "@customreport/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./trpc": "./src/trpc/index.ts"
  },
  "scripts": {
    "build": "rm -rf dist && tsc6 -p tsconfig.production.json && tsx ../../scripts/gates/production-dist.ts --shared",
    "typecheck": "tsc6 --noEmit -p tsconfig.json",
    "test": "vitest run --exclude '**/dist/**'"
  },
  "dependencies": {
    "@trpc/server": "catalog:",
    "luxon": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/luxon": "catalog:",
    "@types/node": "catalog:"
  }
}
