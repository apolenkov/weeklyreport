{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["vitest.base.config.ts", "tsconfig.base.json"],
  "globalEnv": ["PNPM_CONFIG_VERIFY_DEPS_BEFORE_RUN"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "env": [
        "API_URL",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_APP_VERSION",
        "NEXT_PUBLIC_AUTH_STUB",
        "NEXT_PUBLIC_CLIENT_LOG_FORWARDING",
        "NEXT_PUBLIC_DEV_ROLE_SWITCHER",
        "NEXT_PUBLIC_DISABLE_DEVTOOLS",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_WEB_VITALS",
        "NEXT_DIST_DIR"
      ],
      "outputs": [".next/**", "dist/**"]
    },
    "db:generate": {
      "cache": false,
      "outputs": [
        "../../node_modules/.prisma/**",
        "../../node_modules/@prisma/client/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "db:generate"]
    },
    "test": {
      "dependsOn": ["^test", "db:generate"],
      "outputs": ["coverage/**"]
    }
  }
}
