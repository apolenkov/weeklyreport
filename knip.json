{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreBinaries": ["tail"],
  "workspaces": {
    ".": {
      "prisma": {
        "config": []
      },
      "entry": ["eslint-config/*.ts", "prisma/**/*.ts"],
      "project": [
        "eslint-config/**/*.ts",
        "prisma/**/*.{ts,prisma}",
        "scripts/**/*.{ts,mjs}"
      ]
    },
    "apps/api": {
      "entry": ["src/**/*.test.ts", "src/**/*.fixture.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "entry": [
        "src/app/**/{page,layout,template,error,loading,not-found,route}.tsx",
        "src/app/**/{page,layout,template,error,loading,not-found,route}.ts",
        "src/**/*.test.{ts,tsx}",
        "src/test-utils/**"
      ],
      "project": ["src/**/*.{ts,tsx,css}"]
    },
    "packages/shared": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/ui": {
      "entry": [],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
