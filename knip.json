{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": ["apps/web/uat-suite/**"],
  "ignoreBinaries": ["tail", "playwright"],
  "ignoreDependencies": ["@playwright/test", "@axe-core/playwright"],
  "workspaces": {
    ".": {
      "entry": [
        "prisma/*.ts",
        "scripts/*.{ts,mjs}",
        "e2e/playwright.integration.config.ts",
        "e2e/playwright.prodbuild.config.ts",
        "e2e/playwright.csp.config.ts",
        "e2e/sweep/playwright.config.ts",
        "e2e/sweep/render-checklist.ts",
        "e2e/**/*.spec.ts",
        "e2e/integration/global-setup.ts",
        "e2e/integration/global-teardown.ts"
      ],
      "project": [
        "prisma/**/*.ts",
        "scripts/**/*.{ts,mjs}",
        "e2e/**/*.{ts,mjs}"
      ]
    },
    "apps/api": {
      "entry": ["src/**/*.test.ts", "src/**/*.fixture.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["tsx"]
    },
    "apps/web": {
      "entry": [
        "src/app/**/{page,layout,template,error,loading,not-found,route}.tsx",
        "src/app/**/{page,layout,template,error,loading,not-found,route}.ts",
        "src/**/*.test.{ts,tsx}",
        "src/test-utils/**"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@axe-core/playwright", "tailwindcss"]
    },
    "packages/shared": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/ui": {
      "entry": [],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
