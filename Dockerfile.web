# Stage 1: Base with pnpm and turbo
FROM node:26.10.0-alpine@sha256:0b36e8c136b94cd4fcf02188228e76c31ad5872eef3fec8cbd2eee500cfd9e80 AS base
RUN apk add --no-cache libc6-compat
RUN npm install -g pnpm@11.28.3 turbo@2.11.7

# Stage 2: Prune monorepo for web workspace
FROM base AS pruner
WORKDIR /app
COPY . .
RUN turbo prune @customreport/web --docker

# Stage 3: Install build dependencies (devDeps stay in this stage only)
FROM base AS installer
WORKDIR /app
# Docker build steps have no TTY. Keep pnpm deterministic after the pruned
# manifests are overlaid with the full source tree instead of letting it ask
# whether an existing modules directory may be refreshed.
ENV CI=true
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=pruner /app/out/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=pruner /app/out/json/ .
COPY prisma ./prisma
# The web typechecks against the API router source, so its dependency closure
# is build-time-required even though the browser bundle never executes the API.
# Keep the pruned workspace root installed as well: TypeScript and Prisma are
# root build tools used by transitive workspace build/db:generate tasks.
RUN --mount=type=cache,id=customreport-pnpm-store-v11,target=/pnpm/store,sharing=locked \
    pnpm install --frozen-lockfile --store-dir=/pnpm/store --network-concurrency=4
COPY --from=pruner /app/out/full/ .
COPY tsconfig.base.json ./tsconfig.base.json
# The web tsconfig now typechecks its own config files, so vitest.config.ts
# resolves this root base config during the Next build.
COPY vitest.base.config.ts ./vitest.base.config.ts

# Stage 4: Build for production
FROM installer AS builder
# The inherited frozen install is authoritative. pnpm 11 otherwise lets the
# workspace scripts spawned by Turbo reconcile dependencies after source copy.
ENV PNPM_CONFIG_VERIFY_DEPS_BEFORE_RUN=false
# API_URL is the server-side origin (internal service network). It is the only API
# origin; a production-labelled build that omits it must fail loud instead of
# baking a fallback origin into the bundle.
ARG API_URL
ARG NEXT_PUBLIC_APP_VERSION
ARG NEXT_PUBLIC_CLIENT_LOG_FORWARDING
ARG NEXT_PUBLIC_WEB_VITALS
ARG NEXT_PUBLIC_PRODUCT_FEEDBACK_ENABLED
ARG NEXT_PUBLIC_PRODUCT_FEEDBACK_INBOX_ROLES
RUN test -n "$API_URL" \
  || { echo "API_URL build arg is required" >&2; exit 1; }; \
  test -n "$NEXT_PUBLIC_APP_VERSION" \
  || { echo "NEXT_PUBLIC_APP_VERSION build arg is required" >&2; exit 1; }; \
  test -n "$NEXT_PUBLIC_CLIENT_LOG_FORWARDING" \
  || { echo "NEXT_PUBLIC_CLIENT_LOG_FORWARDING build arg is required" >&2; exit 1; }; \
  test -n "$NEXT_PUBLIC_WEB_VITALS" \
  || { echo "NEXT_PUBLIC_WEB_VITALS build arg is required" >&2; exit 1; }; \
  test -n "$NEXT_PUBLIC_PRODUCT_FEEDBACK_ENABLED" \
  || { echo "NEXT_PUBLIC_PRODUCT_FEEDBACK_ENABLED build arg is required" >&2; exit 1; }; \
  test -n "$NEXT_PUBLIC_PRODUCT_FEEDBACK_INBOX_ROLES" \
  || { echo "NEXT_PUBLIC_PRODUCT_FEEDBACK_INBOX_ROLES build arg is required" >&2; exit 1; }
# Dev-auth flags default OFF so an un-argumented build (a direct `docker build`,
# or a CI job that omits --build-arg) never inlines the auth stub
# or dev role switcher into a production-labeled bundle. The CI image build
# passes explicit disabled values at the builder boundary.
ARG NEXT_PUBLIC_AUTH_STUB=false
ARG NEXT_PUBLIC_DEV_ROLE_SWITCHER=false
ARG NEXT_PUBLIC_SENTRY_DSN=
ENV API_URL=${API_URL}
ENV NEXT_PUBLIC_AUTH_STUB=${NEXT_PUBLIC_AUTH_STUB}
ENV NEXT_PUBLIC_DEV_ROLE_SWITCHER=${NEXT_PUBLIC_DEV_ROLE_SWITCHER}
ENV NEXT_PUBLIC_CLIENT_LOG_FORWARDING=${NEXT_PUBLIC_CLIENT_LOG_FORWARDING}
ENV NEXT_PUBLIC_WEB_VITALS=${NEXT_PUBLIC_WEB_VITALS}
ENV NEXT_PUBLIC_PRODUCT_FEEDBACK_ENABLED=${NEXT_PUBLIC_PRODUCT_FEEDBACK_ENABLED}
ENV NEXT_PUBLIC_PRODUCT_FEEDBACK_INBOX_ROLES=${NEXT_PUBLIC_PRODUCT_FEEDBACK_INBOX_ROLES}
ENV NEXT_PUBLIC_SENTRY_DSN=${NEXT_PUBLIC_SENTRY_DSN}
ENV NEXT_PUBLIC_APP_VERSION=${NEXT_PUBLIC_APP_VERSION}
ENV NEXT_TELEMETRY_DISABLED=1
COPY scripts/gates/production-dist.ts ./scripts/gates/production-dist.ts
COPY scripts/gates/production-dist-policy.ts ./scripts/gates/production-dist-policy.ts
RUN ./node_modules/.bin/turbo build --filter=@customreport/web

# Stage 5: Production runner with Next.js standalone
FROM node:26.10.0-alpine@sha256:0b36e8c136b94cd4fcf02188228e76c31ad5872eef3fec8cbd2eee500cfd9e80 AS runner
RUN apk add --no-cache libc6-compat
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs
WORKDIR /app
COPY --from=builder --chown=nextjs:nextjs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nextjs /app/apps/web/.next/static ./apps/web/.next/static
ARG NEXT_PUBLIC_APP_VERSION
LABEL org.opencontainers.image.revision=${NEXT_PUBLIC_APP_VERSION}
USER nextjs
ENV NODE_ENV=production
ENV HOSTNAME="0.0.0.0"
ENV NEXT_TELEMETRY_DISABLED=1
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/ || exit 1
CMD ["node", "apps/web/server.js"]
