# Stage 1: Base with pnpm and turbo
FROM node:26-alpine@sha256:e88a35be04478413b7c71c455cd9865de9b9360e1f43456be5951032d7ac1a66 AS base
RUN apk add --no-cache libc6-compat
RUN npm install -g pnpm@11.17.0 turbo@2.10.6

# Stage 2: Prune monorepo for web workspace
FROM base AS pruner
WORKDIR /app
COPY . .
RUN turbo prune @customreport/web --docker

# Stage 3: Install deps (devDeps intact — used for dev hot-reload)
FROM base AS installer
WORKDIR /app
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=pruner /app/out/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=pruner /app/out/json/ .
COPY prisma ./prisma
RUN pnpm install --frozen-lockfile
COPY --from=pruner /app/out/full/ .
COPY tsconfig.base.json ./tsconfig.base.json

# Stage 4: Build for production
FROM installer AS builder
# API_URL is the server-side origin (compose network); NEXT_PUBLIC_API_URL is
# inlined into the client bundle at build. Both are REQUIRED build args — a
# production-labelled build that omits them must fail loud instead of baking a
# localhost/internal fallback origin into the bundle.
ARG API_URL
ARG NEXT_PUBLIC_API_URL
RUN test -n "$API_URL" || (echo "API_URL build arg is required" && exit 1) \
  && test -n "$NEXT_PUBLIC_API_URL" \
  || (echo "NEXT_PUBLIC_API_URL build arg is required" && exit 1)
# Dev-auth flags default OFF so an un-argumented build (a direct `docker build`,
# a CI job, or a compose file that omits build.args) never inlines the auth stub
# or dev role switcher into a production-labeled bundle. Dev opts back in via
# explicit build.args in docker-compose.yml.
ARG NEXT_PUBLIC_AUTH_STUB=false
ARG NEXT_PUBLIC_DEV_ROLE_SWITCHER=false
ENV API_URL=${API_URL}
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_AUTH_STUB=${NEXT_PUBLIC_AUTH_STUB}
ENV NEXT_PUBLIC_DEV_ROLE_SWITCHER=${NEXT_PUBLIC_DEV_ROLE_SWITCHER}
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm turbo build --filter=@customreport/web

# Stage 5: Production runner with Next.js standalone
FROM node:26-alpine@sha256:e88a35be04478413b7c71c455cd9865de9b9360e1f43456be5951032d7ac1a66 AS runner
RUN apk add --no-cache libc6-compat
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs
WORKDIR /app
COPY --from=builder --chown=nextjs:nextjs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nextjs /app/apps/web/.next/static ./apps/web/.next/static
USER nextjs
ENV NODE_ENV=production
ENV HOSTNAME="0.0.0.0"
ENV NEXT_TELEMETRY_DISABLED=1
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
  CMD wget -qO- http://localhost:3000/ || exit 1
CMD ["node", "apps/web/server.js"]
